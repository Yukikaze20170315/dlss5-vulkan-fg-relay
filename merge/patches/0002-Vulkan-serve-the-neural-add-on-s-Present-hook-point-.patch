diff --git a/src/fg-composite-shader.h b/src/fg-composite-shader.h
new file mode 100644
index 0000000..4aa4d5b
--- /dev/null
+++ b/src/fg-composite-shader.h
@@ -0,0 +1,24 @@
+#pragma once
+
+// UI-preserving recomposition of a neural-rendered HUD-less frame.
+//   t0 = original HUD-less, t1 = NR(HUD-less), u0 = backbuffer in / composite out.
+// The NR delta is applied fully where the UI did not touch the pixel and fades
+// out with the UI's contribution, so translucent panels keep a soft, continuous
+// scene under them instead of an un-enhanced cut-out; opaque UI stays untouched.
+static const char kFgCompositeShader[] =
+    "Texture2D<float4>   hudless : register(t0);\n"
+    "Texture2D<float4>   nr      : register(t1);\n"
+    "RWTexture2D<float4> back    : register(u0);\n"
+    "static const float kUiFade = 0.25;\n"
+    "[numthreads(8,8,1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint w, h; back.GetDimensions(w, h);\n"
+    "    if (id.x >= w || id.y >= h) return;\n"
+    "    float4 b = back[id.xy];\n"
+    "    float3 s = hudless[id.xy].rgb;\n"
+    "    float3 d = abs(b.rgb - s);\n"
+    "    float ui = max(d.r, max(d.g, d.b));\n"
+    "    float weight = saturate(1.0 - ui / kUiFade);\n"
+    "    back[id.xy] = float4(saturate(b.rgb + (nr[id.xy].rgb - s) * weight), b.a);\n"
+    "}\n";
diff --git a/src/fg-input.inc b/src/fg-input.inc
new file mode 100644
index 0000000..b4ff50e
--- /dev/null
+++ b/src/fg-input.inc
@@ -0,0 +1,487 @@
+// Native frame-generation input feed for Vulkan: the real, fully composited frame
+// that DLSS-G interpolates from is neural-rendered once per real frame, before the
+// FG evaluate is forwarded. FG then interpolates from processed frames, so the
+// presented multiplier is preserved. Generic still runs through the identity SR
+// carrier on the private D3D12 session; nothing here reads Generic's layout.
+#include "fg-composite-shader.h"
+
+static NVSDK_NGX_Handle *g_fg_handles[8];
+static LONG g_fg_handle_count;
+
+static void FgInputNoteCreated(int feature_id, NVSDK_NGX_Result r, NVSDK_NGX_Handle **out)
+{
+    if (r != NGX_SUCCESS || out == nullptr || *out == nullptr) return;
+    for (LONG i = 0; i < g_fg_handle_count; ++i)
+        if (g_fg_handles[i] == *out) { g_fg_handles[i] = g_fg_handles[--g_fg_handle_count]; break; }
+    if (feature_id == 11 && g_fg_handle_count < static_cast<LONG>(_countof(g_fg_handles)))
+        g_fg_handles[g_fg_handle_count++] = *out;
+}
+
+static bool FgInputIsFgHandle(const NVSDK_NGX_Handle *handle)
+{
+    for (LONG i = 0; i < g_fg_handle_count; ++i)
+        if (g_fg_handles[i] == handle) return true;
+    return false;
+}
+
+struct FgComposite {
+    ID3D12RootSignature *rs;
+    ID3D12PipelineState *pso;
+    ID3D12DescriptorHeap *heap;
+    ID3D12CommandAllocator *alloc;
+    ID3D12GraphicsCommandList *list;
+    ID3D12Fence *fence;
+    HANDLE ev;
+    UINT64 fv;
+    ID3D12Resource *hudless, *nr, *back;
+};
+static FgComposite g_fg_composite;
+
+struct FgInputState {
+    bool refused, armed, worker_ok, want_release;
+    uint32_t vk_fmt;
+    UINT w, h;
+    VkmRes hudless, back;
+    unsigned frames, writes, skipped_nr;
+    unsigned long long token;
+};
+static FgInputState g_fg_input;
+
+static bool FgCompositeWait(DWORD ms)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.fence == nullptr) return true;
+    const UINT64 done = c.fence->GetCompletedValue();
+    if (done == UINT64_MAX) return false;
+    if (done >= c.fv) return true;
+    if (FAILED(c.fence->SetEventOnCompletion(c.fv, c.ev))) return false;
+    if (WaitForSingleObject(c.ev, ms) != WAIT_OBJECT_0) return false;
+    const UINT64 after = c.fence->GetCompletedValue();
+    return after != UINT64_MAX && after >= c.fv;
+}
+
+static bool FgCompositeMake(ID3D12Device *dev, ID3D12Resource *hudless, ID3D12Resource *nr,
+                            ID3D12Resource *back)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.pso == nullptr) {
+        PFN_D3DCompile_ compile = LoadSystemD3DCompiler();
+        if (compile == nullptr) { Log("[fg-input] d3dcompiler_47.dll unavailable for the composite pass"); return false; }
+        ID3DBlob *code = nullptr, *err = nullptr;
+        HRESULT hr = compile(kFgCompositeShader, sizeof(kFgCompositeShader) - 1, "fgc", nullptr, nullptr,
+                             "main", "cs_5_0", 0, 0, &code, &err);
+        if (FAILED(hr) || code == nullptr) {
+            Log("[fg-input] composite shader failed to compile: %s",
+                err != nullptr ? static_cast<const char *>(err->GetBufferPointer()) : "");
+            if (err != nullptr) err->Release();
+            return false;
+        }
+        if (err != nullptr) err->Release();
+        D3D12_DESCRIPTOR_RANGE ranges[2] = {};
+        ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        ranges[0].NumDescriptors = 2;
+        ranges[0].OffsetInDescriptorsFromTableStart = 0;
+        ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+        ranges[1].NumDescriptors = 1;
+        ranges[1].OffsetInDescriptorsFromTableStart = 2;
+        D3D12_ROOT_PARAMETER param = {};
+        param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        param.DescriptorTable.NumDescriptorRanges = 2;
+        param.DescriptorTable.pDescriptorRanges = ranges;
+        param.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        D3D12_ROOT_SIGNATURE_DESC rsd = {};
+        rsd.NumParameters = 1;
+        rsd.pParameters = &param;
+        HMODULE d3d12 = GetModuleHandleW(L"d3d12.dll");
+        auto serialize = d3d12 != nullptr
+            ? reinterpret_cast<PFN_D3D12_SERIALIZE_ROOT_SIGNATURE>(GetProcAddress(d3d12, "D3D12SerializeRootSignature")) : nullptr;
+        ID3DBlob *rsblob = nullptr, *rserr = nullptr;
+        hr = serialize != nullptr ? serialize(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &rsblob, &rserr) : E_FAIL;
+        if (FAILED(hr) || rsblob == nullptr) {
+            Log("[fg-input] composite root signature would not serialize 0x%08X", hr);
+            if (rserr != nullptr) rserr->Release();
+            code->Release();
+            return false;
+        }
+        if (rserr != nullptr) rserr->Release();
+        hr = dev->CreateRootSignature(0, rsblob->GetBufferPointer(), rsblob->GetBufferSize(),
+                                      __uuidof(ID3D12RootSignature), reinterpret_cast<void **>(&c.rs));
+        rsblob->Release();
+        if (FAILED(hr)) { code->Release(); Log("[fg-input] composite root signature failed 0x%08X", hr); return false; }
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {};
+        pd.pRootSignature = c.rs;
+        pd.CS.pShaderBytecode = code->GetBufferPointer();
+        pd.CS.BytecodeLength = code->GetBufferSize();
+        hr = dev->CreateComputePipelineState(&pd, __uuidof(ID3D12PipelineState), reinterpret_cast<void **>(&c.pso));
+        code->Release();
+        if (FAILED(hr)) { Log("[fg-input] composite pipeline failed 0x%08X", hr); return false; }
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = 3;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(dev->CreateDescriptorHeap(&hd, __uuidof(ID3D12DescriptorHeap), reinterpret_cast<void **>(&c.heap))) ||
+            FAILED(dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, __uuidof(ID3D12CommandAllocator), reinterpret_cast<void **>(&c.alloc))) ||
+            FAILED(dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, c.alloc, nullptr, __uuidof(ID3D12GraphicsCommandList), reinterpret_cast<void **>(&c.list))) ||
+            FAILED(dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), reinterpret_cast<void **>(&c.fence)))) {
+            Log("[fg-input] composite heap/list/fence creation failed");
+            return false;
+        }
+        c.list->Close();
+        c.ev = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (c.ev == nullptr) return false;
+    }
+    if (!FgCompositeWait(4000)) return false;
+    c.hudless = hudless; c.nr = nr; c.back = back;
+    const UINT inc = dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu = c.heap->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd = {};
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sd.Texture2D.MipLevels = 1;
+    sd.Format = hudless->GetDesc().Format;
+    dev->CreateShaderResourceView(hudless, &sd, cpu);
+    cpu.ptr += inc;
+    sd.Format = nr->GetDesc().Format;
+    dev->CreateShaderResourceView(nr, &sd, cpu);
+    cpu.ptr += inc;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {};
+    ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    ud.Format = back->GetDesc().Format;
+    dev->CreateUnorderedAccessView(back, nullptr, &ud, cpu);
+    return true;
+}
+
+// Runs on the private queue after the NR submission; the caller fences on it.
+static bool FgCompositeRun(ID3D12CommandQueue *queue, DWORD wait_ms)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.pso == nullptr || c.back == nullptr) return false;
+    if (!FgCompositeWait(wait_ms)) return false;
+    if (FAILED(c.alloc->Reset()) || FAILED(c.list->Reset(c.alloc, nullptr))) return false;
+    Barrier(c.list, c.hudless, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(c.list, c.nr, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(c.list, c.back, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    ID3D12DescriptorHeap *heaps[] = { c.heap };
+    c.list->SetDescriptorHeaps(1, heaps);
+    c.list->SetComputeRootSignature(c.rs);
+    c.list->SetPipelineState(c.pso);
+    c.list->SetComputeRootDescriptorTable(0, c.heap->GetGPUDescriptorHandleForHeapStart());
+    const D3D12_RESOURCE_DESC bd = c.back->GetDesc();
+    c.list->Dispatch((static_cast<UINT>(bd.Width) + 7) / 8, (bd.Height + 7) / 8, 1);
+    Barrier(c.list, c.back, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(c.list, c.nr, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(c.list, c.hudless, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    if (FAILED(c.list->Close())) return false;
+    ID3D12CommandList *lists[] = { c.list };
+    queue->ExecuteCommandLists(1, lists);
+    if (FAILED(queue->Signal(c.fence, ++c.fv))) return false;
+    return FgCompositeWait(wait_ms);
+}
+
+// Identity on the private side so an unconditional Vulkan copy back is harmless.
+static bool FgIdentityCopy(DWORD wait_ms)
+{
+    if (!Synth12Begin(wait_ms)) return false;
+    Barrier(g_s12.list, g_s12.tex[SLOT_COLOR], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Barrier(g_s12.list, g_s12.tex[SLOT_OUTPUT], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
+    g_s12.list->CopyResource(g_s12.tex[SLOT_OUTPUT], g_s12.tex[SLOT_COLOR]);
+    Barrier(g_s12.list, g_s12.tex[SLOT_COLOR], D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(g_s12.list, g_s12.tex[SLOT_OUTPUT], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COMMON);
+    return Synth12WaitFence(Synth12End(), wait_ms);
+}
+
+// Worker-thread half of one FG-input frame. The game's queue is parked while this
+// runs, so every wait is bounded by the mirror's evaluate budget.
+static bool FgInputWorker()
+{
+    bool ok = false, nr_absent = false;
+    unsigned nr_entries = 0, sr_entries = 0, sr_copies = 0;
+    if (g_present_adapter.run_nr) {
+        g_present_nr_entries = g_present_sr_entries = g_present_sr_copies = 0;
+        g_present_nr_scope = true;
+        if (g_ngx_cs_ready) EnterCriticalSection(&g_ngx_cs);
+        ok = Synth12EvaluateShared(&g_vkm.sp, kVkmEvaluateMs);
+        if (g_ngx_cs_ready) LeaveCriticalSection(&g_ngx_cs);
+        g_present_nr_scope = false;
+        nr_entries = g_present_nr_entries; sr_entries = g_present_sr_entries; sr_copies = g_present_sr_copies;
+        if (ok && (sr_entries != 1 || sr_copies != 1)) {
+            Log("[fg-input] carrier contract mismatch: sr_entries=%u sr_copies=%u; frame not written.", sr_entries, sr_copies);
+            ok = false;
+        }
+        // Generic switched off or warming up: the carrier round-trip is the game's own
+        // image, so the recorded copy back is harmless and this is not a failure.
+        if (ok && nr_entries == 0) { nr_absent = true; ++g_fg_input.skipped_nr; }
+        if (ok && !nr_absent) ok = FgCompositeRun(g_s12.queue, kVkmEvaluateMs);
+    } else {
+        ok = PresentAdapterCopy12();
+    }
+    ok = ok && g_s12.dev->GetDeviceRemovedReason() == S_OK;
+    if (!ok) {
+        // Keep the carriers equal to their inputs so the recorded copy back is a no-op.
+        FgIdentityCopy(kVkmEvaluateMs);
+    }
+    g_fg_input.worker_ok = ok;
+    ++g_fg_input.frames;
+    if (ok && !nr_absent) ++g_fg_input.writes;
+    const unsigned cadence = g_present_adapter.continuous ? 1800u : 120u;
+    if (g_fg_input.frames <= 3 || g_fg_input.frames % cadence == 0 || !ok || g_present_adapter.remaining == 0)
+        Log("[fg-input] frame=%u %ux%u vkfmt=%u mode=%s nr_entries=%u sr_entries=%u sr_copies=%u ok=%d token=%llu.",
+            g_fg_input.frames, g_fg_input.w, g_fg_input.h, g_fg_input.vk_fmt,
+            g_present_adapter.run_nr ? "NR" : g_present_adapter.colour_roundtrip ? "carrier" : "copy",
+            nr_entries, sr_entries, sr_copies, ok ? 1 : 0, g_present_adapter.token);
+    if (g_present_adapter.remaining == 0)
+        Log("[fg-input] request complete: frames=%u writes=%u no_nr=%u. token=%llu",
+            g_fg_input.frames, g_fg_input.writes, g_fg_input.skipped_nr, g_present_adapter.token);
+    return ok;
+}
+
+static void FgInputRefuse(const char *why)
+{
+    if (g_fg_input.refused) return;
+    g_fg_input.refused = true;
+    g_present_adapter.remaining = 0;
+    Log("[fg-input] refused: %s. Frame generation continues on the game's own frames.", why);
+}
+
+static bool FgInputReadU(const NVSDK_NGX_Parameter *p, const char *key, unsigned *out)
+{
+    unsigned u = 0; int i = 0;
+    if (p->Get(key, &u) == NGX_SUCCESS) { *out = u; return true; }
+    if (p->Get(key, &i) == NGX_SUCCESS) { *out = static_cast<unsigned>(i); return true; }
+    return false;
+}
+
+// Render-thread only (inside the game's SR evaluate, where the mirror already waits
+// the device idle for its own rebuilds). Hands the private session back so the
+// other path can build. Returns false and keeps everything when completion is unproven.
+static bool FgInputRelease()
+{
+    if (g_vkm.idle != nullptr && WaitForSingleObject(g_vkm.idle, kVkmIdleMs) != WAIT_OBJECT_0) return false;
+    if (!FgCompositeWait(4000)) return false;
+    if (!Synth12Drain(4000)) return false;
+    if (g_svk.dev != nullptr && g_svk.DeviceWaitIdle != nullptr && g_svk.DeviceWaitIdle(g_svk.dev) != 0) return false;
+    SynthVkReleaseImages();
+    if (!Synth12ReleaseTextures()) return false;
+    g_fg_composite.hudless = g_fg_composite.nr = g_fg_composite.back = nullptr;
+    g_fg_input.vk_fmt = 0;
+    g_fg_input.want_release = false;
+    g_s12.w = 0;
+    g_s12.need_reset = true;
+    InterlockedExchange(&g_adapter_owner, OWNER_NONE);
+    Log("[fg-input] released the private session; the native mirror may take it.");
+    return true;
+}
+
+// Render-thread only: the mirror's session is torn down so the FG-input feed can build.
+static bool MirrorReleaseForFgInput()
+{
+    if (g_vkm.idle != nullptr && WaitForSingleObject(g_vkm.idle, kVkmIdleMs) != WAIT_OBJECT_0) return false;
+    if (!SynthVkDrainWorker()) return false;
+    if (!Synth12Drain(4000)) return false;
+    if (g_svk.dev != nullptr && g_svk.DeviceWaitIdle != nullptr && g_svk.DeviceWaitIdle(g_svk.dev) != 0) return false;
+    SynthVkReleaseImages();
+    SynthOfaVkRebuild();
+    SynthDepthCsRelease();
+    if (!Synth12ReleaseTextures()) return false;
+    g_s12.w = 0;
+    g_s12.need_reset = true;
+    InterlockedExchange(&g_adapter_owner, OWNER_NONE);
+    Log("[fg-input] the native mirror released the private session; Present is served at the frame-generation input.");
+    return true;
+}
+
+// Render-thread half: records copies of the FG inputs into the FG evaluate's own
+// command buffer, parks it, and records the copy back before the evaluate is
+// forwarded -- so FG and the real-frame present both see the processed image.
+static void FgInputFrame(void *cmd_raw, const NVSDK_NGX_Parameter *p)
+{
+    if (g_fg_input.refused || g_vkm.stopping || g_cfg.stage < 2) return;
+    if (!FgInputActive()) return;
+    if (InterlockedCompareExchange(&g_adapter_owner, 0, 0) == OWNER_MIRROR) return;
+    PresentAdapterRequest();
+    if (g_present_adapter.remaining == 0 && (PresentAdapterAutoRun() || PresentAdapterFollow()) &&
+        g_present_adapter.request_seen && !g_present_adapter.refused && !g_present_adapter.stopped) {
+        if (!PresentAdapterConsumer()) { g_present_adapter.refused = true; return; }
+        g_present_adapter.remaining = UINT_MAX;
+        g_present_adapter.continuous = true;
+        g_present_adapter.run_nr = true;
+        g_present_adapter.colour_roundtrip = false;
+        g_present_adapter.deadline = ULLONG_MAX;
+        g_present_adapter.token = 1;
+        g_s12.need_reset = true;
+        Log("[fg-input] AutoRun: continuous NR at the frame-generation input; a request with frames=0 stops it.");
+    }
+    if (g_present_adapter.remaining == 0 || g_present_adapter.refused) return;
+    if (GetTickCount64() >= g_present_adapter.deadline) {
+        Log("[fg-input] request complete: frames=%u writes=%u no_nr=%u (deadline). token=%llu",
+            g_fg_input.frames, g_fg_input.writes, g_fg_input.skipped_nr, g_present_adapter.token);
+        g_present_adapter.remaining = 0; return;
+    }
+    if (g_present_adapter.token != g_fg_input.token) {
+        g_fg_input.token = g_present_adapter.token;
+        g_fg_input.frames = g_fg_input.writes = g_fg_input.skipped_nr = 0;
+    }
+    unsigned index = 0;
+    const bool indexed = FgInputReadU(p, "DLSSG.MultiFrameIndex", &index);
+    if (indexed && index != 1) return;
+    if (!indexed) {
+        // Without an index, the real-output slot marks the first evaluate of a group.
+        const char *why_real = nullptr;
+        VkmRes real = {};
+        if (!VkmGetRes(p, "DLSSG.OutputReal", &real, &why_real)) return;
+    }
+    if (!PresentAdapterConfiguration()) { g_present_adapter.remaining = 0; g_present_adapter.refused = true; return; }
+    if (g_cfg.mode != 2) { FgInputRefuse("the experiment requires Bridge mode=2"); return; }
+    if (g_vkm_rt == nullptr) return;
+    reshade::api::device *rdev = g_vkm_rt->get_device();
+    if (rdev == nullptr || rdev->get_api() != reshade::api::device_api::vulkan) return;
+    if (!Synth12Open(g_vkm_rt) || !SynthVkOpen(g_vkm_rt)) { FgInputRefuse("private session unavailable"); return; }
+
+    const char *why = nullptr;
+    VkmRes hud = {}, back = {};
+    if (!VkmGetRes(p, "DLSSG.HUDLess", &hud, &why)) { FgInputRefuse("no HUD-less input; this feed requires the game's HUD-less image"); return; }
+    if (!VkmGetRes(p, "DLSSG.Backbuffer", &back, &why)) { FgInputRefuse("no backbuffer input"); return; }
+    if (hud.w != back.w || hud.h != back.h || hud.fmt != back.fmt || hud.w == 0 || hud.h == 0) {
+        FgInputRefuse("HUD-less and backbuffer differ in size or format"); return;
+    }
+    unsigned sub_w = 0, sub_h = 0, sub_x = 0, sub_y = 0;
+    FgInputReadU(p, "DLSSG.BackbufferSubrectWidth", &sub_w);
+    FgInputReadU(p, "DLSSG.BackbufferSubrectHeight", &sub_h);
+    FgInputReadU(p, "DLSSG.BackbufferSubrectBaseX", &sub_x);
+    FgInputReadU(p, "DLSSG.BackbufferSubrectBaseY", &sub_y);
+    if (sub_x != 0 || sub_y != 0 || (sub_w != 0 && sub_w != back.w) || (sub_h != 0 && sub_h != back.h)) {
+        FgInputRefuse("backbuffer subrect is not the whole image"); return;
+    }
+    const DXGI_FORMAT fmt = MapVkColor(back.fmt);
+    if (fmt != DXGI_FORMAT_R8G8B8A8_UNORM && fmt != DXGI_FORMAT_B8G8R8A8_UNORM) {
+        FgInputRefuse("only UNORM8 sRGB-encoded FG inputs are handled by this build"); return;
+    }
+    // The game's own guides at output resolution, as handed to frame generation.
+    static const uint32_t kVkFmtR16G16Sfloat = 83;
+    VkmRes mv = {}, depth = {};
+    const bool have_mv = VkmGetRes(p, "DLSSG.MVecs", &mv, &why) && mv.fmt == kVkFmtR16G16Sfloat &&
+                         mv.w == back.w && mv.h == back.h;
+    const bool have_depth = VkmGetRes(p, "DLSSG.Depth", &depth, &why) && depth.fmt == kVkFmtR32Sfloat &&
+                            depth.w == back.w && depth.h == back.h;
+    float mv_scale_x = 1.0f, mv_scale_y = 1.0f;
+    unsigned depth_inverted = 0;
+    if (have_mv) {
+        p->Get("DLSSG.MvecScaleX", &mv_scale_x);
+        p->Get("DLSSG.MvecScaleY", &mv_scale_y);
+    }
+    FgInputReadU(p, "DLSSG.DepthInverted", &depth_inverted);
+    if (!VkmEnsureEvents()) return;
+    if (g_vkm.idle != nullptr && WaitForSingleObject(g_vkm.idle, kVkmIdleMs) != WAIT_OBJECT_0) {
+        FgInputRefuse("the previous frame's park had not cleared"); return;
+    }
+    if (g_vkm.refused) return;
+
+    SynthBuild(&g_vkm.sp, back.w, back.h, fmt, reshade::api::resource{0}, reshade::api::resource{0},
+               reshade::api::resource{0}, 0, -1);
+    g_vkm.sp.Set("DLSS.Feature.Create.Flags", depth_inverted != 0 ? 0x08u : 0u);
+    if (have_mv) {
+        g_vkm.sp.Set("MV.Scale.X", mv_scale_x);
+        g_vkm.sp.Set("MV.Scale.Y", mv_scale_y);
+    }
+    const bool rebuild = g_s12.feature == nullptr || g_s12.w != back.w || g_s12.h != back.h ||
+                         g_s12.fmt != fmt || !g_s12.out_b || g_fg_input.vk_fmt != back.fmt;
+    if (rebuild) {
+        // The FG evaluate runs on Streamline's present thread while the render thread
+        // keeps submitting; a device-wide wait here deadlocks (measured2026-09-28). Only
+        // a first build, with nothing imported yet, is safe; a later shape change refuses.
+        if (g_s12.feature != nullptr || g_svk.img[SLOT_COLOR] != 0 || g_svk.img[kOutB] != 0) {
+            if (PresentAdapterFollow()) { g_fg_input.want_release = true; return; }
+            FgInputRefuse("the frame-generation input changed shape; rebuilding here would need a device-wide wait on the present thread");
+            return;
+        }
+        Log("[fg-input] building the private feature and its Vulkan import for %ux%u %s", back.w, back.h, FormatName(fmt));
+        // The synthetic source label selects the colour-conversion pass in Synth12Build.
+        InterlockedExchange(&g_source, SRC_SYNTH);
+        if (!Synth12Build(&g_vkm.sp, back.w, back.h, back.w, back.h, fmt, false, 0, 0, true,
+                          DXGI_FORMAT_R32_FLOAT, DXGI_FORMAT_UNKNOWN, true) || !g_s12.out_b) {
+            Synth12NoteBuildFailure(false);
+            FgInputRefuse("the private D3D12 feature or its second carrier could not be built"); return;
+        }
+        if (!SynthVkImport()) { SynthVkReleaseImages(); g_svk.ready = false; FgInputRefuse("import into the game's VkDevice failed"); return; }
+        if (!PresentAdapterCarrier()) { FgInputRefuse("private SR carrier hook unavailable"); return; }
+        PresentAdapterWitness();
+        if (!FgCompositeMake(g_s12.dev, g_s12.tex[SLOT_COLOR], g_s12.tex[SLOT_OUTPUT], g_s12.tex[kOutB])) {
+            FgInputRefuse("composite pass unavailable"); return;
+        }
+        g_fg_input.vk_fmt = back.fmt; g_fg_input.w = back.w; g_fg_input.h = back.h;
+        g_s12.need_reset = true;
+        InterlockedExchange(&g_adapter_owner, OWNER_FG);
+        Log("[fg-input] ready: HUD-less -> linear sRGB carrier -> Generic NR -> UI-preserving composite; FG interpolates processed frames. guides: mv=%s (scale %.3f,%.3f) depth=%s inverted=%u",
+            have_mv ? "game" : "zero", mv_scale_x, mv_scale_y, have_depth ? "game" : "zero", depth_inverted);
+    }
+
+    SVkCommandBuffer cb = reinterpret_cast<SVkCommandBuffer>(cmd_raw);
+    const LONG drain = InterlockedCompareExchange(&g_vkm.drain, 0, 0);
+    if (drain != 0) {
+        if (g_svk.EvStatus(g_svk.dev, g_vkm.ev_in[drain - 1]) != kSVkEventSet) return;
+        InterlockedExchange(&g_vkm.drain, 0);
+        return;
+    }
+    const int pair = g_vkm.next;
+    g_vkm.next ^= 1;
+    g_svk.EvReset(g_svk.dev, g_vkm.ev_in[pair]);
+    g_svk.EvReset(g_svk.dev, g_vkm.ev_out[pair]);
+    ResetEvent(g_vkm.idle);
+
+    const uint32_t first = g_svk.laid_out ? kSVkLayoutGeneral : kSVkLayoutUndefined;
+    SynthVkBarrier(cb, hud.image, kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+    SynthVkBarrier(cb, back.image, kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+    if (have_mv) SynthVkBarrier(cb, mv.image, kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+    if (have_depth) SynthVkBarrier(cb, depth.image, kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+    for (int i = 0; i < SLOT_COUNT; ++i) SynthVkBarrier(cb, g_svk.img[i], first, kSVkLayoutGeneral);
+    SynthVkBarrier(cb, g_svk.img[kOutB], first, kSVkLayoutGeneral);
+    const bool clear_guides = !g_svk.laid_out;
+    g_svk.laid_out = true;
+    SynthVkCopyImage(cb, hud.image, kSVkLayoutTransferSrc, g_svk.img[SLOT_COLOR], kSVkLayoutGeneral, back.w, back.h);
+    SynthVkCopyImage(cb, back.image, kSVkLayoutTransferSrc, g_svk.img[kOutB], kSVkLayoutGeneral, back.w, back.h);
+    if (have_mv)
+        SynthVkCopyImage(cb, mv.image, kSVkLayoutTransferSrc, g_svk.img[SLOT_MV], kSVkLayoutGeneral, back.w, back.h);
+    if (have_depth)
+        SynthVkCopyImage(cb, depth.image, kSVkLayoutTransferSrc, g_svk.img[SLOT_DEPTH], kSVkLayoutGeneral, back.w, back.h);
+    if (clear_guides && (!have_mv || !have_depth)) {
+        using ClearImage = void(*)(SVkCommandBuffer, SVkHandle, uint32_t, const void*, uint32_t, const SVkSubresourceRange*);
+        auto get_proc = reinterpret_cast<PFN_SVkGetDeviceProcAddr>(GetProcAddress(g_svk.lib, "vkGetDeviceProcAddr"));
+        auto clear = get_proc != nullptr ? reinterpret_cast<ClearImage>(get_proc(g_svk.dev, "vkCmdClearColorImage")) : nullptr;
+        const float zero[4] = {};
+        const SVkSubresourceRange range = {1, 0, 1, 0, 1};
+        if (clear != nullptr) {
+            if (!have_mv) clear(cb, g_svk.img[SLOT_MV], kSVkLayoutGeneral, zero, 1, &range);
+            if (!have_depth) clear(cb, g_svk.img[SLOT_DEPTH], kSVkLayoutGeneral, zero, 1, &range);
+        }
+    }
+    SynthVkBarrier(cb, hud.image, kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+    SynthVkBarrier(cb, back.image, kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+    if (have_mv) SynthVkBarrier(cb, mv.image, kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+    if (have_depth) SynthVkBarrier(cb, depth.image, kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+
+    g_svk.CmdSetEvent(cb, g_vkm.ev_in[pair], kSVkStageAllCommands);
+    g_vkm.cur = pair;
+    g_vkm.fg_arm = true;
+    --g_present_adapter.remaining;
+    SetEvent(g_vkm.wake);
+    {
+        SVkMemoryBarrier mb = {};
+        mb.sType = kSVkStMemoryBarrier;
+        mb.srcAccessMask = kSVkAccessMemoryRead | kSVkAccessMemoryWrite;
+        mb.dstAccessMask = kSVkAccessMemoryRead | kSVkAccessMemoryWrite;
+        const SVkHandle ev = g_vkm.ev_out[pair];
+        g_svk.CmdWaitEvents(cb, 1, &ev, kSVkStageHost, kSVkStageAllCommands, 1, &mb, 0, nullptr, 0, nullptr);
+    }
+    if (g_cfg.stage >= 3) {
+        SynthVkBarrier(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+        SynthVkBarrier(cb, g_svk.img[kOutB], kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+        SynthVkBarrier(cb, hud.image, kSVkLayoutGeneral, kSVkLayoutTransferDst);
+        SynthVkBarrier(cb, back.image, kSVkLayoutGeneral, kSVkLayoutTransferDst);
+        SynthVkCopyImage(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutTransferSrc, hud.image, kSVkLayoutTransferDst, back.w, back.h);
+        SynthVkCopyImage(cb, g_svk.img[kOutB], kSVkLayoutTransferSrc, back.image, kSVkLayoutTransferDst, back.w, back.h);
+        SynthVkBarrier(cb, hud.image, kSVkLayoutTransferDst, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, back.image, kSVkLayoutTransferDst, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, g_svk.img[kOutB], kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+    }
+}
diff --git a/src/present-adapter-config.h b/src/present-adapter-config.h
new file mode 100644
index 0000000..bd778b5
--- /dev/null
+++ b/src/present-adapter-config.h
@@ -0,0 +1,85 @@
+#pragma once
+
+// Restart-only opt-in: an in-flight presentation transport must not silently
+// change back into the game's DLSS mirror during a live configuration reload.
+static void PresentAdapterPath(wchar_t* path, size_t count, const wchar_t* leaf)
+{
+    path[0] = 0;
+    if (GetModuleFileNameW(g_self, path, static_cast<DWORD>(count)) == 0) return;
+    wchar_t* slash = wcsrchr(path, L'\\');
+    if (slash == nullptr) { path[0] = 0; return; }
+    slash[1] = 0;
+    wcscat_s(path, count, leaf);
+}
+
+static bool PresentationAdapterEnabled()
+{
+    static const bool enabled = [] {
+        wchar_t path[1024] = {};
+        PresentAdapterPath(path, _countof(path), L"vk-present-adapter.ini");
+        return path[0] != 0 && GetPrivateProfileIntW(L"Adapter", L"Enabled", 0, path) == 1;
+    }();
+    return enabled;
+}
+
+// Source=fg-input processes the real frame at the native frame-generation input;
+// any other value keeps the ReShade begin-effects (post-FG) path.
+static bool PresentAdapterFgInput()
+{
+    static const bool fg_input = [] {
+        wchar_t path[1024] = {};
+        PresentAdapterPath(path, _countof(path), L"vk-present-adapter.ini");
+        wchar_t value[64] = {};
+        if (path[0] == 0) return false;
+        GetPrivateProfileStringW(L"Adapter", L"Source", L"present", value, _countof(value), path);
+        return _wcsicmp(value, L"fg-input") == 0;
+    }();
+    return PresentationAdapterEnabled() && fg_input;
+}
+
+// AutoRun=1 starts continuous NR without a request file; a request with frames=0 still stops it.
+static bool PresentAdapterAutoRun()
+{
+    static const bool auto_run = [] {
+        wchar_t path[1024] = {};
+        PresentAdapterPath(path, _countof(path), L"vk-present-adapter.ini");
+        return path[0] != 0 && GetPrivateProfileIntW(L"Adapter", L"AutoRun", 0, path) == 1;
+    }();
+    return PresentAdapterFgInput() && auto_run;
+}
+
+// Follow=1: Generic's own hook point selects the path. Present(2) runs the FG-input
+// feed continuously; Upscaled(0)/Render(1) run the native mirror as before.
+static bool PresentAdapterFollow()
+{
+    static const bool follow = [] {
+        wchar_t path[1024] = {};
+        PresentAdapterPath(path, _countof(path), L"vk-present-adapter.ini");
+        return path[0] != 0 && GetPrivateProfileIntW(L"Adapter", L"Follow", 0, path) == 1;
+    }();
+    return PresentAdapterFgInput() && follow;
+}
+
+static int PresentAdapterHookPoint()
+{
+    static ULONGLONG next_read;
+    static int cached;
+    const ULONGLONG now = GetTickCount64();
+    if (now >= next_read) {
+        next_read = now + 500;
+        wchar_t ini[1024] = {};
+        PresentAdapterPath(ini, _countof(ini), L"ReShade.ini");
+        cached = GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRHookPoint", 0, ini);
+    }
+    return cached;
+}
+
+// Which path holds the private session; mirror and FG-input never share it live.
+enum AdapterOwner { OWNER_NONE, OWNER_MIRROR, OWNER_FG };
+static volatile LONG g_adapter_owner = OWNER_NONE;
+
+static bool FgInputActive()
+{
+    if (!PresentAdapterFgInput()) return false;
+    return !PresentAdapterFollow() || PresentAdapterHookPoint() == 2;
+}
diff --git a/src/present-adapter.inc b/src/present-adapter.inc
new file mode 100644
index 0000000..6501869
--- /dev/null
+++ b/src/present-adapter.inc
@@ -0,0 +1,445 @@
+extern "C" {
+void* g_present_nr_original = nullptr;
+void* g_present_sr_original = nullptr;
+void PresentAdapterNrHook();
+void PresentAdapterSrHook();
+}
+static thread_local bool g_present_nr_scope;
+static thread_local unsigned g_present_nr_entries;
+static thread_local unsigned g_present_sr_entries;
+static thread_local unsigned g_present_sr_copies;
+extern "C" void PresentAdapterNrEnter()
+{
+    if (g_present_nr_scope) ++g_present_nr_entries;
+}
+
+extern "C" NVSDK_NGX_Result PresentAdapterSrEnter(
+    ID3D12GraphicsCommandList* list, const NVSDK_NGX_Handle*,
+    const NVSDK_NGX_Parameter* params, void*)
+{
+    if (!g_present_nr_scope) return 0;
+    ++g_present_sr_entries;
+    if (list != UnwrapList(g_s12.list)) return 0;
+    ID3D12Resource* colour = nullptr;
+    ID3D12Resource* output = nullptr;
+    ID3D12Resource* expected_colour = g_s12.pq.in != nullptr ? g_s12.pq.in : g_s12.tex[SLOT_COLOR];
+    ID3D12Resource* expected_output = g_s12.pq.out != nullptr ? g_s12.pq.out : g_s12.tex[SLOT_OUTPUT];
+    if (params == nullptr || params->Get("Color", &colour) != NGX_SUCCESS ||
+        params->Get("Output", &output) != NGX_SUCCESS ||
+        colour != expected_colour || output != expected_output) return 0;
+    const D3D12_RESOURCE_DESC input_desc = colour->GetDesc();
+    const D3D12_RESOURCE_DESC output_desc = output->GetDesc();
+    if (input_desc.Width != output_desc.Width || input_desc.Height != output_desc.Height ||
+        input_desc.SampleDesc.Count != 1 || output_desc.SampleDesc.Count != 1 ||
+        Synth12UavFormat(input_desc.Format) != Synth12UavFormat(output_desc.Format)) return 0;
+    // Only the private carrier is replaced; game SR calls retain their original caller and implementation.
+    Barrier(list, colour, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Barrier(list, output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(output, colour);
+    Barrier(list, output, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Barrier(list, colour, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    ++g_present_sr_copies;
+    return NGX_SUCCESS;
+}
+
+struct PresentAdapterState {
+    bool request_seen, refused, nr_hook, sr_hook, run_nr, colour_roundtrip, stopped, continuous;
+    uint32_t source_space;
+    ULONGLONG poll_at, deadline, accepted;
+    unsigned long long token;
+    unsigned remaining, frames, writes, skipped_nr;
+    reshade::api::effect_runtime* owner;
+};
+static PresentAdapterState g_present_adapter = {};
+
+static bool PresentAdapterConfiguration()
+{
+    wchar_t ini[1024] = {};
+    PresentAdapterPath(ini, _countof(ini), L"ReShade.ini");
+    const int hook_point = GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRHookPoint", 0, ini);
+    if (GetPrivateProfileIntW(L"RenoDX.DLSS5", L"EnableHooks", 2, ini) != 1 ||
+        (hook_point != 0 && hook_point != 2))
+    {
+        Log("[present-adapter] refused: keep EnableHooks=1 and NRHookPoint=0 (Upscaled) or2 (Present) for the D3D12 carrier.");
+        return false;
+    }
+    if (GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRSourceEncoding", 0, ini) != 0 ||
+        GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRSourcePrimaries", 0, ini) != 0 ||
+        GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRLinearUnitNits", 0, ini) != 0) {
+        Log("[present-adapter] refused: source encoding, primaries and linear-unit overrides must be Auto; the carrier supplies normalized SDR or scRGB.");
+        return false;
+    }
+    return true;
+}
+
+static bool PresentAdapterConsumer()
+{
+    const HMODULE consumer = GetModuleHandleW(L"renodx-dlss5.addon64");
+    wchar_t path[1024] = {};
+    char hash[65] = {};
+    if (consumer == nullptr || GetModuleFileNameW(consumer, path, _countof(path)) == 0 ||
+        !Sha256File(path, hash, sizeof(hash)) ||
+        _stricmp(hash, "DCD93881E976AD033D83C2BB01F4BC3E4DDC59C15FE0DD4CA165BC5FC7D1AC68") != 0)
+    {
+        Log("[present-adapter] refused: this experiment requires the unmodified Generic 8.5.0-rc10 DCD93881 build.");
+        return false;
+    }
+    return PresentAdapterConfiguration();
+}
+
+static bool PresentAdapterWitness()
+{
+    if (g_present_adapter.nr_hook) return true;
+    HMODULE runtime = GetModuleHandleW(L"nvngx_dlssnr.dll");
+    void* entry = runtime != nullptr
+        ? reinterpret_cast<void*>(GetProcAddress(runtime, "NVSDK_NGX_D3D12_EvaluateFeature")) : nullptr;
+    if (entry == nullptr) return false;
+    // The tail forward preserves the caller's return address and all four args.
+    // A module reference prevents a live hook from pointing into an unloaded DLL.
+    HMODULE keep = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                          reinterpret_cast<LPCWSTR>(entry), &keep)) return false;
+    const MH_STATUS made = MH_CreateHook(entry, reinterpret_cast<void*>(&PresentAdapterNrHook),
+                                         &g_present_nr_original);
+    if (made != MH_OK) return false;
+    const MH_STATUS enabled = MH_EnableHook(entry);
+    if (enabled != MH_OK) { MH_RemoveHook(entry); g_present_nr_original = nullptr; return false; }
+    g_present_adapter.nr_hook = true;
+    Log("[present-adapter] NR entry witness ready (tail-forward, CPU observation only).");
+    return true;
+}
+
+static HMODULE PresentAdapterSrModule()
+{
+    auto enumerate = reinterpret_cast<PFN_EnumProcessModules>(
+        GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "K32EnumProcessModules"));
+    HMODULE modules[512] = {};
+    DWORD needed = 0;
+    if (enumerate == nullptr || !enumerate(GetCurrentProcess(), modules, sizeof(modules), &needed) ||
+        needed > sizeof(modules)) return nullptr;
+    HMODULE found = nullptr;
+    for (DWORD i = 0; i < needed / sizeof(HMODULE); ++i) {
+        if (GetProcAddress(modules[i], "NVSDK_NGX_D3D12_EvaluateFeature") == nullptr) continue;
+        wchar_t path[1024] = {};
+        if (GetModuleFileNameW(modules[i], path, _countof(path)) == 0) continue;
+        DWORD ignored = 0;
+        const DWORD size = GetFileVersionInfoSizeW(path, &ignored);
+        if (size == 0) continue;
+        std::vector<unsigned char> version(size);
+        if (!GetFileVersionInfoW(path, 0, size, version.data())) continue;
+        struct Translation { WORD language, codepage; };
+        Translation* translations = nullptr;
+        UINT bytes = 0;
+        if (!VerQueryValueW(version.data(), L"\\VarFileInfo\\Translation",
+                            reinterpret_cast<void**>(&translations), &bytes)) continue;
+        bool is_sr = false;
+        for (UINT j = 0; j < bytes / sizeof(Translation); ++j) {
+            wchar_t* name = nullptr;
+            wchar_t* product = nullptr;
+            UINT length = 0;
+            wchar_t key[96] = {};
+            swprintf_s(key, L"\\StringFileInfo\\%04x%04x\\InternalName",
+                       translations[j].language, translations[j].codepage);
+            if (!VerQueryValueW(version.data(), key, reinterpret_cast<void**>(&name), &length) ||
+                name == nullptr || length == 0) continue;
+            swprintf_s(key, L"\\StringFileInfo\\%04x%04x\\ProductName",
+                       translations[j].language, translations[j].codepage);
+            if (!VerQueryValueW(version.data(), key, reinterpret_cast<void**>(&product), &length) ||
+                product == nullptr || length == 0) continue;
+            const wchar_t* leaf = wcsrchr(path, L'\\');
+            leaf = leaf != nullptr ? leaf + 1 : path;
+            // Full paths with non-ANSI characters print empty through %ls; the leaf is enough to identify the module.
+            Log("[present-adapter] NGX evaluate module: %ls internal=%ls product=%ls.", leaf, name, product);
+            // Ray Reconstruction shares InternalName=DLSS; only the super-sampling product is the SR carrier.
+            if (_wcsicmp(name, L"DLSS") == 0 &&
+                _wcsicmp(product, L"NVIDIA Deep Learning SuperSampling") == 0) is_sr = true;
+        }
+        if (!is_sr) continue;
+        if (found != nullptr && found != modules[i]) {
+            Log("[present-adapter] multiple SR modules found; refusing ambiguous carrier hook.");
+            return nullptr;
+        }
+        found = modules[i];
+    }
+    return found;
+}
+
+static bool PresentAdapterCarrier()
+{
+    if (g_present_adapter.sr_hook) return true;
+    const HMODULE runtime = PresentAdapterSrModule();
+    void* entry = runtime != nullptr
+        ? reinterpret_cast<void*>(GetProcAddress(runtime, "NVSDK_NGX_D3D12_EvaluateFeature")) : nullptr;
+    if (entry == nullptr) {
+        Log("[present-adapter] SR export unavailable: module=%p entry=%p error=%lu.", runtime, entry, GetLastError());
+        return false;
+    }
+    HMODULE keep = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                          reinterpret_cast<LPCWSTR>(entry), &keep)) return false;
+    const MH_STATUS made = MH_CreateHook(entry, reinterpret_cast<void*>(&PresentAdapterSrHook), &g_present_sr_original);
+    if (made != MH_OK) {
+        Log("[present-adapter] SR hook creation failed: status=%d entry=%p.", static_cast<int>(made), entry);
+        return false;
+    }
+    const MH_STATUS enabled = MH_EnableHook(entry);
+    if (enabled != MH_OK) {
+        Log("[present-adapter] SR hook enable failed: status=%d.", static_cast<int>(enabled));
+        MH_RemoveHook(entry);
+        g_present_sr_original = nullptr;
+        return false;
+    }
+    g_present_adapter.sr_hook = true;
+    Log("[present-adapter] private SR carrier copy ready; external SR calls remain tail-forwarded.");
+    return true;
+}
+
+static void PresentAdapterRequest()
+{
+    const ULONGLONG now = GetTickCount64();
+    if (now < g_present_adapter.poll_at) return;
+    g_present_adapter.poll_at = now + 500;
+    wchar_t path[1024] = {};
+    PresentAdapterPath(path, _countof(path), L"vk-present-adapter.request");
+    FILE* file = nullptr;
+    unsigned long long token = 0;
+    unsigned frames = 0, nr = 0;
+    if (_wfopen_s(&file, path, L"rb") == 0 && file != nullptr) {
+        if (fscanf_s(file, "%llu %u %u", &token, &frames, &nr) != 3) token = 0;
+        fclose(file);
+    }
+    if (!g_present_adapter.request_seen) {
+        g_present_adapter.request_seen = true;
+        g_present_adapter.token = token;
+        Log("[present-adapter] enabled, idle. Awaiting a new request token; existing requests are ignored.");
+        return;
+    }
+    if (token == 0 || token == g_present_adapter.token) return;
+    g_present_adapter.token = token;
+    if (frames == 0) { g_present_adapter.remaining = 0; g_present_adapter.stopped = true; g_present_adapter.continuous = false; Log("[present-adapter] stopped by request."); return; }
+    if (frames > 1800 || nr > 2 || g_present_adapter.refused) {
+        Log("[present-adapter] request refused (invalid count/mode or retired session)."); return;
+    }
+    if (!PresentAdapterConsumer()) { g_present_adapter.refused = true; return; }
+    g_present_adapter.remaining = frames;
+    g_present_adapter.stopped = false;
+    g_present_adapter.continuous = false;
+    g_present_adapter.run_nr = nr == 1;
+    g_present_adapter.colour_roundtrip = nr == 2;
+    // Frames between requests were not evaluated, so their temporal history is missing.
+    if (g_present_adapter.run_nr) g_s12.need_reset = true;
+    g_present_adapter.frames = g_present_adapter.writes = g_present_adapter.skipped_nr = 0;
+    g_present_adapter.accepted = now;
+    g_present_adapter.deadline = now + 60000;
+    Log("[present-adapter] request %llu accepted: max=%u frames, deadline=60s, mode=%s, guides=neutral.",
+        token, frames, nr == 1 ? "Generic NR via identity SR carrier" :
+                       nr == 2 ? "carrier colour roundtrip only" : "copy roundtrip only");
+}
+
+static bool PresentAdapterCopy12()
+{
+    const bool converted = g_present_adapter.colour_roundtrip && g_s12.pq.in != nullptr;
+    ID3D12Resource* colour = converted ? g_s12.pq.in : g_s12.tex[SLOT_COLOR];
+    ID3D12Resource* output = converted ? g_s12.pq.out : g_s12.tex[SLOT_OUTPUT];
+    if (Synth12UavFormat(colour->GetDesc().Format) != Synth12UavFormat(output->GetDesc().Format)) return false;
+    if (converted && !PqPassBefore(&g_s12.pq, g_s12.queue, 1000)) return false;
+    if (!Synth12Begin(1000)) return false;
+    const D3D12_RESOURCE_STATES input_state = converted ? D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE : D3D12_RESOURCE_STATE_COMMON;
+    const D3D12_RESOURCE_STATES output_state = converted ? D3D12_RESOURCE_STATE_UNORDERED_ACCESS : D3D12_RESOURCE_STATE_COMMON;
+    Barrier(g_s12.list, colour, input_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Barrier(g_s12.list, output, output_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    g_s12.list->CopyResource(output, colour);
+    Barrier(g_s12.list, colour, D3D12_RESOURCE_STATE_COPY_SOURCE, input_state);
+    Barrier(g_s12.list, output, D3D12_RESOURCE_STATE_COPY_DEST, output_state);
+    UINT64 submitted = Synth12End();
+    if (converted) {
+        const UINT64 encoded = PqPassAfter(&g_s12.pq, g_s12.queue, g_s12.fence,
+                                           &g_s12.fence_value, submitted, 0, 1000);
+        if (encoded == submitted) return false;
+        submitted = encoded;
+    }
+    return Synth12WaitFence(submitted, 1000) && g_s12.dev->GetDeviceRemovedReason() == S_OK;
+}
+
+static void PresentAdapterFrame(reshade::api::effect_runtime* rt, reshade::api::command_list* cmd,
+                                reshade::api::resource_view rtv)
+{
+    using namespace reshade::api;
+    static thread_local bool in_frame;
+    if (in_frame) return;
+    if (rt == nullptr || cmd == nullptr || rtv.handle == 0) return;
+    if (PresentAdapterFgInput()) return;
+    device* dev = rt->get_device();
+    if (dev == nullptr || dev->get_api() != device_api::vulkan) return;
+    if (!TryEnterCriticalSection(&g_bridge_cs)) return;
+    struct Unlock { ~Unlock() { LeaveCriticalSection(&g_bridge_cs); } } unlock;
+    in_frame = true;
+    struct FrameScope { bool& value; ~FrameScope() { value = false; } } frame_scope{in_frame};
+    PresentAdapterRequest();
+    if (g_present_adapter.remaining == 0 || g_present_adapter.refused) return;
+    if (GetTickCount64() >= g_present_adapter.deadline) {
+        Log("[present-adapter] request complete: frames=%u writes=%u no_nr=%u (deadline).",
+            g_present_adapter.frames, g_present_adapter.writes, g_present_adapter.skipped_nr);
+        g_present_adapter.remaining = 0; return;
+    }
+    if (g_present_adapter.owner != nullptr && g_present_adapter.owner != rt) return;
+    if (!PresentAdapterConfiguration()) {
+        g_present_adapter.remaining = 0;
+        g_present_adapter.refused = true;
+        return;
+    }
+    if (g_cfg.mode != 2 || g_cfg.stage != 3) {
+        Log("[present-adapter] refused: the experiment requires Bridge mode=2, stage=3.");
+        g_present_adapter.refused = true; return;
+    }
+    SynthBound back = {};
+    SynthResolveView(dev, static_cast<uint32_t>(device_api::vulkan), rtv, &back);
+    if (back.res.handle == 0 || back.w == 0 || back.h == 0 || back.samples != 1 ||
+        (back.usage & static_cast<uint32_t>(resource_usage::copy_source)) == 0) return;
+    if (back.res.handle != rt->get_current_back_buffer().handle) return;
+    command_queue* queue = rt->get_command_queue();
+    if (queue == nullptr || queue->get_immediate_command_list() != cmd) {
+        Log("[present-adapter] refused: callback is not the queue's immediate command list.");
+        g_present_adapter.refused = true; return;
+    }
+    PresentSwapchainContract source;
+    {
+        std::lock_guard<std::mutex> lock(g_present_swapchain_mutex);
+        source = g_present_swapchain;
+    }
+    if (source.device != dev || source.window != rt->get_hwnd() || source.first_buffer == 0 ||
+        rt->get_back_buffer_count() == 0 || source.first_buffer != rt->get_back_buffer(0).handle) {
+        Log("[present-adapter] no matching swapchain colour contract; refusing processing.");
+        g_present_adapter.refused = true;
+        return;
+    }
+    const color_space space = source.space;
+    const bool floating = SynthFormatCanExceedOne(back.fmt);
+    const bool srgb = space == color_space::srgb && !floating;
+    const bool pq = space == color_space::hdr10_pq && !floating;
+    if (!srgb && !pq && !(space == color_space::scrgb && floating)) {
+        Log("[present-adapter] unsupported source colour contract: space=%u format=%u.",
+            static_cast<unsigned>(space), static_cast<unsigned>(back.fmt));
+        g_present_adapter.refused = true;
+        return;
+    }
+    g_present_adapter.owner = rt;
+    InterlockedExchange(&g_source, SRC_SYNTH);
+    SynthParams params;
+    SynthBuild(&params, back.w, back.h, back.fmt, back.res, resource{0}, resource{0}, 0, -1);
+    params.Set("DLSS.Feature.Create.Flags", srgb ? 0u : 1u);
+    if (!Synth12Open(rt) || !SynthVkOpen(rt)) {
+        g_present_adapter.refused = true; Log("[present-adapter] session creation failed; no image modified."); return;
+    }
+    const bool rebuild = g_s12.feature == nullptr || g_s12.w != back.w ||
+                         g_s12.h != back.h || g_s12.fmt != back.fmt ||
+                         g_present_adapter.source_space != static_cast<uint32_t>(space);
+    if (rebuild) {
+        queue->wait_idle();
+        if (!Synth12Drain(1000)) {
+            g_present_adapter.refused = true; return;
+        }
+        SynthVkPresentRelease();
+        SynthVkReleaseImages();
+        if (!Synth12Build(&params, back.w, back.h, back.w, back.h, back.fmt,
+                          false, 0, 0, false, DXGI_FORMAT_R32_FLOAT, DXGI_FORMAT_UNKNOWN, srgb, pq) ||
+            !SynthVkImport()) {
+            g_present_adapter.refused = true; Log("[present-adapter] image build/import failed."); return;
+        }
+        g_present_adapter.source_space = static_cast<uint32_t>(space);
+        Log("[present-adapter] source space=%u; working colour=%s.", static_cast<unsigned>(space),
+            srgb ? "linear normalized SDR" : "linear BT.709, 1.0=80 nits");
+    }
+    if (g_present_adapter.run_nr && !PresentAdapterCarrier()) {
+        g_present_adapter.refused = true;
+        Log("[present-adapter] private SR carrier hook unavailable; no image modified.");
+        return;
+    }
+    const bool draw = (back.usage & static_cast<uint32_t>(resource_usage::copy_dest)) == 0;
+    if (draw && (!SynthVkPresentOpen(dev, back.fmt) || !SynthVkPresentSize(back.w, back.h, back.fmt))) {
+        g_present_adapter.refused = true; Log("[present-adapter] draw-back resources failed."); return;
+    }
+    using ClearImage = void(*)(SVkCommandBuffer, SVkHandle, uint32_t, const void*, uint32_t,
+                               const SVkSubresourceRange*);
+    auto get_proc = reinterpret_cast<PFN_SVkGetDeviceProcAddr>(GetProcAddress(g_svk.lib, "vkGetDeviceProcAddr"));
+    auto clear = get_proc != nullptr ? reinterpret_cast<ClearImage>(get_proc(g_svk.dev, "vkCmdClearColorImage")) : nullptr;
+    if (clear == nullptr) { g_present_adapter.refused = true; return; }
+    const double t0 = SynthNowMs();
+    cmd->barrier(back.res, resource_usage::render_target, resource_usage::copy_source);
+    auto cb = reinterpret_cast<SVkCommandBuffer>(static_cast<uintptr_t>(cmd->get_native()));
+    const bool initialize_guides = !g_svk.laid_out;
+    for (int i = 0; i < SLOT_COUNT; ++i)
+        SynthVkBarrier(cb, g_svk.img[i], g_svk.laid_out ? kSVkLayoutGeneral : kSVkLayoutUndefined,
+                       kSVkLayoutGeneral);
+    g_svk.laid_out = true;
+    if (initialize_guides) {
+        const float zero[4] = {};
+        const SVkSubresourceRange range = {1, 0, 1, 0, 1};
+        clear(cb, g_svk.img[SLOT_DEPTH], kSVkLayoutGeneral, zero, 1, &range);
+        clear(cb, g_svk.img[SLOT_MV], kSVkLayoutGeneral, zero, 1, &range);
+        SynthVkBarrier(cb, g_svk.img[SLOT_DEPTH], kSVkLayoutGeneral, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, g_svk.img[SLOT_MV], kSVkLayoutGeneral, kSVkLayoutGeneral);
+    }
+    SynthVkCopyImage(cb, static_cast<SVkHandle>(back.res.handle), kSVkLayoutTransferSrc,
+                     g_svk.img[SLOT_COLOR], kSVkLayoutGeneral, back.w, back.h);
+    // Flush the borrowed immediate list before D3D12 reads the imported image.
+    // No host-event park, guessed completion or writeback on a failed wait.
+    queue->wait_idle();
+    const double input_ready = SynthNowMs();
+    const bool history_reset = g_s12.need_reset;
+    bool ok = false;
+    unsigned nr_entries = 0, sr_entries = 0, sr_copies = 0;
+    if (g_present_adapter.run_nr) {
+        PresentAdapterWitness();
+        g_present_nr_entries = g_present_sr_entries = g_present_sr_copies = 0;
+        g_present_nr_scope = true;
+        if (g_ngx_cs_ready) EnterCriticalSection(&g_ngx_cs);
+        ok = Synth12EvaluateShared(&params, 1000);
+        if (g_ngx_cs_ready) LeaveCriticalSection(&g_ngx_cs);
+        g_present_nr_scope = false;
+        nr_entries = g_present_nr_entries;
+        sr_entries = g_present_sr_entries;
+        sr_copies = g_present_sr_copies;
+        if (sr_entries != 1 || sr_copies != 1) {
+            Log("[present-adapter] carrier contract mismatch: sr_entries=%u sr_copies=%u; refusing writeback.",
+                sr_entries, sr_copies);
+            ok = false;
+        }
+    } else {
+        ok = PresentAdapterCopy12();
+    }
+    ok = ok && g_s12.dev->GetDeviceRemovedReason() == S_OK &&
+         g_s12.fence->GetCompletedValue() != UINT64_MAX;
+    cb = reinterpret_cast<SVkCommandBuffer>(static_cast<uintptr_t>(cmd->get_native()));
+    const bool write = ok && (!g_present_adapter.run_nr || nr_entries != 0);
+    if (write && draw) {
+        SynthVkPresentDraw(cmd, cb, back.res, rtv, back.w, back.h, g_svk.img[SLOT_OUTPUT]);
+    } else if (write) {
+        cmd->barrier(back.res, resource_usage::copy_source, resource_usage::copy_dest);
+        SynthVkBarrier(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutGeneral, kSVkLayoutGeneral);
+        SynthVkCopyImage(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutGeneral,
+                         static_cast<SVkHandle>(back.res.handle), kSVkLayoutTransferDst, back.w, back.h);
+        cmd->barrier(back.res, resource_usage::copy_dest, resource_usage::render_target);
+    } else {
+        cmd->barrier(back.res, resource_usage::copy_source, resource_usage::render_target);
+    }
+    ++g_present_adapter.frames;
+    if (write) ++g_present_adapter.writes;
+    if (ok && g_present_adapter.run_nr && nr_entries == 0) ++g_present_adapter.skipped_nr;
+    --g_present_adapter.remaining;
+    if (g_present_adapter.frames <= 3 || g_present_adapter.frames % 120 == 0 ||
+        g_present_adapter.remaining == 0 || !ok)
+        Log("[present-adapter] frame=%u input=backbuffer-before-ReShade %ux%u fmt=%u image=0x%llX mode=%s nr_entries=%u completed=%d writeback=%d cpu_ms=%.2f. token=%llu reset=%d sr_entries=%u sr_copies=%u input_wait_ms=%.2f.",
+            g_present_adapter.frames, back.w, back.h, static_cast<unsigned>(back.fmt),
+            back.res.handle, g_present_adapter.run_nr ? "NR" : g_present_adapter.colour_roundtrip ? "carrier" : "copy", nr_entries,
+            ok ? 1 : 0, write ? 1 : 0, SynthNowMs() - t0,
+            g_present_adapter.token, history_reset ? 1 : 0, sr_entries, sr_copies, input_ready - t0);
+    if (!ok) {
+        g_present_adapter.refused = true;
+        Log("[present-adapter] stopped after failed processing/completion; no copyback recorded for this frame.");
+    }
+    if (g_present_adapter.remaining == 0)
+        Log("[present-adapter] request complete: frames=%u writes=%u no_nr=%u. token=%llu",
+            g_present_adapter.frames, g_present_adapter.writes, g_present_adapter.skipped_nr,
+            g_present_adapter.token);
+}
diff --git a/src/present-nr-witness.asm b/src/present-nr-witness.asm
new file mode 100644
index 0000000..53fbf1e
--- /dev/null
+++ b/src/present-nr-witness.asm
@@ -0,0 +1,44 @@
+option casemap:none
+EXTERN PresentAdapterNrEnter:PROC
+EXTERN PresentAdapterSrEnter:PROC
+EXTERN g_present_nr_original:QWORD
+EXTERN g_present_sr_original:QWORD
+.code
+PresentAdapterNrHook PROC FRAME
+    sub rsp, 68h
+    .allocstack 68h
+    .endprolog
+    mov [rsp+30h], rcx
+    mov [rsp+38h], rdx
+    mov [rsp+40h], r8
+    mov [rsp+48h], r9
+    call PresentAdapterNrEnter
+    mov rcx, [rsp+30h]
+    mov rdx, [rsp+38h]
+    mov r8, [rsp+40h]
+    mov r9, [rsp+48h]
+    add rsp, 68h
+    jmp QWORD PTR [g_present_nr_original]
+PresentAdapterNrHook ENDP
+PresentAdapterSrHook PROC FRAME
+    sub rsp, 68h
+    .allocstack 68h
+    .endprolog
+    mov [rsp+30h], rcx
+    mov [rsp+38h], rdx
+    mov [rsp+40h], r8
+    mov [rsp+48h], r9
+    call PresentAdapterSrEnter
+    test eax, eax
+    jnz sr_handled
+    mov rcx, [rsp+30h]
+    mov rdx, [rsp+38h]
+    mov r8, [rsp+40h]
+    mov r9, [rsp+48h]
+    add rsp, 68h
+    jmp QWORD PTR [g_present_sr_original]
+sr_handled:
+    add rsp, 68h
+    ret
+PresentAdapterSrHook ENDP
+END
