 //-------------------------------------------------------------------------
+static BOOL MatchesExtendedPrologue(LPVOID target)
+{
+#if defined(_M_X64) || defined(__x86_64__)
+    static const BYTE prologue[] = {0x48, 0x89, 0x5C, 0x24, 0x08};
+    MEMORY_BASIC_INFORMATION region;
+    if (VirtualQuery(target, &region, sizeof(region)) == 0 || region.State != MEM_COMMIT ||
+        (region.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0 ||
+        (ULONG_PTR)target + sizeof(prologue) > (ULONG_PTR)region.BaseAddress + region.RegionSize)
+        return FALSE;
+    return memcmp(target, prologue, sizeof(prologue)) == 0;
+#else
+    (void)target;
+    return FALSE;
+#endif
+}
+
 static MH_STATUS CreateHookTrampoline(UINT pos)
 {
     PHOOK_ENTRY pHook = &g_hooks.pItems[pos];
+    // An existing jump can hide a RIP-relative prologue that reappears when a lower hook is removed.
+    if (pHook->extendedPrologue && !MatchesExtendedPrologue(pHook->pTarget))
+        return MH_ERROR_UNSUPPORTED_FUNCTION;
 
     TRAMPOLINE ct;
     ct.pTarget = pHook->pTarget;
@@ -562,6 +582,15 @@ static MH_STATUS WINAPI EnableHookLL(UINT pos, BOOL enable, PFROZEN_THREADS pThr
         }
     }
 
+#if defined(_M_X64) || defined(__x86_64__)
+    if (enable)
+    {
+        const INT64 displacement = (INT64)(ULONG_PTR)&pHook->pExecBuffer->jmpRelay
+                                 - (INT64)(ULONG_PTR)(pPatchTarget + sizeof(JMP_REL));
+        if (displacement < INT_MIN || displacement > INT_MAX)
+            return MH_ERROR_UNSUPPORTED_FUNCTION;
+    }
+#endif
     if (!VirtualProtect(pPatchTarget, patchSize, PAGE_EXECUTE_READWRITE, &oldProtect))
         return MH_ERROR_MEMORY_PROTECT;
 
@@ -773,7 +802,7 @@ MH_STATUS WINAPI MH_SetThreadFreezeMethod(MH_THREAD_FREEZE_METHOD method)
 }
 
