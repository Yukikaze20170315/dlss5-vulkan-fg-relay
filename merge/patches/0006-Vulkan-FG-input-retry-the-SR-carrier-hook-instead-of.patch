+// TEST ONLY. A ReShade add-on that recreates, on demand, the start-up race the
+// SR carrier retry handles: it holds an extra reference on the game folder's
+// nvngx_dlss.dll from the moment dlss5-bridge opens its private D3D12 session
+// until 1.5 s after the bridge has logged the ambiguity, so the carrier search
+// sees two SR modules (the driver's DLSS model and nvngx_dlss.dll).
+// Expected: a bridge without the retry refuses NR for the session; a bridge
+// with it logs "SR carrier hook installed on attempt N" and NR runs.
+// Remove it from the game folder after the test.
+#include <windows.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+extern "C" __declspec(dllexport) const char *NAME = "carrier-race-helper (test only)";
+extern "C" __declspec(dllexport) const char *DESCRIPTION =
+    "Holds nvngx_dlss.dll during dlss5-bridge's SR carrier search to reproduce the start-up race. Remove after testing.";
+
+typedef bool (*PFN_Register)(HMODULE, uint32_t);
+static wchar_t g_dir[MAX_PATH];
+
+static void Note(const char *text)
+{
+    wchar_t path[MAX_PATH];
+    swprintf_s(path, L"%ls\\carrier-race-helper.log", g_dir);
+    FILE *file = nullptr;
+    if (_wfopen_s(&file, path, L"ab") != 0 || file == nullptr) return;
+    SYSTEMTIME t;
+    GetLocalTime(&t);
+    fprintf(file, "%02u:%02u:%02u.%03u  %s\r\n", t.wHour, t.wMinute, t.wSecond, t.wMilliseconds, text);
+    fclose(file);
+}
+
+// Reads the bridge log from `offset`, appends to `seen`; the log only grows.
+static void ReadLog(long long &offset, std::string &seen)
+{
+    wchar_t path[MAX_PATH];
+    swprintf_s(path, L"%ls\\dlss5-bridge.log", g_dir);
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              nullptr, OPEN_EXISTING, 0, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return;
+    LARGE_INTEGER size = {};
+    if (GetFileSizeEx(file, &size) && size.QuadPart < offset) { offset = 0; seen.clear(); }
+    LARGE_INTEGER at = {};
+    at.QuadPart = offset;
+    SetFilePointerEx(file, at, nullptr, FILE_BEGIN);
+    char buffer[65536];
+    DWORD got = 0;
+    while (ReadFile(file, buffer, sizeof(buffer), &got, nullptr) && got != 0) {
+        seen.append(buffer, got);
+        offset += got;
+    }
+    CloseHandle(file);
+    if (seen.size() > (1u << 20)) seen.erase(0, seen.size() - (1u << 16));
+}
+
+static long MsOfDay(const SYSTEMTIME &t)
+{
+    return ((t.wHour * 60L + t.wMinute) * 60L + t.wSecond) * 1000L + t.wMilliseconds;
+}
+
+// The bridge recreates its log when it attaches and the log has no process id,
+// so a log is taken as this session's when its first time stamp is within a
+// minute of this add-on's start. Until then an older session's log is ignored.
+static bool LogIsThisSession(const std::string &seen, long started)
+{
+    unsigned h = 0, m = 0, s = 0, ms = 0;
+    if (seen.size() < 12 || sscanf_s(seen.c_str(), "%2u:%2u:%2u.%3u", &h, &m, &s, &ms) != 4) return false;
+    const long stamp = ((h * 60L + m) * 60L + s) * 1000L + ms;
+    return labs(stamp - started) <= 60000;
+}
+
+static DWORD WINAPI Worker(void *)
+{
+    Note("started; waiting for the bridge to open its private D3D12 session");
+    SYSTEMTIME now;
+    GetLocalTime(&now);
+    const long started = MsOfDay(now);
+    long long offset = 0;
+    std::string seen;
+    HMODULE held = nullptr;
+    const ULONGLONG deadline = GetTickCount64() + 15ull * 60ull * 1000ull;
+    while (GetTickCount64() < deadline) {
+        ReadLog(offset, seen);
+        if (!LogIsThisSession(seen, started)) { offset = 0; seen.clear(); Sleep(50); continue; }
+        if (held == nullptr && seen.find("synth: opening on this add-on's own D3D12 device") != std::string::npos) {
+            wchar_t dll[MAX_PATH];
+            swprintf_s(dll, L"%ls\\nvngx_dlss.dll", g_dir);
+            held = LoadLibraryW(dll);
+            Note(held != nullptr ? "holding the game folder's nvngx_dlss.dll" : "nvngx_dlss.dll could not be loaded");
+            if (held == nullptr) return 0;
+        }
+        if (held != nullptr && seen.find("multiple SR modules found") != std::string::npos) {
+            Note("bridge reported two SR modules; releasing nvngx_dlss.dll in 1.5 s");
+            Sleep(1500);
+            FreeLibrary(held);
+            Note("released; the bridge's next carrier attempt should find one SR module");
+            return 0;
+        }
+        if (held != nullptr && seen.find("private SR carrier copy ready") != std::string::npos) {
+            Note("the carrier installed without seeing the race (timing missed); releasing");
+            FreeLibrary(held);
+            return 0;
+        }
+        Sleep(10);
+    }
+    if (held != nullptr) FreeLibrary(held);
+    Note("timed out");
+    return 0;
+}
+
+BOOL APIENTRY DllMain(HMODULE self, DWORD reason, LPVOID)
+{
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+    // ReShade loads and unloads add-ons several times at start-up; the worker
+    // must outlive that, so this module stays mapped until the process exits.
+    HMODULE pinned = nullptr;
+    GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                       reinterpret_cast<LPCWSTR>(&DllMain), &pinned);
+    static bool started = false;
+    if (started) return TRUE;
+    started = true;
+    GetModuleFileNameW(self, g_dir, MAX_PATH);
+    if (wchar_t *slash = wcsrchr(g_dir, L'\\')) *slash = L'\0';
+    HMODULE reshade = nullptr;
+    for (const wchar_t *name : {L"ReShade64.dll", L"dxgi.dll", L"d3d12.dll", L"d3d11.dll"}) {
+        reshade = GetModuleHandleW(name);
+        if (reshade != nullptr && GetProcAddress(reshade, "ReShadeRegisterAddon") != nullptr) break;
+        reshade = nullptr;
+    }
+    if (reshade != nullptr) {
+        auto reg = reinterpret_cast<PFN_Register>(GetProcAddress(reshade, "ReShadeRegisterAddon"));
+        for (uint32_t version = 18; version >= 5 && !reg(self, version); --version) {}
+    }
+    HANDLE thread = CreateThread(nullptr, 0, Worker, nullptr, 0, nullptr);
+    if (thread != nullptr) CloseHandle(thread);
+    return TRUE;
+}
