+#pragma once
+// The anomaly event log of the suite: dlss5/dlss5_log/dlss5-events-*.log.
+//
+// Producers (any thread, including hooks) call Add(); it formats one line and
+// queues it under a short lock. The Bridge's maintenance thread calls Flush()
+// about four times a second; Flush is the only writer of the file.
+//
+// Two modes:
+//  * bounded (default): the first occurrence of each distinct anomaly is
+//    written in full; repeats are counted and written as one "[repeat xN]" line
+//    per anomaly per window. One session writes at most two 8 MB parts, the
+//    bounded files in the folder are kept to 64 MB and 30 files, oldest first.
+//  * full (opt-in, panel confirmation): every occurrence is written in full, in
+//    64 MB parts named dlss5-events-full-*, which the bounded retention never
+//    deletes. Writing pauses while the log volume has less than 4 GB free and
+//    resumes above 6 GB; paused events are counted and the count is written.
+//
+// Nothing here throws into the caller, and nothing calls back into a logger.
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include "../../common/event-log.hpp"
+
+class EventSink {
+public:
+    struct Limits {
+        uint64_t bounded_part = 8ull << 20;
+        uint32_t bounded_parts = 2;
+        uint64_t bounded_folder_budget = 64ull << 20;
+        uint32_t bounded_keep_files = 30;
+        uint64_t full_part = 64ull << 20;
+        uint64_t full_floor_stop = 4ull << 30;
+        uint64_t full_floor_resume = 6ull << 30;
+        uint64_t bounded_floor_stop = 512ull << 20;
+        uint32_t repeat_window_ms = 10000;
+        uint32_t budget_summary_ms = 300000;
+        uint32_t space_check_ms = 2000;
+        uint32_t paused_check_ms = 30000;
+        size_t queue_cap_bytes = 32u << 20;
+        size_t key_cap = 2048;
+    };
+    // Free bytes available on the volume holding `dir`; replaceable for tests.
+    using FreeSpaceFn = uint64_t (*)(const wchar_t *dir);
+
+    EventSink() { InitializeCriticalSection(&file_cs_); }
+    EventSink(const EventSink &) = delete;
+    EventSink &operator=(const EventSink &) = delete;
+
+    void Configure(const wchar_t *dir, const Limits &limits, FreeSpaceFn free_space = nullptr)
+    {
+        EnterCriticalSection(&file_cs_);
+        wcsncpy_s(dir_, dir != nullptr ? dir : L"", _TRUNCATE);
+        limits_ = limits;
+        free_space_ = free_space != nullptr ? free_space : &VolumeFree;
+        SYSTEMTIME st; GetLocalTime(&st);
+        _snwprintf_s(session_, _TRUNCATE, L"%04u%02u%02u-%02u%02u%02u-%lu",
+                     st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, GetCurrentProcessId());
+        configured_.store(dir_[0] != 0, std::memory_order_release);
+        LeaveCriticalSection(&file_cs_);
+    }
+
+    void SetFull(bool full) { full_.store(full, std::memory_order_release); }
+    bool Full() const { return full_.load(std::memory_order_acquire); }
+
+    void Add(uint32_t source, uint32_t level, const char *text)
+    {
+        if (text == nullptr || *text == 0) return;
+        seen_.fetch_add(1, std::memory_order_relaxed);
+        SYSTEMTIME st; GetLocalTime(&st);
+        char head[96];
+        const int n = _snprintf_s(head, _TRUNCATE, "%04u-%02u-%02u %02u:%02u:%02u.%03u [%s][%s] ",
+                                  st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond,
+                                  st.wMilliseconds, dlss5::eventlog::SourceName(source),
+                                  dlss5::eventlog::LevelName(level));
+        Pending item;
+        item.source = source;
+        item.level = level;
+        item.key = dlss5::eventlog::KeyOf(source, text);
+        item.prefix = n > 0 ? static_cast<uint32_t>(n) : 0;
+        item.line.reserve(item.prefix + strlen(text) + 2);
+        item.line.append(head, item.prefix);
+        for (const char *p = text; *p != 0; ++p) item.line.push_back(*p == '\n' || *p == '\r' ? ' ' : *p);
+        item.line.push_back('\n');
+        AcquireSRWLockExclusive(&queue_lock_);
+        if (queue_bytes_ + item.line.size() > limits_.queue_cap_bytes) {
+            ReleaseSRWLockExclusive(&queue_lock_);
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        queue_bytes_ += item.line.size();
+        queue_.push_back(std::move(item));
+        ReleaseSRWLockExclusive(&queue_lock_);
+    }
+
+    // Maintenance thread only.
+    void Flush(uint64_t now_ms)
+    {
+        if (!configured_.load(std::memory_order_acquire)) return;
+        std::vector<Pending> batch;
+        AcquireSRWLockExclusive(&queue_lock_);
+        batch.swap(queue_);
+        queue_bytes_ = 0;
+        ReleaseSRWLockExclusive(&queue_lock_);
+
+        EnterCriticalSection(&file_cs_);
+        const bool full = full_.load(std::memory_order_acquire);
+        if (full != file_full_ && file_ != INVALID_HANDLE_VALUE) CloseFile();
+        if (!started_) { started_ = true; window_start_ = now_ms; budget_summary_at_ = now_ms; Retain(); }
+        CheckSpace(now_ms, full);
+
+        const uint64_t dropped = dropped_.exchange(0, std::memory_order_relaxed);
+        if (dropped != 0) {
+            char text[160];
+            _snprintf_s(text, _TRUNCATE, "[event-log] %llu event(s) were discarded because the in-memory queue reached %zu MB",
+                        static_cast<unsigned long long>(dropped), limits_.queue_cap_bytes >> 20);
+            WriteMeta(text, full);
+        }
+        for (Pending &item : batch) {
+            if (full) { WriteEvent(item.line, true); continue; }
+            auto found = keys_.find(item.key);
+            if (found == keys_.end()) {
+                if (keys_.size() >= limits_.key_cap) {
+                    ++other_repeats_; ++suppressed_session_;
+                    continue;
+                }
+                Key key;
+                key.total = 1;
+                keys_.emplace(item.key, std::move(key));
+                WriteEvent(item.line, false);
+                continue;
+            }
+            Key &key = found->second;
+            ++key.total;
+            ++key.repeats;
+            ++suppressed_session_;
+            key.last.assign(item.line, item.prefix, std::string::npos);
+            key.source = item.source;
+            key.level = item.level;
+        }
+        if (!full && now_ms - window_start_ >= limits_.repeat_window_ms) {
+            WriteRepeats(now_ms);
+            window_start_ = now_ms;
+        }
+        if (!full && budget_hit_ && now_ms - budget_summary_at_ >= limits_.budget_summary_ms) {
+            budget_summary_at_ = now_ms;
+            char text[200];
+            _snprintf_s(text, _TRUNCATE, "[event-log] bounded session budget reached; %llu further event(s) counted, not written",
+                        static_cast<unsigned long long>(over_budget_));
+            WriteRaw(text, true);
+        }
+        LeaveCriticalSection(&file_cs_);
+    }
+
+    // Crash path: no blocking lock, best effort. Writes the queued lines raw and
+    // then `text`, so the crash block follows whatever led up to it.
+    void CrashWrite(const char *text)
+    {
+        if (!configured_.load(std::memory_order_acquire)) return;
+        if (!TryEnterCriticalSection(&file_cs_)) { CrashFallback(text); return; }
+        if (file_ == INVALID_HANDLE_VALUE) OpenFile(full_.load(std::memory_order_acquire));
+        if (TryAcquireSRWLockExclusive(&queue_lock_)) {
+            for (const Pending &item : queue_) Append(item.line.data(), item.line.size());
+            queue_.clear();
+            queue_bytes_ = 0;
+            ReleaseSRWLockExclusive(&queue_lock_);
+        }
+        if (text != nullptr) {
+            SYSTEMTIME st; GetLocalTime(&st);
+            char line[1200];
+            const int n = _snprintf_s(line, _TRUNCATE, "%04u-%02u-%02u %02u:%02u:%02u.%03u [bridge][error] %s\n",
+                                      st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond,
+                                      st.wMilliseconds, text);
+            if (n > 0) Append(line, static_cast<size_t>(n));
+        }
+        LeaveCriticalSection(&file_cs_);
+    }
+
+    struct Stats {
+        uint64_t seen, written_session, suppressed_session, folder_bytes;
+        bool full, paused, budget_hit;
+        wchar_t file[MAX_PATH];
+    };
+    Stats Snapshot()
+    {
+        Stats s{};
+        s.seen = seen_.load(std::memory_order_relaxed);
+        s.full = full_.load(std::memory_order_acquire);
+        if (TryEnterCriticalSection(&file_cs_)) {
+            s.written_session = written_session_;
+            s.suppressed_session = suppressed_session_;
+            s.folder_bytes = folder_bytes_;
+            s.paused = paused_;
+            s.budget_hit = budget_hit_;
+            wcsncpy_s(s.file, path_, _TRUNCATE);
+            last_stats_ = s;
+            LeaveCriticalSection(&file_cs_);
+            return s;
+        }
+        Stats cached = last_stats_;
+        cached.seen = s.seen;
+        cached.full = s.full;
+        return cached;
+    }
+
+    // Recomputes the folder size and applies bounded retention. Cheap enough
+    // for a few-second cadence; Flush also calls it when a bounded part opens.
+    void Rescan()
+    {
+        EnterCriticalSection(&file_cs_);
+        if (configured_.load(std::memory_order_acquire)) Retain();
+        LeaveCriticalSection(&file_cs_);
+    }
+
+    static uint64_t VolumeFree(const wchar_t *dir)
+    {
+        ULARGE_INTEGER available{};
+        if (!GetDiskFreeSpaceExW(dir, &available, nullptr, nullptr)) return UINT64_MAX;
+        return available.QuadPart;
+    }
+
+private:
+    struct Pending {
+        uint32_t source = 0, level = 0, prefix = 0;
+        uint64_t key = 0;
+        std::string line;
+    };
+    struct Key {
+        uint64_t total = 0;
+        uint32_t repeats = 0;
+        uint32_t source = 0, level = 0;
+        std::string last;   // newest occurrence without its timestamp/source prefix, with newline
+    };
+
+    void CheckSpace(uint64_t now_ms, bool full)
+    {
+        const uint32_t cadence = paused_ ? limits_.paused_check_ms : limits_.space_check_ms;
+        if (space_checked_ && now_ms - space_checked_at_ < cadence) return;
+        space_checked_ = true;
+        space_checked_at_ = now_ms;
+        const uint64_t free_bytes = free_space_(dir_);
+        const uint64_t stop = full ? limits_.full_floor_stop : limits_.bounded_floor_stop;
+        const uint64_t resume = full ? limits_.full_floor_resume : limits_.bounded_floor_stop + (256ull << 20);
+        if (!paused_ && free_bytes < stop) {
+            char text[220];
+            _snprintf_s(text, _TRUNCATE, "[event-log] writing paused: %llu MB free on the log volume, below the %llu MB floor; events are counted until space returns",
+                        static_cast<unsigned long long>(free_bytes >> 20), static_cast<unsigned long long>(stop >> 20));
+            WriteRaw(text, true);
+            paused_ = true;
+        } else if (paused_ && free_bytes >= resume) {
+            paused_ = false;
+            char text[200];
+            _snprintf_s(text, _TRUNCATE, "[event-log] writing resumed; %llu event(s) were counted while paused",
+                        static_cast<unsigned long long>(paused_events_));
+            paused_events_ = 0;
+            WriteRaw(text, false);
+        }
+    }
+
+    void WriteEvent(const std::string &line, bool full)
+    {
+        if (paused_) { ++paused_events_; return; }
+        if (!full && budget_hit_) { ++over_budget_; return; }
+        Write(line.data(), line.size(), full);
+    }
+    void WriteMeta(const char *text, bool full)
+    {
+        if (paused_) { ++paused_events_; return; }
+        if (!full && budget_hit_) return;
+        WriteRaw(text, false);
+    }
+    void WriteRepeats(uint64_t now_ms)
+    {
+        const double seconds = static_cast<double>(now_ms - window_start_) / 1000.0;
+        for (auto &entry : keys_) {
+            Key &key = entry.second;
+            if (key.repeats == 0) continue;
+            char head[160];
+            SYSTEMTIME st; GetLocalTime(&st);
+            const int n = _snprintf_s(head, _TRUNCATE, "%04u-%02u-%02u %02u:%02u:%02u.%03u [%s][%s][repeat x%u in %.1fs, total %llu] ",
+                                      st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, st.wMilliseconds,
+                                      dlss5::eventlog::SourceName(key.source), dlss5::eventlog::LevelName(key.level),
+                                      key.repeats, seconds, static_cast<unsigned long long>(key.total));
+            key.repeats = 0;
+            if (n <= 0) continue;
+            std::string line(head, static_cast<size_t>(n));
+            line += key.last;   // the newest occurrence's text, newline included
+            WriteEvent(line, false);
+        }
+        if (other_repeats_ != 0) {
+            char text[200];
+            _snprintf_s(text, _TRUNCATE, "[event-log] %llu event(s) of kinds beyond the %zu tracked kinds were counted, not written",
+                        static_cast<unsigned long long>(other_repeats_), limits_.key_cap);
+            other_repeats_ = 0;
+            WriteMeta(text, false);
+        }
+    }
+    void WriteRaw(const char *text, bool force)
+    {
+        SYSTEMTIME st; GetLocalTime(&st);
+        char line[512];
+        const int n = _snprintf_s(line, _TRUNCATE, "%04u-%02u-%02u %02u:%02u:%02u.%03u [bridge][info] %s\n",
+                                  st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond,
+                                  st.wMilliseconds, text);
+        if (n <= 0) return;
+        if (force) { if (file_ == INVALID_HANDLE_VALUE) OpenFile(full_.load()); Append(line, static_cast<size_t>(n)); return; }
+        Write(line, static_cast<size_t>(n), full_.load());
+    }
+
+    void Write(const char *data, size_t size, bool full)
+    {
+        if (file_ == INVALID_HANDLE_VALUE && !OpenFile(full)) return;
+        const uint64_t part = full ? limits_.full_part : limits_.bounded_part;
+        if (part_bytes_ + size > part && part_bytes_ != 0) {
+            if (!full && part_index_ >= limits_.bounded_parts) {
+                if (!budget_hit_) {
+                    budget_hit_ = true;
+                    char text[200];
+                    _snprintf_s(text, _TRUNCATE, "[event-log] bounded session budget of %llu MB reached; further events are counted and summarised every %u minutes",
+                                static_cast<unsigned long long>((limits_.bounded_part * limits_.bounded_parts) >> 20),
+                                limits_.budget_summary_ms / 60000);
+                    WriteRaw(text, true);
+                }
+                ++over_budget_;
+                return;
+            }
+            CloseFile();
+            ++part_index_;
+            if (!OpenFile(full)) return;
+        }
+        Append(data, size);
+    }
+    void Append(const char *data, size_t size)
+    {
+        if (file_ == INVALID_HANDLE_VALUE || size == 0) return;
+        DWORD done = 0;
+        if (WriteFile(file_, data, static_cast<DWORD>(size), &done, nullptr)) {
+            part_bytes_ += done;
+            written_session_ += done;
+            folder_bytes_ += done;
+        }
+    }
+    bool OpenFile(bool full)
+    {
+        if (dir_[0] == 0) return false;
+        if (part_index_ == 0) part_index_ = 1;
+        if (part_index_ == 1)
+            _snwprintf_s(path_, _TRUNCATE, L"%ls\\dlss5-events-%ls%ls.log", dir_, full ? L"full-" : L"", session_);
+        else
+            _snwprintf_s(path_, _TRUNCATE, L"%ls\\dlss5-events-%ls%ls-p%u.log", dir_, full ? L"full-" : L"", session_, part_index_);
+        file_ = CreateFileW(path_, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr,
+                            OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file_ == INVALID_HANDLE_VALUE) { path_[0] = 0; return false; }
+        LARGE_INTEGER size{};
+        part_bytes_ = GetFileSizeEx(file_, &size) ? static_cast<uint64_t>(size.QuadPart) : 0;
+        file_full_ = full;
+        if (part_bytes_ == 0) {
+            char header[256];
+            const int n = _snprintf_s(header, _TRUNCATE,
+                "# DLSS5 anomaly event log, %s mode, process %lu, part %u. One line per event; "
+                "bounded mode merges repeats into one 'repeat xN' line per anomaly per window.\n",
+                full ? "full" : "bounded", GetCurrentProcessId(), part_index_);
+            if (n > 0) Append(header, static_cast<size_t>(n));
+        }
+        if (!full) Retain();
+        return true;
+    }
+    void CloseFile()
+    {
+        if (file_ != INVALID_HANDLE_VALUE) { CloseHandle(file_); file_ = INVALID_HANDLE_VALUE; }
+        // A mode switch starts a new file family; parts restart at 1.
+        if (file_full_ != full_.load()) part_index_ = 0;
+    }
+    void CrashFallback(const char *text)
+    {
+        if (text == nullptr) return;
+        wchar_t path[MAX_PATH];
+        _snwprintf_s(path, _TRUNCATE, L"%ls\\dlss5-events-crash-%lu.log", dir_, GetCurrentProcessId());
+        HANDLE h = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (h == INVALID_HANDLE_VALUE) return;
+        DWORD done = 0;
+        WriteFile(h, text, static_cast<DWORD>(strlen(text)), &done, nullptr);
+        WriteFile(h, "\n", 1, &done, nullptr);
+        CloseHandle(h);
+    }
+
+    // Bounded retention: only dlss5-events-<date>... files that are not full
+    // mode, not crash fallbacks and not the file being written now.
+    void Retain()
+    {
+        struct Entry { std::wstring path; uint64_t size; FILETIME time; };
+        std::vector<Entry> bounded;
+        uint64_t total_all = 0;
+        wchar_t pattern[MAX_PATH];
+        _snwprintf_s(pattern, _TRUNCATE, L"%ls\\dlss5-events-*.log", dir_);
+        WIN32_FIND_DATAW data{};
+        HANDLE find = FindFirstFileW(pattern, &data);
+        if (find == INVALID_HANDLE_VALUE) { folder_bytes_ = 0; return; }
+        do {
+            if (data.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) continue;
+            const uint64_t size = (static_cast<uint64_t>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+            total_all += size;
+            if (wcsncmp(data.cFileName, L"dlss5-events-full-", 18) == 0 ||
+                wcsncmp(data.cFileName, L"dlss5-events-crash-", 19) == 0) continue;
+            wchar_t full_path[MAX_PATH];
+            _snwprintf_s(full_path, _TRUNCATE, L"%ls\\%ls", dir_, data.cFileName);
+            if (_wcsicmp(full_path, path_) == 0) continue;
+            bounded.push_back({full_path, size, data.ftLastWriteTime});
+        } while (FindNextFileW(find, &data));
+        FindClose(find);
+        std::sort(bounded.begin(), bounded.end(), [](const Entry &a, const Entry &b) {
+            return CompareFileTime(&a.time, &b.time) < 0;
+        });
+        uint64_t bounded_total = 0;
+        for (const Entry &e : bounded) bounded_total += e.size;
+        size_t count = bounded.size();
+        for (const Entry &e : bounded) {
+            if (bounded_total <= limits_.bounded_folder_budget && count < limits_.bounded_keep_files) break;
+            if (DeleteFileW(e.path.c_str())) { bounded_total -= e.size; total_all -= e.size; }
+            --count;
+        }
+        folder_bytes_ = total_all;
+    }
+
+    Limits limits_{};
+    FreeSpaceFn free_space_ = &VolumeFree;
+    wchar_t dir_[MAX_PATH] = {};
+    wchar_t session_[64] = {};
+    wchar_t path_[MAX_PATH] = {};
+    std::atomic<bool> configured_{false}, full_{false};
+    std::atomic<uint64_t> seen_{0}, dropped_{0};
+
+    SRWLOCK queue_lock_ = SRWLOCK_INIT;
+    std::vector<Pending> queue_;
+    size_t queue_bytes_ = 0;
+
+    CRITICAL_SECTION file_cs_;
+    HANDLE file_ = INVALID_HANDLE_VALUE;
+    bool file_full_ = false, started_ = false, paused_ = false, budget_hit_ = false, space_checked_ = false;
+    uint32_t part_index_ = 0;
+    uint64_t part_bytes_ = 0, written_session_ = 0, suppressed_session_ = 0, folder_bytes_ = 0;
+    uint64_t paused_events_ = 0, over_budget_ = 0, other_repeats_ = 0;
+    uint64_t window_start_ = 0, budget_summary_at_ = 0, space_checked_at_ = 0;
+    std::unordered_map<uint64_t, Key> keys_;
+    Stats last_stats_{};
+};
diff --git b/src/fence-deadline-wait.h b/src/fence-deadline-wait.h
new file mode 100644
index 0000000000000000000000000000000000000000..5a96b51dd945534a87470e1d0f4f5e17b54c56f7
--- /dev/null
+++ b/src/fence-deadline-wait.h
@@ -0,0 +1,57 @@
+// D3D12 fence wait whose answer is the fence, not the event.
+//
+// SetEventOnCompletion cannot be cancelled. A wait that timed out leaves its
+// registration live, and when the GPU later reaches that value the auto-reset
+// event is signalled with nobody waiting. A wait that trusts the event then
+// returns at once for a value the GPU has not reached. Here every wake is only a
+// prompt to read the fence again, and one deadline set on entry bounds the
+// whole call: a stale wake can neither shorten the wait to zero nor restart the
+// budget the caller gave.
+//
+// Requires Log() to be declared before inclusion.
+#pragma once
+
+static bool FenceDeadlineWait(ID3D12Fence *fence, HANDLE ev, UINT64 value, DWORD wait_ms,
+                              const char *who)
+{
+    const ULONGLONG begin = GetTickCount64();
+    const ULONGLONG deadline = begin + wait_ms;
+    const UINT64 before = fence->GetCompletedValue();
+    const auto fail = [&](const char *stage, HRESULT hr, DWORD wr, UINT64 after) {
+        const DWORD saved_error = GetLastError();
+        Log("[wait-cause] %s stage=%s tid=%lu target=%llu before=%llu after=%llu budget_ms=%lu "
+            "elapsed_ms=%llu hr=0x%08lX wait=0x%08lX last_error=%lu.",
+            who, stage, GetCurrentThreadId(), value, before, after, wait_ms,
+            GetTickCount64() - begin, static_cast<unsigned long>(hr), wr, saved_error);
+        SetLastError(saved_error);
+        return false;
+    };
+    if (before == UINT64_MAX) return fail("removed-before", S_OK, WAIT_FAILED, before);
+    if (before >= value) return true;
+    const HRESULT event_hr = fence->SetEventOnCompletion(value, ev);
+    if (FAILED(event_hr)) return fail("set-event", event_hr, WAIT_FAILED, before);
+    unsigned stale_wakes = 0;
+    DWORD wr = WAIT_OBJECT_0;
+    for (;;) {
+        const UINT64 after = fence->GetCompletedValue();
+        if (after == UINT64_MAX) return fail("removed-after", S_OK, wr, after);
+        if (after >= value) {
+            if (stale_wakes != 0) {
+                const DWORD saved_error = GetLastError();
+                Log("[wait-cause] %s recovered tid=%lu target=%llu after=%llu stale_wakes=%u "
+                    "budget_ms=%lu elapsed_ms=%llu.", who, GetCurrentThreadId(), value, after,
+                    stale_wakes, wait_ms, GetTickCount64() - begin);
+                SetLastError(saved_error);
+            }
+            return true;
+        }
+        const ULONGLONG now = GetTickCount64();
+        if (now >= deadline) return fail("deadline", S_OK, WAIT_TIMEOUT, after);
+        wr = WaitForSingleObject(ev, static_cast<DWORD>(deadline - now));
+        if (wr != WAIT_OBJECT_0 && wr != WAIT_TIMEOUT) return fail("wait-result", S_OK, wr, after);
+        if (wr == WAIT_OBJECT_0) {
+            const UINT64 awake = fence->GetCompletedValue();
+            if (awake != UINT64_MAX && awake < value) ++stale_wakes;
+        }
+    }
+}
diff --git b/src/fg-composite-shader.h b/src/fg-composite-shader.h
new file mode 100644
index 0000000000000000000000000000000000000000..4aa4d5b01f35e5cd549630c91c1afe04255892e5
--- /dev/null
+++ b/src/fg-composite-shader.h
@@ -0,0 +1,24 @@
+#pragma once
+
+// UI-preserving recomposition of a neural-rendered HUD-less frame.
+//   t0 = original HUD-less, t1 = NR(HUD-less), u0 = backbuffer in / composite out.
+// The NR delta is applied fully where the UI did not touch the pixel and fades
+// out with the UI's contribution, so translucent panels keep a soft, continuous
+// scene under them instead of an un-enhanced cut-out; opaque UI stays untouched.
+static const char kFgCompositeShader[] =
+    "Texture2D<float4>   hudless : register(t0);\n"
+    "Texture2D<float4>   nr      : register(t1);\n"
+    "RWTexture2D<float4> back    : register(u0);\n"
+    "static const float kUiFade = 0.25;\n"
+    "[numthreads(8,8,1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint w, h; back.GetDimensions(w, h);\n"
+    "    if (id.x >= w || id.y >= h) return;\n"
+    "    float4 b = back[id.xy];\n"
+    "    float3 s = hudless[id.xy].rgb;\n"
+    "    float3 d = abs(b.rgb - s);\n"
+    "    float ui = max(d.r, max(d.g, d.b));\n"
+    "    float weight = saturate(1.0 - ui / kUiFade);\n"
+    "    back[id.xy] = float4(saturate(b.rgb + (nr[id.xy].rgb - s) * weight), b.a);\n"
+    "}\n";
diff --git b/src/fg-guide-compute.inc b/src/fg-guide-compute.inc
new file mode 100644
index 0000000000000000000000000000000000000000..bac72e9490fef0c4f436fdbe9d41697bf7705622
--- /dev/null
+++ b/src/fg-guide-compute.inc
@@ -0,0 +1,200 @@
+// GPU-only nearest transport for compute-capable FG queues. Source images and
+// imported D3D12 images remain transfer-only; raw 32-bit texels pass through two
+// device-local storage buffers on the SAME queue and within the same copy batch.
+#include "fg-guide-nearest-spv.h"
+
+struct FgcShaderInfo { uint32_t type; const void *next; uint32_t flags; size_t bytes; const uint32_t *code; };
+struct FgcBinding { uint32_t binding, type, count, stages; const SVkHandle *samplers; };
+struct FgcSetLayoutInfo { uint32_t type; const void *next; uint32_t flags, count; const FgcBinding *bindings; };
+struct FgcPushRange { uint32_t stages, offset, size; };
+struct FgcLayoutInfo { uint32_t type; const void *next; uint32_t flags, count; const SVkHandle *sets; uint32_t push_count; const FgcPushRange *push; };
+struct FgcStageInfo { uint32_t type; const void *next; uint32_t flags, stage; SVkHandle module; const char *name; const void *specialization; };
+struct FgcPipelineInfo { uint32_t type; const void *next; uint32_t flags; FgcStageInfo stage; SVkHandle layout, base; int32_t base_index; };
+struct FgcPoolSize { uint32_t type, count; };
+struct FgcPoolInfo { uint32_t type; const void *next; uint32_t flags, max_sets, count; const FgcPoolSize *sizes; };
+struct FgcSetInfo { uint32_t type; const void *next; SVkHandle pool; uint32_t count; const SVkHandle *layouts; };
+struct FgcBufferInfo { SVkHandle buffer; uint64_t offset, range; };
+struct FgcWrite { uint32_t type; const void *next; SVkHandle set; uint32_t binding, element, count, descriptor_type; const void *images; const FgcBufferInfo *buffers; const SVkHandle *views; };
+static_assert(sizeof(FgcShaderInfo) == 40 && sizeof(FgcBinding) == 24 && sizeof(FgcSetLayoutInfo) == 32, "Vulkan shader/set ABI");
+static_assert(sizeof(FgcLayoutInfo) == 48 && sizeof(FgcStageInfo) == 48 && sizeof(FgcPipelineInfo) == 96, "Vulkan compute pipeline ABI");
+static_assert(sizeof(FgcPoolInfo) == 40 && sizeof(FgcSetInfo) == 40 && sizeof(FgcWrite) == 64, "Vulkan descriptor ABI");
+
+using FgcDestroy = void (*)(SVkDevice, SVkHandle, const void *);
+using FgcCreateShader = uint32_t (*)(SVkDevice, const FgcShaderInfo *, const void *, SVkHandle *);
+using FgcCreateSetLayout = uint32_t (*)(SVkDevice, const FgcSetLayoutInfo *, const void *, SVkHandle *);
+using FgcCreateLayout = uint32_t (*)(SVkDevice, const FgcLayoutInfo *, const void *, SVkHandle *);
+using FgcCreatePipeline = uint32_t (*)(SVkDevice, SVkHandle, uint32_t, const FgcPipelineInfo *, const void *, SVkHandle *);
+using FgcCreatePool = uint32_t (*)(SVkDevice, const FgcPoolInfo *, const void *, SVkHandle *);
+using FgcAllocateSets = uint32_t (*)(SVkDevice, const FgcSetInfo *, SVkHandle *);
+using FgcUpdateSets = void (*)(SVkDevice, uint32_t, const FgcWrite *, uint32_t, const void *);
+using FgcBindPipeline = void (*)(SVkCommandBuffer, uint32_t, SVkHandle);
+using FgcBindSets = void (*)(SVkCommandBuffer, uint32_t, SVkHandle, uint32_t, uint32_t, const SVkHandle *, uint32_t, const uint32_t *);
+using FgcPush = void (*)(SVkCommandBuffer, SVkHandle, uint32_t, uint32_t, uint32_t, const void *);
+using FgcDispatch = void (*)(SVkCommandBuffer, uint32_t, uint32_t, uint32_t);
+
+struct FgGuideComputeState {
+    SVkDevice device;
+    SVkHandle buffers[2], memory[2], module, set_layout, layout, pipeline, pool, set;
+    uint64_t capacity, retry_after;
+    bool ready, growth_pending;
+    PFN_SVkDestroyBuffer DestroyBuffer;
+    PFN_SVkFreeMemory FreeMemory;
+    FgcDestroy DestroyShader, DestroySetLayout, DestroyLayout, DestroyPipeline, DestroyPool;
+    FgcBindPipeline BindPipeline;
+    FgcBindSets BindSets;
+    FgcPush Push;
+    FgcDispatch Dispatch;
+};
+static FgGuideComputeState g_fgc;
+
+// Either no command has used a failed partial build, or the caller has proved
+// both queues drained. Never call this just because the next frame wants more.
+static void FgGuideComputeRelease()
+{
+    FgGuideComputeState &c = g_fgc;
+    if (c.device != nullptr) {
+        if (c.pool && c.DestroyPool) c.DestroyPool(c.device, c.pool, nullptr);
+        if (c.pipeline && c.DestroyPipeline) c.DestroyPipeline(c.device, c.pipeline, nullptr);
+        if (c.layout && c.DestroyLayout) c.DestroyLayout(c.device, c.layout, nullptr);
+        if (c.set_layout && c.DestroySetLayout) c.DestroySetLayout(c.device, c.set_layout, nullptr);
+        if (c.module && c.DestroyShader) c.DestroyShader(c.device, c.module, nullptr);
+        for (unsigned i = 0; i < 2; ++i) {
+            if (c.buffers[i] && c.DestroyBuffer) c.DestroyBuffer(c.device, c.buffers[i], nullptr);
+            if (c.memory[i] && c.FreeMemory) c.FreeMemory(c.device, c.memory[i], nullptr);
+        }
+    }
+    c = {};
+}
+
+static bool FgGuideComputeFailure(const char *step, uint32_t result)
+{
+    Log("[fg-guides] GPU nearest setup failed at %s (VkResult=0x%08X); no CPU image conversion is used.", step, result);
+    FgGuideComputeRelease();
+    g_fgc.retry_after = GetTickCount64() + 2000;
+    return false;
+}
+
+static bool FgGuideComputePrepare(uint64_t bytes, uint32_t local_types, uint64_t queue_mask)
+{
+    FgGuideComputeState &c = g_fgc;
+    if (c.ready) {
+        c.growth_pending = c.device == g_svk.dev && bytes > c.capacity;
+        return c.device == g_svk.dev && bytes <= c.capacity;
+    }
+    if (bytes == 0 || bytes > 128ull * 1024 * 1024 || local_types == 0 || queue_mask == 0 ||
+        GetTickCount64() < c.retry_after || g_svk.lib == nullptr || g_svk.dev == nullptr) return false;
+    auto get = reinterpret_cast<PFN_SVkGetDeviceProcAddr>(GetProcAddress(g_svk.lib, "vkGetDeviceProcAddr"));
+    if (get == nullptr) return FgGuideComputeFailure("vkGetDeviceProcAddr", 0xFFFFFFFFu);
+    c.device = g_svk.dev;
+    c.DestroyBuffer = g_svk.DestroyBuffer;
+    c.FreeMemory = g_svk.FreeMemory;
+    auto create_shader = reinterpret_cast<FgcCreateShader>(get(c.device, "vkCreateShaderModule"));
+    auto create_set_layout = reinterpret_cast<FgcCreateSetLayout>(get(c.device, "vkCreateDescriptorSetLayout"));
+    auto create_layout = reinterpret_cast<FgcCreateLayout>(get(c.device, "vkCreatePipelineLayout"));
+    auto create_pipeline = reinterpret_cast<FgcCreatePipeline>(get(c.device, "vkCreateComputePipelines"));
+    auto create_pool = reinterpret_cast<FgcCreatePool>(get(c.device, "vkCreateDescriptorPool"));
+    auto allocate_sets = reinterpret_cast<FgcAllocateSets>(get(c.device, "vkAllocateDescriptorSets"));
+    auto update_sets = reinterpret_cast<FgcUpdateSets>(get(c.device, "vkUpdateDescriptorSets"));
+    c.DestroyShader = reinterpret_cast<FgcDestroy>(get(c.device, "vkDestroyShaderModule"));
+    c.DestroySetLayout = reinterpret_cast<FgcDestroy>(get(c.device, "vkDestroyDescriptorSetLayout"));
+    c.DestroyLayout = reinterpret_cast<FgcDestroy>(get(c.device, "vkDestroyPipelineLayout"));
+    c.DestroyPipeline = reinterpret_cast<FgcDestroy>(get(c.device, "vkDestroyPipeline"));
+    c.DestroyPool = reinterpret_cast<FgcDestroy>(get(c.device, "vkDestroyDescriptorPool"));
+    c.BindPipeline = reinterpret_cast<FgcBindPipeline>(get(c.device, "vkCmdBindPipeline"));
+    c.BindSets = reinterpret_cast<FgcBindSets>(get(c.device, "vkCmdBindDescriptorSets"));
+    c.Push = reinterpret_cast<FgcPush>(get(c.device, "vkCmdPushConstants"));
+    c.Dispatch = reinterpret_cast<FgcDispatch>(get(c.device, "vkCmdDispatch"));
+    if (!create_shader || !create_set_layout || !create_layout || !create_pipeline || !create_pool || !allocate_sets || !update_sets ||
+        !c.DestroyShader || !c.DestroySetLayout || !c.DestroyLayout || !c.DestroyPipeline || !c.DestroyPool ||
+        !c.BindPipeline || !c.BindSets || !c.Push || !c.Dispatch || !c.DestroyBuffer || !c.FreeMemory ||
+        !g_svk.CreateBuffer || !g_svk.GetBufferMemoryRequirements || !g_svk.AllocateMemory || !g_svk.BindBufferMemory ||
+        !g_svk.CmdCopyImageToBuffer || !g_svk.CmdCopyBufferToImage || !g_svk.CmdPipelineBarrier)
+        return FgGuideComputeFailure("required Vulkan compute/transfer entry point", 0xFFFFFFFFu);
+
+    uint32_t families[64] = {}, family_count = 0;
+    for (uint32_t i = 0; i < 64; ++i)
+        if ((queue_mask & (uint64_t(1) << i)) != 0) families[family_count++] = i;
+    for (unsigned i = 0; i < 2; ++i) {
+        SVkBufferCreateInfo info = {};
+        info.sType = 12; info.size = bytes; info.usage = 0x1u | 0x2u | 0x20u; // transfer src/dst, storage
+        if (family_count > 1) { info.sharingMode = 1; info.queueFamilyIndexCount = family_count; info.pQueueFamilyIndices = families; }
+        uint32_t result = g_svk.CreateBuffer(c.device, &info, nullptr, &c.buffers[i]);
+        if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreateBuffer", result);
+        SVkMemoryRequirements required = {};
+        g_svk.GetBufferMemoryRequirements(c.device, c.buffers[i], &required);
+        const uint32_t allowed = required.memoryTypeBits & local_types;
+        if (allowed == 0) return FgGuideComputeFailure("device-local buffer memory type", 0xFFFFFFFFu);
+        uint32_t type = 0; while ((allowed & (1u << type)) == 0) ++type;
+        SVkMemoryAllocateInfo allocate = {};
+        allocate.sType = 5; allocate.allocationSize = required.size; allocate.memoryTypeIndex = type;
+        result = g_svk.AllocateMemory(c.device, &allocate, nullptr, &c.memory[i]);
+        if (result != kSVkSuccess) return FgGuideComputeFailure("vkAllocateMemory", result);
+        result = g_svk.BindBufferMemory(c.device, c.buffers[i], c.memory[i], 0);
+        if (result != kSVkSuccess) return FgGuideComputeFailure("vkBindBufferMemory", result);
+    }
+    FgcShaderInfo shader = {16, nullptr, 0, sizeof(kFgGuideNearestSpv), kFgGuideNearestSpv};
+    uint32_t result = create_shader(c.device, &shader, nullptr, &c.module);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreateShaderModule", result);
+    FgcBinding bindings[2] = {{0, 7, 1, 0x20, nullptr}, {1, 7, 1, 0x20, nullptr}};
+    FgcSetLayoutInfo set_info = {32, nullptr, 0, 2, bindings};
+    result = create_set_layout(c.device, &set_info, nullptr, &c.set_layout);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreateDescriptorSetLayout", result);
+    FgcPushRange push = {0x20, 0, 16};
+    FgcLayoutInfo layout = {30, nullptr, 0, 1, &c.set_layout, 1, &push};
+    result = create_layout(c.device, &layout, nullptr, &c.layout);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreatePipelineLayout", result);
+    FgcPipelineInfo pipeline = {};
+    pipeline.type = 29; pipeline.stage = {18, nullptr, 0, 0x20, c.module, "main", nullptr};
+    pipeline.layout = c.layout; pipeline.base_index = -1;
+    result = create_pipeline(c.device, 0, 1, &pipeline, nullptr, &c.pipeline);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreateComputePipelines", result);
+    FgcPoolSize size = {7, 2};
+    FgcPoolInfo pool = {33, nullptr, 0, 1, 1, &size};
+    result = create_pool(c.device, &pool, nullptr, &c.pool);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkCreateDescriptorPool", result);
+    FgcSetInfo set = {34, nullptr, c.pool, 1, &c.set_layout};
+    result = allocate_sets(c.device, &set, &c.set);
+    if (result != kSVkSuccess) return FgGuideComputeFailure("vkAllocateDescriptorSets", result);
+    FgcBufferInfo buffers[2] = {{c.buffers[0], 0, bytes}, {c.buffers[1], 0, bytes}};
+    FgcWrite writes[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+        writes[i].type = 35; writes[i].set = c.set; writes[i].binding = i;
+        writes[i].count = 1; writes[i].descriptor_type = 7; writes[i].buffers = &buffers[i];
+    }
+    update_sets(c.device, 2, writes, 0, nullptr);
+    c.capacity = bytes; c.ready = true;
+    Log("[fg-guides] GPU nearest ready: two device-local buffers of %llu bytes, integer raw-texel shader, concurrent queue-families=0x%llX.", bytes, queue_mask);
+    return true;
+}
+
+static void FgGuideComputeBarrier(SVkCommandBuffer cb, uint32_t src_stage, uint32_t src_access,
+                                 uint32_t dst_stage, uint32_t dst_access)
+{
+    SVkMemoryBarrier barrier = {};
+    barrier.sType = kSVkStMemoryBarrier;
+    barrier.srcAccessMask = src_access; barrier.dstAccessMask = dst_access;
+    g_svk.CmdPipelineBarrier(cb, src_stage, dst_stage, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+}
+
+static void FgGuideComputeRecord(SVkCommandBuffer cb, const FgGuideImage &g, SVkHandle dst, unsigned w, unsigned h)
+{
+    FgGuideComputeState &c = g_fgc;
+    // Preparation proves capacity and all core commands before recording starts.
+    // Every reuse is ordered on this batch; the existing relay completion fence
+    // also orders batches when the game switches between graphics/compute queues.
+    FgGuideComputeBarrier(cb, kSVkStageAllCommands, kSVkAccessMemoryRead | kSVkAccessMemoryWrite, 0x1000, 0x1000);
+    SVkBufferImageCopy copy = {};
+    copy.imageSubresource = {kSVkAspectColor, 0, 0, 1};
+    copy.imageOffset = {static_cast<int32_t>(g.x), static_cast<int32_t>(g.y), 0};
+    copy.imageExtent = {g.w, g.h, 1};
+    g_svk.CmdCopyImageToBuffer(cb, g.resource.image, kSVkLayoutTransferSrc, c.buffers[0], 1, &copy);
+    FgGuideComputeBarrier(cb, kSVkStageAllCommands, kSVkAccessMemoryRead | kSVkAccessMemoryWrite, 0x800, 0x20 | 0x40);
+    c.BindPipeline(cb, 1, c.pipeline);
+    c.BindSets(cb, 1, c.layout, 0, 1, &c.set, 0, nullptr);
+    const uint32_t dims[4] = {g.w, g.h, w, h};
+    c.Push(cb, c.layout, 0x20, 0, sizeof(dims), dims);
+    c.Dispatch(cb, (w + 15) / 16, (h + 7) / 8, 1);
+    FgGuideComputeBarrier(cb, 0x800, 0x40, 0x1000, 0x800);
+    copy.imageOffset = {0, 0, 0}; copy.imageExtent = {w, h, 1};
+    g_svk.CmdCopyBufferToImage(cb, c.buffers[1], dst, kSVkLayoutGeneral, 1, &copy);
+}
diff --git b/src/fg-guide-math.h b/src/fg-guide-math.h
new file mode 100644
index 0000000000000000000000000000000000000000..661cc04160898e726fa2ebe77aa49a033b503925
--- /dev/null
+++ b/src/fg-guide-math.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <cstdint>
+#include <climits>
+#include <cfloat>
+#include <cmath>
+
+// The NGX effective rectangle must fit the image, including an explicit zero
+// size (which is a transition, not an implicit whole-image declaration).
+inline bool FgGuideRectValid(uint32_t texture_w, uint32_t texture_h,
+                             uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    return w != 0 && h != 0 && texture_w <= INT_MAX && texture_h <= INT_MAX &&
+        x <= texture_w && y <= texture_h && w <= texture_w - x && h <= texture_h - y;
+}
+
+// Streamline supplies MV * scale in pixels of the ORIGINAL effective MV grid.
+// Nearest changes the grid but not sampled vector values. Preserve normalized
+// displacement; Generic applies its own NR work-resolution mapping afterwards.
+inline bool FgGuideScale(float input, uint32_t original_grid, uint32_t output_grid, float *result)
+{
+    if (!std::isfinite(input) || original_grid == 0 || output_grid == 0) return false;
+    const double value = static_cast<double>(input) * output_grid / original_grid;
+    if (value > FLT_MAX || value < -FLT_MAX) return false;
+    *result = static_cast<float>(value);
+    return std::isfinite(*result);
+}
+
+// Integer nearest uses (2*x+1)*source_width. Bound each axis so every product
+// fits uint32, and stay within Vulkan's guaranteed storage-buffer range.
+inline bool FgGuideBufferBytes(uint32_t w, uint32_t h, uint64_t *bytes)
+{
+    if (w == 0 || h == 0 || w > 32768 || h > 32768) return false;
+    *bytes = static_cast<uint64_t>(w) * h * 4;
+    return *bytes <= 128ull * 1024 * 1024;
+}
