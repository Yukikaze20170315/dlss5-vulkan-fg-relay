diff --git b/src/fg-guide-nearest.comp b/src/fg-guide-nearest.comp
new file mode 100644
index 0000000000000000000000000000000000000000..70361aa7daac66e9eed3a93bd585fb1da6f4832a
--- /dev/null
+++ b/src/fg-guide-nearest.comp
@@ -0,0 +1,14 @@
+#version 450
+layout(local_size_x=16, local_size_y=8, local_size_z=1) in;
+layout(set=0,binding=0,std430) readonly buffer Source { uint words[]; } src;
+layout(set=0,binding=1,std430) writeonly buffer Destination { uint words[]; } dst;
+layout(push_constant) uniform Dimensions { uint src_w; uint src_h; uint dst_w; uint dst_h; } dims;
+void main() {
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x >= dims.dst_w || p.y >= dims.dst_h) return;
+    // Host caps each axis at 32768 and each buffer at 128 MiB. These products
+    // fit uint32 and preserve the source's raw float/half bit patterns.
+    uint sx = min(((2u*p.x+1u)*dims.src_w)/(2u*dims.dst_w), dims.src_w-1u);
+    uint sy = min(((2u*p.y+1u)*dims.src_h)/(2u*dims.dst_h), dims.src_h-1u);
+    dst.words[p.y*dims.dst_w+p.x] = src.words[sy*dims.src_w+sx];
+}
diff --git b/src/fg-guides.inc b/src/fg-guides.inc
new file mode 100644
index 0000000000000000000000000000000000000000..6aab551e2b6d6a3b7cbd8b8eee3bf6fe5fb7e604
--- /dev/null
+++ b/src/fg-guides.inc
@@ -0,0 +1,285 @@
+// Frame-generation guides are defined on their own grids. A DLSS quality
+// change can resize those grids without changing the final colour image.
+// Keep the private carrier fixed-size and fill every guide pixel on every
+// accepted frame; never reuse a previous frame's guide after a shape change.
+#include "fg-guide-math.h"
+#include "fg-history-policy.h"
+static volatile LONG64 g_fg_source_tick, g_fg_source_reset_tick;
+struct FgGuideImage {
+    VkmRes resource;
+    unsigned x, y, w, h;
+};
+struct FgGuideContract {
+    FgGuideImage depth, mv;
+    unsigned out_w, out_h, inverted, jittered, reset;
+    float scale_x, scale_y, carrier_scale_x, carrier_scale_y, jitter_x, jitter_y;
+};
+struct FgGuideFormatProperties { uint32_t linear, optimal, buffer; };
+struct FgGuideQueueProperties { uint32_t flags, count, timestamp; SVkExtent3D granularity; };
+struct FgGuideMemoryProperties {
+    uint32_t type_count;
+    struct { uint32_t flags, heap; } types[32];
+    uint32_t heap_count;
+    struct { uint64_t size; uint32_t flags; } heaps[16];
+};
+static_assert(sizeof(FgGuideMemoryProperties) == 520, "VkPhysicalDeviceMemoryProperties ABI");
+struct FgGuideDevice {
+    void *device;
+    bool blit_formats;
+    uint64_t graphics_families;
+    uint64_t compute_families;
+    uint32_t local_memory_types;
+};
+static std::unordered_map<void *, FgGuideDevice> g_fg_guide_devices;
+static std::mutex g_fg_guide_device_lock;
+static bool FgGuideComputePrepare(uint64_t bytes, uint32_t local_types, uint64_t queue_families);
+static void FgGuideComputeRecord(SVkCommandBuffer cb, const FgGuideImage &g, SVkHandle dst, unsigned w, unsigned h);
+static uint32_t FgGuideSharingFamilies(void *device, uint32_t *families, uint32_t capacity)
+{
+    std::lock_guard<std::mutex> lock(g_fg_guide_device_lock);
+    const auto found = g_fg_guide_devices.find(device);
+    if (found == g_fg_guide_devices.end()) return 0;
+    const uint64_t mask = found->second.graphics_families | found->second.compute_families;
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < 64; ++i)
+        if ((mask & (uint64_t(1) << i)) != 0) {
+            if (count >= capacity) return 0;
+            families[count++] = i;
+        }
+    return count;
+}
+static void FgGuideForgetDevice(void *device)
+{
+    std::lock_guard<std::mutex> lock(g_fg_guide_device_lock);
+    g_fg_guide_devices.erase(device);
+}
+
+// The device-creation hook is the only place the bridge knows the physical
+// device. Resolve format/queue capability here, before accepting any blit.
+using PFN_FgGuideGipa = void *(*)(void *, const char *);
+static void FgGuideNoteDevice(void *instance, void *physical, void *device, PFN_FgGuideGipa layer_gipa)
+{
+    using GetFormats = void (*)(void *, uint32_t, FgGuideFormatProperties *);
+    using GetQueues = void (*)(void *, uint32_t *, FgGuideQueueProperties *);
+    using GetMemory = void (*)(void *, FgGuideMemoryProperties *);
+    // The layer's physical handle is not the loader's top-level wrapper. Only
+    // resolve queries through that SAME layer and its captured real instance;
+    // a vulkan-1.dll global trampoline rejects this domain and can fail-fast.
+    auto get_formats = instance != nullptr && layer_gipa != nullptr
+        ? reinterpret_cast<GetFormats>(layer_gipa(instance, "vkGetPhysicalDeviceFormatProperties")) : nullptr;
+    auto get_queues = instance != nullptr && layer_gipa != nullptr
+        ? reinterpret_cast<GetQueues>(layer_gipa(instance, "vkGetPhysicalDeviceQueueFamilyProperties")) : nullptr;
+    auto get_memory = instance != nullptr && layer_gipa != nullptr
+        ? reinterpret_cast<GetMemory>(layer_gipa(instance, "vkGetPhysicalDeviceMemoryProperties")) : nullptr;
+    FgGuideDevice record = {};
+    record.device = device;
+    if (get_formats != nullptr && get_queues != nullptr && physical != nullptr) {
+        FgGuideFormatProperties depth = {}, mv = {};
+        get_formats(physical, 100u, &depth); // VK_FORMAT_R32_SFLOAT
+        get_formats(physical, 83u, &mv);     // VK_FORMAT_R16G16_SFLOAT
+        const uint32_t blit = 0x400u | 0x800u; // BLIT_SRC_BIT | BLIT_DST_BIT
+        record.blit_formats = (depth.optimal & blit) == blit && (mv.optimal & blit) == blit;
+        FgGuideQueueProperties queues[64] = {};
+        uint32_t count = _countof(queues);
+        get_queues(physical, &count, queues);
+        for (uint32_t i = 0; i < count && i < _countof(queues); ++i) {
+            if ((queues[i].flags & 1u) != 0) record.graphics_families |= uint64_t(1) << i;
+            if ((queues[i].flags & 2u) != 0) record.compute_families |= uint64_t(1) << i;
+        }
+        if (get_memory != nullptr) {
+            FgGuideMemoryProperties memory = {};
+            get_memory(physical, &memory);
+            for (uint32_t i = 0; i < memory.type_count && i < 32; ++i)
+                if ((memory.types[i].flags & 1u) != 0) record.local_memory_types |= 1u << i;
+        }
+    }
+    Log("[fg-guides] Vulkan capability device=%p instance=%p physical=%p queries=%u blit-formats=%u graphics-families=0x%llX. compute-families=0x%llX local-types=0x%X.",
+        device, instance, physical, get_formats != nullptr && get_queues != nullptr ? 1u : 0u,
+        record.blit_formats ? 1u : 0u, record.graphics_families, record.compute_families, record.local_memory_types);
+    std::lock_guard<std::mutex> lock(g_fg_guide_device_lock);
+    g_fg_guide_devices[device] = record;
+}
+
+static bool FgGuideReadImage(const NVSDK_NGX_Parameter *p, const char *key,
+                             const char *base_x, const char *base_y,
+                             const char *width, const char *height,
+                             uint32_t format, FgGuideImage *out, const char **why)
+{
+    if (!VkmGetRes(p, key, &out->resource, why)) return false;
+    const VkmRes &r = out->resource;
+    if (r.fmt != format || r.aspect != kSVkAspectColor || r.mip != 0 || r.layer != 0) {
+        *why = "guide format/aspect/mip/layer is unsupported"; return false;
+    }
+    out->x = out->y = 0;
+    out->w = r.w; out->h = r.h;
+    FgInputReadU(p, base_x, &out->x); FgInputReadU(p, base_y, &out->y);
+    // Explicit zero sizes are not whole-image declarations. Treat them as a
+    // temporarily invalid contract, so a transition cannot read stale pixels.
+    FgInputReadU(p, width, &out->w); FgInputReadU(p, height, &out->h);
+    if (!FgGuideRectValid(r.w, r.h, out->x, out->y, out->w, out->h)) {
+        *why = "guide subrect is empty or outside its texture"; return false;
+    }
+    return true;
+}
+
+static bool FgGuideRead(const NVSDK_NGX_Parameter *p, const VkmRes &back,
+                        FgGuideContract *out, const char **why)
+{
+    *out = {};
+    out->out_w = back.w; out->out_h = back.h;
+    if (back.w == 0 || back.h == 0 || back.w > INT_MAX || back.h > INT_MAX) {
+        *why = "output dimensions are invalid"; return false;
+    }
+    if (!FgGuideReadImage(p, "DLSSG.Depth", "DLSSG.DepthSubrectBaseX", "DLSSG.DepthSubrectBaseY",
+                         "DLSSG.DepthSubrectWidth", "DLSSG.DepthSubrectHeight", 100u, &out->depth, why) ||
+        !FgGuideReadImage(p, "DLSSG.MVecs", "DLSSG.MVecsSubrectBaseX", "DLSSG.MVecsSubrectBaseY",
+                         "DLSSG.MVecsSubrectWidth", "DLSSG.MVecsSubrectHeight", 83u, &out->mv, why)) return false;
+    FgInputReadU(p, "DLSSG.DepthInverted", &out->inverted);
+    FgInputReadU(p, "DLSSG.MvecJittered", &out->jittered);
+    FgInputReadU(p, "DLSSG.Reset", &out->reset);
+    out->scale_x = out->scale_y = 1.0f;
+    p->Get("DLSSG.MvecScaleX", &out->scale_x); p->Get("DLSSG.MvecScaleY", &out->scale_y);
+    p->Get("DLSSG.JitterOffsetX", &out->jitter_x); p->Get("DLSSG.JitterOffsetY", &out->jitter_y);
+    if (!FgGuideScale(out->scale_x, out->mv.w, out->out_w, &out->carrier_scale_x) ||
+        !FgGuideScale(out->scale_y, out->mv.h, out->out_h, &out->carrier_scale_y) ||
+        !std::isfinite(out->jitter_x) || !std::isfinite(out->jitter_y)) {
+        *why = "motion scale or jitter is not finite"; return false;
+    }
+    if (out->jittered != 0) {
+        *why = "jittered motion vectors require an explicit de-jitter conversion"; return false;
+    }
+    return true;
+}
+
+static bool FgGuideNeedsBlit(const FgGuideImage &image, unsigned w, unsigned h)
+{
+    return image.w != w || image.h != h;
+}
+static bool FgGuideCanTransport(const FgGuideContract &g, uint32_t family)
+{
+    if (!FgGuideNeedsBlit(g.depth, g.out_w, g.out_h) && !FgGuideNeedsBlit(g.mv, g.out_w, g.out_h)) return true;
+    bool ok = false;
+    {
+        std::lock_guard<std::mutex> lock(g_fg_guide_device_lock);
+        const auto found = g_fg_guide_devices.find(g_svk.dev);
+        if (found != g_fg_guide_devices.end()) {
+            const FgGuideDevice &d = found->second;
+            uint64_t bytes = 0;
+            ok = family < 64 && (d.compute_families & (uint64_t(1) << family)) != 0 && d.local_memory_types != 0 &&
+                FgGuideBufferBytes(g.out_w, g.out_h, &bytes) && FgGuideBufferBytes(g.depth.w, g.depth.h, &bytes) &&
+                FgGuideBufferBytes(g.mv.w, g.mv.h, &bytes);
+        }
+    }
+    return ok;
+}
+
+static bool FgGuidePrepareTransport(const FgGuideContract &g, uint32_t family)
+{
+    if (!FgGuideCanTransport(g, family)) return false;
+    if (!FgGuideNeedsBlit(g.depth, g.out_w, g.out_h) && !FgGuideNeedsBlit(g.mv, g.out_w, g.out_h)) return true;
+    FgGuideDevice d = {};
+    {
+        std::lock_guard<std::mutex> lock(g_fg_guide_device_lock);
+        const auto found = g_fg_guide_devices.find(g_svk.dev);
+        if (found == g_fg_guide_devices.end()) return false;
+        d = found->second;
+    }
+    uint64_t bytes = 0, temp = 0;
+    if (!FgGuideBufferBytes(g.out_w, g.out_h, &bytes) || !FgGuideBufferBytes(g.depth.w, g.depth.h, &temp)) return false;
+    if (temp > bytes) bytes = temp;
+    if (!FgGuideBufferBytes(g.mv.w, g.mv.h, &temp)) return false;
+    if (temp > bytes) bytes = temp;
+    return FgGuideComputePrepare(bytes, d.local_memory_types, d.graphics_families | d.compute_families);
+}
+
+static void FgGuideRecord(SVkCommandBuffer cb, const FgGuideImage &g,
+                          SVkHandle dst, unsigned w, unsigned h)
+{
+    if (!FgGuideNeedsBlit(g, w, h)) {
+        SVkImageCopy copy = {};
+        copy.srcSubresource = {kSVkAspectColor, 0, 0, 1};
+        copy.dstSubresource = {kSVkAspectColor, 0, 0, 1};
+        copy.srcOffset = {static_cast<int32_t>(g.x), static_cast<int32_t>(g.y), 0};
+        copy.extent = {w, h, 1};
+        g_svk.CmdCopyImage(cb, g.resource.image, kSVkLayoutTransferSrc, dst, kSVkLayoutGeneral, 1, &copy);
+        return;
+    }
+    FgGuideComputeRecord(cb, g, dst, w, h);
+}
+
+static bool g_fg_guides_have_previous;
+static volatile LONG g_fg_guides_pending_reset = 1;
+static FgGuideContract g_fg_guides_previous;
+static void FgGuideRequestReset()
+{
+    InterlockedExchange(&g_fg_guides_pending_reset, 1);
+}
+static void FgGuideObserveSourceReset(bool reset)
+{
+    const LONG64 now = static_cast<LONG64>(GetTickCount64());
+    if (reset) {
+        InterlockedExchange64(&g_fg_source_reset_tick, now);
+        FgGuideRequestReset();
+    }
+    InterlockedExchange64(&g_fg_source_tick, now);
+}
+static void FgGuidePause(const char *why)
+{
+    static void *volatile last_reason;
+    const void *previous = InterlockedExchangePointer(&last_reason, const_cast<char *>(why));
+    if (previous != why || InterlockedCompareExchange(&g_fg_guides_pending_reset, 0, 0) == 0)
+        Log("[fg-guides] paused for this frame: %s; valid inputs resume automatically.", why);
+    FgGuideRequestReset();
+}
+static bool FgGuideSameImageGrid(const FgGuideImage &a, const FgGuideImage &b)
+{
+    return a.resource.w == b.resource.w && a.resource.h == b.resource.h && a.resource.fmt == b.resource.fmt &&
+        a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h;
+}
+static bool FgGuideSameContract(const FgGuideContract &a, const FgGuideContract &b)
+{
+    return FgGuideSameImageGrid(a.depth, b.depth) && FgGuideSameImageGrid(a.mv, b.mv) &&
+        a.out_w == b.out_w && a.out_h == b.out_h && a.inverted == b.inverted && a.jittered == b.jittered &&
+        a.scale_x == b.scale_x && a.scale_y == b.scale_y;
+}
+// Called only once the worker is idle and this frame owns the shared contract.
+static void FgGuideApply(SynthParams *sp, const FgGuideContract &g)
+{
+    const bool changed = !g_fg_guides_have_previous || !FgGuideSameContract(g, g_fg_guides_previous);
+    const bool pending = InterlockedExchange(&g_fg_guides_pending_reset, 0) != 0;
+    // FG resets remain intact. Display-path transitions require observations
+    // of the FG outputs; suppressing the carrier's reset does not establish
+    // continuity of the image actually presented by the FG runtime.
+    const bool reset = changed || pending || g.reset != 0;
+    static unsigned game_reset_frames;
+    static ULONGLONG game_reset_started;
+    if (g.reset != 0) {
+        if (game_reset_frames++ == 0) {
+            game_reset_started = GetTickCount64();
+            DWORD foreground = 0;
+            GetWindowThreadProcessId(GetForegroundWindow(), &foreground);
+            Log("[fg-history] FG Reset burst starts; contract_changed=%u bridge_pending=%u foreground=%u.",
+                changed ? 1u : 0u, pending ? 1u : 0u, foreground == GetCurrentProcessId() ? 1u : 0u);
+        }
+    } else if (game_reset_frames != 0) {
+        Log("[fg-history] FG Reset burst ends: %u real frames, %llu ms.", game_reset_frames, GetTickCount64() - game_reset_started);
+        game_reset_frames = 0;
+    }
+    sp->Set("DLSS.Feature.Create.Flags", g.inverted != 0 ? 0x08u : 0u);
+    sp->Set("MV.Scale.X", g.carrier_scale_x); sp->Set("MV.Scale.Y", g.carrier_scale_y);
+    // HUDLess is already resolved by the game's SR. The unjittered guides and
+    // the resolved carrier share a stable grid, so its synthetic SR jitter is 0.
+    sp->Set("Jitter.Offset.X", 0.0f); sp->Set("Jitter.Offset.Y", 0.0f);
+    sp->Set("Reset", reset ? 1 : 0);
+    if (changed || pending) {
+        Log("[fg-guides] output=%ux%u depth=%ux%u rect=%u,%u+%ux%u mv=%ux%u rect=%u,%u+%ux%u "
+            "mv-scale=%.6g,%.6g carrier-scale=%.6g,%.6g jitter=%.6g,%.6g jittered=%u inverted=%u reset=%u gpu-nearest=%u/%u.",
+            g.out_w, g.out_h, g.depth.resource.w, g.depth.resource.h, g.depth.x, g.depth.y, g.depth.w, g.depth.h,
+            g.mv.resource.w, g.mv.resource.h, g.mv.x, g.mv.y, g.mv.w, g.mv.h,
+            g.scale_x, g.scale_y, g.carrier_scale_x, g.carrier_scale_y,
+            g.jitter_x, g.jitter_y, g.jittered, g.inverted, reset ? 1u : 0u,
+            FgGuideNeedsBlit(g.depth, g.out_w, g.out_h) ? 1u : 0u, FgGuideNeedsBlit(g.mv, g.out_w, g.out_h) ? 1u : 0u);
+    }
+    g_fg_guides_previous = g;
+    g_fg_guides_have_previous = true;
+}
diff --git b/src/fg-handle-registry.h b/src/fg-handle-registry.h
new file mode 100644
index 0000000000000000000000000000000000000000..bfa483d981693ff81c8428305dabeee40d4f331a
--- /dev/null
+++ b/src/fg-handle-registry.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+// Live NGX handles, not a history of all addresses seen during a process. API
+// namespaces are distinct even if two backends return the same pointer value.
+// The caller never keeps this mutex across an NGX or GPU call.
+namespace bridge_lifecycle {
+enum class Api : unsigned { d3d11 = 0, vulkan = 1 };
+
+struct Feature {
+    int id = 0;
+    std::uint64_t generation = 0;
+    const void *owner = nullptr;
+    explicit operator bool() const { return generation != 0; }
+};
+
+class Registry {
+public:
+    bool Created(Api api, const void *handle, int feature, const void *owner,
+                 Feature *created = nullptr) noexcept
+    {
+        if (!handle) return false;
+        try {
+            std::lock_guard<std::mutex> lock(mutex_);
+            Feature value{feature, ++generation_, owner};
+            // A successful Create is a new lifetime, including address reuse.
+            entries_[Index(api)].insert_or_assign(handle, value);
+            if (created) *created = value;
+            return true;
+        } catch (...) {
+            // Allocation failure must not unwind through somebody else's ABI.
+            // The integration logs this and forwards the game's feature intact.
+            return false;
+        }
+    }
+
+    Feature Find(Api api, const void *handle) const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        const auto &table = entries_[Index(api)];
+        const auto it = table.find(handle);
+        return it == table.end() ? Feature{} : it->second;
+    }
+
+    bool Released(Api api, const void *handle, Feature expected, bool succeeded)
+    {
+        if (!succeeded || !expected) return false;
+        std::lock_guard<std::mutex> lock(mutex_);
+        auto &table = entries_[Index(api)];
+        const auto it = table.find(handle);
+        if (it == table.end() || it->second.generation != expected.generation) return false;
+        table.erase(it);
+        return true;
+    }
+
+    void ForgetOwner(const void *owner)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (auto &table : entries_)
+            for (auto it = table.begin(); it != table.end();)
+                if (it->second.owner == owner) it = table.erase(it);
+                else ++it;
+    }
+
+    std::size_t Size(Api api) const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return entries_[Index(api)].size();
+    }
+
+private:
+    static unsigned Index(Api api) { return static_cast<unsigned>(api); }
+    mutable std::mutex mutex_;
+    std::unordered_map<const void *, Feature> entries_[2];
+    std::uint64_t generation_ = 0;
+};
+} // namespace bridge_lifecycle
diff --git b/src/fg-history-policy.h b/src/fg-history-policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..5bbb3403c22b325ee78db13bbb20f62d224c17b7
--- /dev/null
+++ b/src/fg-history-policy.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <cstdint>
+
+// At most one FG-only reset may be ignored for a visible-window focus edge.
+// Native SR resets, discontinuities and unknown/stale SR observations keep
+// their reset semantics. This policy does not modify the game's FG parameters.
+struct FgFocusHistoryPolicy {
+    bool observed = false, previous_focus = false, previous_eligible = false, available = false;
+    std::uint64_t edge_tick = 0;
+    bool Keep(std::uint64_t now, bool focus, bool eligible, bool fg_reset,
+              bool discontinuity, std::uint64_t source_tick, std::uint64_t source_reset_tick) {
+        if (observed && eligible && previous_eligible && focus != previous_focus) {
+            edge_tick = now;
+            available = true;
+        }
+        observed = true; previous_focus = focus; previous_eligible = eligible;
+        if (!eligible || discontinuity || (available && now - edge_tick > 3000)) available = false;
+        if (!fg_reset || !available) return false;
+        available = false;
+        return source_tick != 0 && now >= source_tick && now - source_tick <= 250 &&
+            (source_reset_tick == 0 || (now >= source_reset_tick && now - source_reset_tick > 3000));
+    }
+};
diff --git b/src/fg-input.inc b/src/fg-input.inc
new file mode 100644
index 0000000000000000000000000000000000000000..5baebc1645085a78a9131a4c646cdf8e27e92bfe
--- /dev/null
+++ b/src/fg-input.inc
@@ -0,0 +1,717 @@
+// Native frame-generation input feed for Vulkan: the real, fully composited frame
+// that DLSS-G interpolates from is neural-rendered once per real frame, before the
+// FG evaluate is forwarded. FG then interpolates from processed frames, so the
+// presented multiplier is preserved. Generic still runs through the identity SR
+// carrier on the private D3D12 session; nothing here reads Generic's layout.
+#include "fg-composite-shader.h"
+static void FgGuideRequestReset();
+static bool FgRelayPrepareRelease();
+static bool FgRelayRecoveryReady();
+static void FgRelayObserveGroup(unsigned index, unsigned count, bool count_known);
+static bool FgRelayBlocksSerialFeed();
+
+struct FgComposite {
+    ID3D12RootSignature *rs;
+    ID3D12PipelineState *pso;
+    ID3D12DescriptorHeap *heap;
+    ID3D12CommandAllocator *alloc;
+    ID3D12GraphicsCommandList *list;
+    ID3D12Fence *fence;
+    HANDLE ev;
+    UINT64 fv;
+    ID3D12Resource *hudless, *nr, *back;
+};
+static FgComposite g_fg_composite;
+
+struct FgInputState {
+    bool refused, armed, worker_ok, want_release;
+    // The private session is built and owned, but the SR carrier hook is not
+    // installed yet; no frame is armed or processed until it is.
+    bool carrier_pending;
+    PresentCarrierRetry carrier;
+    uint32_t vk_fmt;
+    UINT w, h;
+    unsigned depth_inverted;
+    VkmRes hudless, back;
+    unsigned frames, writes, skipped_nr, busy_skips;
+    volatile LONG eval_calls, eval_index_skipped;
+    unsigned long long token;
+    unsigned census_left;
+};
+static FgInputState g_fg_input;
+
+// Every key the game's sl.dlss_g.dll (Streamline 2.14.1) can place in the FG
+// parameter block. A one-frame-delayed pipeline has to snapshot whichever of
+// these change per frame, so the first evaluates log which type each key
+// answers to and its value.
+static const char *const kFgCensusKeys[] = {
+    "DLSSG.AutomodeOverrideReset", "DLSSG.Backbuffer", "DLSSG.BackbufferFormat", "DLSSG.BackbufferFrameID",
+    "DLSSG.BackbufferSubrectBaseX", "DLSSG.BackbufferSubrectBaseY", "DLSSG.BackbufferSubrectHeight",
+    "DLSSG.BackbufferSubrectWidth", "DLSSG.BidirectionalDistortionField",
+    "DLSSG.BidirectionalDistortionFieldLowPrecision.Bias", "DLSSG.BidirectionalDistortionFieldLowPrecision.IsLowPrecision",
+    "DLSSG.BidirectionalDistortionFieldLowPrecision.Scale", "DLSSG.BidirectionalDistortionFieldSubrectBaseX",
+    "DLSSG.BidirectionalDistortionFieldSubrectBaseY", "DLSSG.BidirectionalDistortionFieldSubrectHeight",
+    "DLSSG.BidirectionalDistortionFieldSubrectWidth", "DLSSG.CameraAspectRatio", "DLSSG.CameraFOV", "DLSSG.CameraFar",
+    "DLSSG.CameraFwdX", "DLSSG.CameraFwdY", "DLSSG.CameraFwdZ", "DLSSG.CameraMotionIncluded", "DLSSG.CameraNear",
+    "DLSSG.CameraPinholeOffsetX", "DLSSG.CameraPinholeOffsetY", "DLSSG.CameraPosX", "DLSSG.CameraPosY", "DLSSG.CameraPosZ",
+    "DLSSG.CameraRightX", "DLSSG.CameraRightY", "DLSSG.CameraRightZ", "DLSSG.CameraUpX", "DLSSG.CameraUpY", "DLSSG.CameraUpZ",
+    "DLSSG.CameraViewToClip", "DLSSG.ClipToCameraView", "DLSSG.ClipToLensClip", "DLSSG.ClipToPrevClip", "DLSSG.CmdAlloc",
+    "DLSSG.CmdQueue", "DLSSG.ColorBuffersHDR", "DLSSG.Depth", "DLSSG.DepthInverted", "DLSSG.DepthSubrectBaseX",
+    "DLSSG.DepthSubrectBaseY", "DLSSG.DepthSubrectHeight", "DLSSG.DepthSubrectWidth", "DLSSG.Dynamic.ReflexDriven",
+    "DLSSG.DynamicMaxFrameCount", "DLSSG.DynamicResolution", "DLSSG.EnableInterp", "DLSSG.EstimateVRAMCallback",
+    "DLSSG.EvalFlags", "DLSSG.FenceEvent", "DLSSG.FlipMetering", "DLSSG.FullscreenMode", "DLSSG.HUDLess",
+    "DLSSG.HUDLessSubrectBaseX", "DLSSG.HUDLessSubrectBaseY", "DLSSG.HUDLessSubrectHeight", "DLSSG.HUDLessSubrectWidth",
+    "DLSSG.Height", "DLSSG.InternalHeight", "DLSSG.InternalWidth", "DLSSG.IsRecording", "DLSSG.JitterOffsetX",
+    "DLSSG.JitterOffsetY", "DLSSG.MVecs", "DLSSG.MVecsSubrectBaseX", "DLSSG.MVecsSubrectBaseY", "DLSSG.MVecsSubrectHeight",
+    "DLSSG.MVecsSubrectWidth", "DLSSG.MenuDetectionEnabled", "DLSSG.MinRelativeLinearDepthObjectSeparation",
+    "DLSSG.ModelVersion", "DLSSG.MultiFrameCount", "DLSSG.MultiFrameCountMax", "DLSSG.MultiFrameIndex", "DLSSG.MvecDilated",
+    "DLSSG.MvecInvalidValue", "DLSSG.MvecJittered", "DLSSG.MvecScaleX", "DLSSG.MvecScaleY", "DLSSG.NoWarp",
+    "DLSSG.NoWarpSubrectBaseX", "DLSSG.NoWarpSubrectBaseY", "DLSSG.NoWarpSubrectHeight", "DLSSG.NoWarpSubrectWidth",
+    "DLSSG.NotRenderingGameFrames", "DLSSG.NvAppOvrAppliedVal.MultiFrameCount", "DLSSG.NvAppOvrAppliedVal.StreamlineMode",
+    "DLSSG.OrthoProjection", "DLSSG.OutputDisableInterpolation", "DLSSG.OutputInterpolated", "DLSSG.OutputReal",
+    "DLSSG.PrevClipToClip", "DLSSG.QueueSubmitCallback", "DLSSG.QueueSubmitCallbackData", "DLSSG.RefreshRate", "DLSSG.Reset",
+    "DLSSG.StreamlineMode", "DLSSG.StreamlineVersionTag", "DLSSG.SyncFlushCallback", "DLSSG.SyncFlushCallbackData",
+    "DLSSG.SyncSignalCallback", "DLSSG.SyncSignalCallbackData", "DLSSG.SyncSignalOnlyCallback", "DLSSG.SyncSignalOnlyCallbackData",
+    "DLSSG.SyncWaitCallback", "DLSSG.SyncWaitCallbackData", "DLSSG.SyncWaitOnlyCallback", "DLSSG.SyncWaitOnlyCallbackData",
+    "DLSSG.TargetFrameRate", "DLSSG.UI", "DLSSG.UIAlpha", "DLSSG.UIAlphaSubrectBaseX", "DLSSG.UIAlphaSubrectBaseY",
+    "DLSSG.UIAlphaSubrectHeight", "DLSSG.UIAlphaSubrectWidth", "DLSSG.UISubrectBaseX", "DLSSG.UISubrectBaseY",
+    "DLSSG.UISubrectHeight", "DLSSG.UISubrectWidth", "DLSSG.UserInterfaceRecompositionEnabled", "DLSSG.VSyncDriverRequested",
+    "DLSSG.VSyncOn", "DLSSG.VSyncSupported", "DLSSG.VkOFAModeRequest", "DLSSG.Width", "DLSSG.run_lowres_mvec_pass",
+};
+
+static bool FgCensusReadFloats(const void *src, float *dst, size_t n)
+{
+    __try { memcpy(dst, src, n * sizeof(float)); return true; }
+    __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+static void FgCensusAppend(char *line, size_t cap, size_t *len, const char *fmt, ...)
+{
+    if (*len >= cap - 1) return;
+    va_list args;
+    va_start(args, fmt);
+    const int n = _vsnprintf_s(line + *len, cap - *len, _TRUNCATE, fmt, args);
+    va_end(args);
+    *len = n < 0 ? cap - 1 : *len + static_cast<size_t>(n);
+}
+
+static void FgInputCensus(const NVSDK_NGX_Parameter *p, unsigned pass)
+{
+    Log("[fg-census] pass %u begins: %u keys, types tried u/i/f/d/ull/ptr.", pass, static_cast<unsigned>(_countof(kFgCensusKeys)));
+    for (size_t k = 0; k < _countof(kFgCensusKeys); ++k) {
+        const char *key = kFgCensusKeys[k];
+        char line[640];
+        size_t len = 0;
+        FgCensusAppend(line, sizeof(line), &len, "[fg-census] %s", key);
+        bool any = false;
+        unsigned u = 0; int i = 0; float f = 0.0f; double d = 0.0; unsigned long long ull = 0; void *ptr = nullptr;
+        if (p->Get(key, &u) == NGX_SUCCESS)   { FgCensusAppend(line, sizeof(line), &len, " u=%u", u); any = true; }
+        if (p->Get(key, &i) == NGX_SUCCESS)   { FgCensusAppend(line, sizeof(line), &len, " i=%d", i); any = true; }
+        if (p->Get(key, &f) == NGX_SUCCESS)   { FgCensusAppend(line, sizeof(line), &len, " f=%.6g", f); any = true; }
+        if (p->Get(key, &d) == NGX_SUCCESS)   { FgCensusAppend(line, sizeof(line), &len, " d=%.9g", d); any = true; }
+        if (p->Get(key, &ull) == NGX_SUCCESS) { FgCensusAppend(line, sizeof(line), &len, " ull=%llu", ull); any = true; }
+        if (p->Get(key, &ptr) == NGX_SUCCESS) {
+            FgCensusAppend(line, sizeof(line), &len, " ptr=%p", ptr);
+            any = true;
+            if (ptr != nullptr && strstr(key, "Clip") != nullptr) {
+                float m[16] = {};
+                if (FgCensusReadFloats(ptr, m, 16))
+                    FgCensusAppend(line, sizeof(line), &len,
+                                   " m=[%.4g %.4g %.4g %.4g | %.4g %.4g %.4g %.4g | %.4g %.4g %.4g %.4g | %.4g %.4g %.4g %.4g]",
+                                   m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9], m[10], m[11], m[12], m[13], m[14], m[15]);
+            }
+        }
+        if (any) Log("%s", line);
+    }
+    Log("[fg-census] pass %u ends.", pass);
+}
+
+static bool FgCompositeWait(DWORD ms)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.fence == nullptr) return true;
+    return FenceDeadlineWait(c.fence, c.ev, c.fv, ms, "fg-composite");
+}
+
+static bool FgCompositeMake(ID3D12Device *dev, ID3D12Resource *hudless, ID3D12Resource *nr,
+                            ID3D12Resource *back)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.pso == nullptr) {
+        PFN_D3DCompile_ compile = LoadSystemD3DCompiler();
+        if (compile == nullptr) { Log("[fg-input] d3dcompiler_47.dll unavailable for the composite pass"); return false; }
+        ID3DBlob *code = nullptr, *err = nullptr;
+        HRESULT hr = compile(kFgCompositeShader, sizeof(kFgCompositeShader) - 1, "fgc", nullptr, nullptr,
+                             "main", "cs_5_0", 0, 0, &code, &err);
+        if (FAILED(hr) || code == nullptr) {
+            Log("[fg-input] composite shader failed to compile: %s",
+                err != nullptr ? static_cast<const char *>(err->GetBufferPointer()) : "");
+            if (err != nullptr) err->Release();
+            return false;
+        }
+        if (err != nullptr) err->Release();
+        D3D12_DESCRIPTOR_RANGE ranges[2] = {};
+        ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        ranges[0].NumDescriptors = 2;
+        ranges[0].OffsetInDescriptorsFromTableStart = 0;
+        ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+        ranges[1].NumDescriptors = 1;
+        ranges[1].OffsetInDescriptorsFromTableStart = 2;
+        D3D12_ROOT_PARAMETER param = {};
+        param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        param.DescriptorTable.NumDescriptorRanges = 2;
+        param.DescriptorTable.pDescriptorRanges = ranges;
+        param.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        D3D12_ROOT_SIGNATURE_DESC rsd = {};
+        rsd.NumParameters = 1;
+        rsd.pParameters = &param;
+        HMODULE d3d12 = GetModuleHandleW(L"d3d12.dll");
+        auto serialize = d3d12 != nullptr
+            ? reinterpret_cast<PFN_D3D12_SERIALIZE_ROOT_SIGNATURE>(GetProcAddress(d3d12, "D3D12SerializeRootSignature")) : nullptr;
+        ID3DBlob *rsblob = nullptr, *rserr = nullptr;
+        hr = serialize != nullptr ? serialize(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &rsblob, &rserr) : E_FAIL;
+        if (FAILED(hr) || rsblob == nullptr) {
+            Log("[fg-input] composite root signature would not serialize 0x%08X", hr);
+            if (rserr != nullptr) rserr->Release();
+            code->Release();
+            return false;
+        }
+        if (rserr != nullptr) rserr->Release();
+        hr = dev->CreateRootSignature(0, rsblob->GetBufferPointer(), rsblob->GetBufferSize(),
+                                      __uuidof(ID3D12RootSignature), reinterpret_cast<void **>(&c.rs));
+        rsblob->Release();
+        if (FAILED(hr)) { code->Release(); Log("[fg-input] composite root signature failed 0x%08X", hr); return false; }
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {};
+        pd.pRootSignature = c.rs;
+        pd.CS.pShaderBytecode = code->GetBufferPointer();
+        pd.CS.BytecodeLength = code->GetBufferSize();
+        hr = dev->CreateComputePipelineState(&pd, __uuidof(ID3D12PipelineState), reinterpret_cast<void **>(&c.pso));
+        code->Release();
+        if (FAILED(hr)) { Log("[fg-input] composite pipeline failed 0x%08X", hr); return false; }
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = 3;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(dev->CreateDescriptorHeap(&hd, __uuidof(ID3D12DescriptorHeap), reinterpret_cast<void **>(&c.heap))) ||
+            FAILED(dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, __uuidof(ID3D12CommandAllocator), reinterpret_cast<void **>(&c.alloc))) ||
+            FAILED(dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, c.alloc, nullptr, __uuidof(ID3D12GraphicsCommandList), reinterpret_cast<void **>(&c.list))) ||
+            FAILED(dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), reinterpret_cast<void **>(&c.fence)))) {
+            Log("[fg-input] composite heap/list/fence creation failed");
+            return false;
+        }
+        c.list->Close();
+        c.ev = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (c.ev == nullptr) return false;
+    }
+    if (!FgCompositeWait(4000)) return false;
+    c.hudless = hudless; c.nr = nr; c.back = back;
+    const UINT inc = dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu = c.heap->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd = {};
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sd.Texture2D.MipLevels = 1;
+    sd.Format = hudless->GetDesc().Format;
+    dev->CreateShaderResourceView(hudless, &sd, cpu);
+    cpu.ptr += inc;
+    sd.Format = nr->GetDesc().Format;
+    dev->CreateShaderResourceView(nr, &sd, cpu);
+    cpu.ptr += inc;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {};
+    ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    ud.Format = back->GetDesc().Format;
+    dev->CreateUnorderedAccessView(back, nullptr, &ud, cpu);
+    return true;
+}
+
+// Runs on the private queue after the NR submission; the caller fences on it.
+// wait_done is false on the relay's path, where the completion is consumed by the
+// D3D12 queue's own release signal rather than by this thread.
+static bool FgCompositeRun(ID3D12CommandQueue *queue, DWORD wait_ms, bool wait_done = true)
+{
+    FgComposite &c = g_fg_composite;
+    if (c.pso == nullptr || c.back == nullptr) return false;
+    if (!FgCompositeWait(wait_ms)) return false;
+    if (FAILED(c.alloc->Reset()) || FAILED(c.list->Reset(c.alloc, nullptr))) return false;
+    Barrier(c.list, c.hudless, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(c.list, c.nr, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(c.list, c.back, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    ID3D12DescriptorHeap *heaps[] = { c.heap };
+    c.list->SetDescriptorHeaps(1, heaps);
+    c.list->SetComputeRootSignature(c.rs);
+    c.list->SetPipelineState(c.pso);
+    c.list->SetComputeRootDescriptorTable(0, c.heap->GetGPUDescriptorHandleForHeapStart());
+    const D3D12_RESOURCE_DESC bd = c.back->GetDesc();
+    c.list->Dispatch((static_cast<UINT>(bd.Width) + 7) / 8, (bd.Height + 7) / 8, 1);
+    Barrier(c.list, c.back, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(c.list, c.nr, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(c.list, c.hudless, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    if (FAILED(c.list->Close())) return false;
+    ID3D12CommandList *lists[] = { c.list };
+    queue->ExecuteCommandLists(1, lists);
+    if (FAILED(queue->Signal(c.fence, ++c.fv))) return false;
+    if (!wait_done) return true;
+    return FgCompositeWait(wait_ms);
+}
+
+// Identity on the private side so an unconditional Vulkan copy back is harmless.
+static bool FgIdentityCopy(DWORD wait_ms)
+{
+    if (!Synth12Begin(wait_ms)) return false;
+    Barrier(g_s12.list, g_s12.tex[SLOT_COLOR], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Barrier(g_s12.list, g_s12.tex[SLOT_OUTPUT], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
+    g_s12.list->CopyResource(g_s12.tex[SLOT_OUTPUT], g_s12.tex[SLOT_COLOR]);
+    Barrier(g_s12.list, g_s12.tex[SLOT_COLOR], D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(g_s12.list, g_s12.tex[SLOT_OUTPUT], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COMMON);
+    return Synth12WaitFence(Synth12End(), wait_ms);
+}
+
+// Worker-thread half of one FG-input frame. The game's queue is parked while this
+// runs, so every wait is bounded by the mirror's evaluate budget.
+static bool FgInputWorker()
+{
+    bool ok = false, nr_absent = false;
+    unsigned nr_entries = 0, sr_entries = 0, sr_copies = 0;
+    if (g_present_adapter.run_nr) {
+        g_present_nr_entries = g_present_sr_entries = g_present_sr_copies = 0;
+        {
+            if (g_ngx_cs_ready) EnterCriticalSection(&g_ngx_cs);
+            PresentAdapterNrScope scope;
+            ok = Synth12EvaluateShared(&g_vkm.sp, kVkmEvaluateMs);
+            if (g_ngx_cs_ready) LeaveCriticalSection(&g_ngx_cs);
+        }
+        nr_entries = g_present_nr_entries; sr_entries = g_present_sr_entries; sr_copies = g_present_sr_copies;
+        PresentCompatibilityFrame(ok, nr_entries, sr_entries, sr_copies);
+        if (ok && (sr_entries != 1 || sr_copies != 1)) {
+            Log("[fg-input] carrier contract mismatch: sr_entries=%u sr_copies=%u; frame not written.", sr_entries, sr_copies);
+            ok = false;
+        }
+        // Generic switched off or warming up: the carrier round-trip is the game's own
+        // image, so the recorded copy back is harmless and this is not a failure.
+        if (ok && nr_entries == 0) { nr_absent = true; ++g_fg_input.skipped_nr; FgGuideRequestReset(); }
+        if (ok && !nr_absent) ok = FgCompositeRun(g_s12.queue, kVkmEvaluateMs);
+    } else {
+        ok = PresentAdapterCopy12();
+    }
+    ok = ok && g_s12.dev->GetDeviceRemovedReason() == S_OK;
+    if (!ok) {
+        FgGuideRequestReset();
+        // Keep the carriers equal to their inputs so the recorded copy back is a no-op.
+        if (!FgIdentityCopy(kVkmEvaluateMs))
+            Log("[fg-input] identity fallback copy not confirmed within %lu ms.", kVkmEvaluateMs);
+    }
+    g_fg_input.worker_ok = ok;
+    ++g_fg_input.frames;
+    if (ok && !nr_absent) ++g_fg_input.writes;
+    const unsigned cadence = g_present_adapter.continuous ? 1800u : 120u;
+    if (g_fg_input.frames <= 3 || g_fg_input.frames % cadence == 0 || !ok || g_present_adapter.remaining == 0)
+        Log("[fg-input] frame=%u %ux%u vkfmt=%u mode=%s pipeline=%s nr_entries=%u sr_entries=%u sr_copies=%u ok=%d busy_skips=%u token=%llu.",
+            g_fg_input.frames, g_fg_input.w, g_fg_input.h, g_fg_input.vk_fmt,
+            g_present_adapter.run_nr ? "NR" : g_present_adapter.colour_roundtrip ? "carrier" : "copy",
+            PresentAdapterPipeline() == 1 ? "probe(discarded)" : "serial",
+            nr_entries, sr_entries, sr_copies, ok ? 1 : 0, g_fg_input.busy_skips, g_present_adapter.token);
+    if (g_present_adapter.remaining == 0)
+        Log("[fg-input] request complete: frames=%u writes=%u no_nr=%u busy_skips=%u. token=%llu",
+            g_fg_input.frames, g_fg_input.writes, g_fg_input.skipped_nr, g_fg_input.busy_skips, g_present_adapter.token);
+    return ok;
+}
+
+static void FgInputRefuse(const char *why)
+{
+    if (g_fg_input.refused) return;
+    g_fg_input.refused = true;
+    g_present_adapter.remaining = 0;
+    PresentCompatibilityIssue(PC_PROCESSING_FAILED, why);
+    Log("[fg-input] refused: %s. Frame generation continues on the game's own frames.", why);
+}
