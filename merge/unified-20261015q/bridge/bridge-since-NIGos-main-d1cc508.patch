diff --git b/src/AdapterEvents.fx b/src/AdapterEvents.fx
new file mode 100644
index 0000000000000000000000000000000000000000..83318096c218ed9285e11acf4703c6ee3568eb74
--- /dev/null
+++ b/src/AdapterEvents.fx
@@ -0,0 +1,20 @@
+// ReShade skips begin/finish-effects events when it has no techniques.
+// This technique exists only to make the documented callback available.
+// ColorWriteMask=0 preserves the application's colour, including alpha.
+float4 AdapterVS(uint id : SV_VertexID) : SV_Position
+{
+    return float4(id == 2 ? 3.0 : -1.0, id == 1 ? 3.0 : -1.0, 0.0, 1.0);
+}
+float4 AdapterPS(float4 position : SV_Position) : SV_Target
+{
+    return 0.0;
+}
+technique AdapterEvents
+{
+    pass
+    {
+        VertexShader = AdapterVS;
+        PixelShader = AdapterPS;
+        ColorWriteMask = 0;
+    }
+}
diff --git b/src/bounded-report.h b/src/bounded-report.h
new file mode 100644
index 0000000000000000000000000000000000000000..32b95c01cc24e2236997ca4d6c35cab4221841e7
--- /dev/null
+++ b/src/bounded-report.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstddef>
+#include <cstring>
+
+// Keep a valid prefix without invoking the CRT invalid-parameter handler.
+template <std::size_t N>
+bool AppendCrashReport(char (&dst)[N], const char *src)
+{
+    static_assert(N > 0, "A terminator is required");
+    const std::size_t used = std::strlen(dst);
+    const std::size_t length = std::strlen(src);
+    const std::size_t room = N - 1 - used;
+    const std::size_t count = length < room ? length : room;
+    std::memcpy(dst + used, src, count);
+    dst[used + count] = '\0';
+    return count == length;
+}
