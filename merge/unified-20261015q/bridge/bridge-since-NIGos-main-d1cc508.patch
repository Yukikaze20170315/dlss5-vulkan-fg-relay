+// Every FG evaluate, on Streamline's thread, before the input feed looks at it.
+static void FgTraceEvaluate(void *cmd, const NVSDK_NGX_Parameter *p)
+{
+    InterlockedIncrement(&g_focus_fg_evaluates);
+    if (!FgtEnabled() || !g_fgt_control.cs_ready) return;
+    FgTrace &t = g_fgt;
+    const LONGLONG now = FgtNow();
+    unsigned idx = 0;
+    const bool indexed = FgInputReadU(p, "DLSSG.MultiFrameIndex", &idx);
+    void *queue = nullptr;
+    p->Get("DLSSG.CmdQueue", &queue);
+    const char *why = nullptr;
+    VkmRes hud = {}, back = {}, mv = {}, depth = {}, oreal = {}, ointerp = {};
+    const bool have_hud = VkmGetRes(p, "DLSSG.HUDLess", &hud, &why);
+    const bool have_back = VkmGetRes(p, "DLSSG.Backbuffer", &back, &why);
+    const bool have_mv = VkmGetRes(p, "DLSSG.MVecs", &mv, &why);
+    const bool have_depth = VkmGetRes(p, "DLSSG.Depth", &depth, &why);
+    const bool have_real = VkmGetRes(p, "DLSSG.OutputReal", &oreal, &why);
+    const bool have_interp = VkmGetRes(p, "DLSSG.OutputInterpolated", &ointerp, &why);
+    const bool first = indexed ? idx == 1 : have_real;
+    fso::Sample first_sample;
+    unsigned groups = 0, calls = 0;
+    double since_present = -1.0;
+    FgtLock();
+    const LONGLONG present = t.last_present_qpc;
+    calls = ++t.eval_calls;
+    t.cmd_queue = reinterpret_cast<uint64_t>(queue);
+    t.eval_thread = GetCurrentThreadId();
+    FgtNote(t.eval_threads, GetCurrentThreadId());
+    FgtNote(t.eval_indices, idx);
+    if (first) {
+        ++t.eval_groups;
+        t.last_fg_cmd = cmd;
+        const fso::Images images = { have_hud ? hud.image : 0ull, have_back ? back.image : 0ull,
+            have_depth ? depth.image : 0ull, have_mv ? mv.image : 0ull,
+            (have_hud ? 1u : 0u) | (have_back ? 2u : 0u) | (have_depth ? 4u : 0u) | (have_mv ? 8u : 0u) };
+        first_sample = g_fgt_observer.First(reinterpret_cast<uint64_t>(cmd), reinterpret_cast<uint64_t>(queue),
+            images, static_cast<uint64_t>(now), idx, indexed);
+        if (present != 0 && now >= present) { since_present = FgtMs(present, now); FgtStatAdd(t.present_to_eval, since_present); }
+        if (t.last_eval1_qpc != 0) FgtStatAdd(t.eval_interval, FgtMs(t.last_eval1_qpc, now));
+        t.last_eval1_qpc = now;
+        t.group_first_qpc = now;
+        if (have_hud) FgtNote(t.hud, hud.image);
+        if (have_back) FgtNote(t.back, back.image);
+        if (have_mv) FgtNote(t.mv, mv.image);
+        if (have_depth) FgtNote(t.depth, depth.image);
+        if (have_real) FgtNote(t.out_real, oreal.image);
+    } else if (t.group_first_qpc != 0) {
+        FgtStatAdd(t.eval_group_span, FgtMs(t.group_first_qpc, now));
+    }
+    if (have_interp) FgtNote(t.out_interp, ointerp.image);
+    groups = t.eval_groups;
+    FgtUnlock();
+    FgtLogFirstSample(first_sample);
+    if (groups <= 3) {
+        FgtLog("[fg-trace] evaluate #%u idx=%u%s thread=%lu cmd=%p queue=%p since_present=%.2fms hud=%llx back=%llx depth=%llx mv=%llx real=%llx interp=%llx",
+            calls, idx, indexed ? "" : "(unindexed)", GetCurrentThreadId(), cmd, queue,
+            first ? since_present : (present != 0 ? FgtMs(present, now) : -1.0),
+            have_hud ? hud.image : 0ull, have_back ? back.image : 0ull, have_depth ? depth.image : 0ull,
+            have_mv ? mv.image : 0ull, have_real ? oreal.image : 0ull, have_interp ? ointerp.image : 0ull);
+    }
+    if (first && (groups == 60 || groups % 600 == 0)) FgtSummary();
+}
diff --git b/src/focus-fg-contract.h b/src/focus-fg-contract.h
new file mode 100644
index 0000000000000000000000000000000000000000..d30ce2be5eb533ad630576dcbf30bdd916a7a336
--- /dev/null
+++ b/src/focus-fg-contract.h
@@ -0,0 +1,66 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Contract discovery for Streamline's internal DLSS-G focus gate. This finds a
+// specific call site, not a version/hash or a process-wide focus API. A changed
+// implementation is left untouched unless the same unique contract is found.
+namespace focus_fg {
+struct Site { size_t object_slot = 0, return_address = 0; };
+
+inline bool Within(size_t at, size_t length, size_t size)
+{
+    return at <= size && length <= size - at;
+}
+
+inline bool Relative(size_t next, const uint8_t *displacement, size_t size, size_t *result)
+{
+    int32_t delta = 0;
+    memcpy(&delta, displacement, sizeof(delta));
+    const int64_t address = static_cast<int64_t>(next) + delta;
+    if (address < 0 || static_cast<uint64_t>(address) >= size) return false;
+    *result = static_cast<size_t>(address);
+    return true;
+}
+
+inline bool Find(const uint8_t *image, size_t size, size_t code_begin, size_t code_size, Site *out)
+{
+    if (image == nullptr || out == nullptr || !Within(code_begin, code_size, size)) return false;
+    static const char message[] = "DLSS-G disabled: window not focused";
+    size_t matches = 0;
+    Site found;
+    for (size_t i = code_begin; Within(i, 74, code_begin + code_size); ++i) {
+        // mov rcx,[rip+keyboard]; mov rax,[rcx]; call [rax+18h]; test al,al;
+        // jne enabled; cmp byte ptr [rbx+override],sil; jne enabled; ...
+        // lea rdx,[rip+"DLSS-G disabled: window not focused"]
+        if (memcmp(image + i, "\x48\x8b\x0d", 3) != 0 ||
+            memcmp(image + i + 7, "\x48\x8b\x01\xff\x50\x18\x84\xc0\x0f\x85", 10) != 0 ||
+            memcmp(image + i + 21, "\x40\x38\xb3", 3) != 0 ||
+            memcmp(image + i + 28, "\x0f\x85", 2) != 0 ||
+            memcmp(image + i + 67, "\x48\x8d\x15", 3) != 0) continue;
+        size_t slot = 0, text = 0, enabled_a = 0, enabled_b = 0;
+        if (!Relative(i + 7, image + i + 3, size, &slot) || !Within(slot, sizeof(void *), size) ||
+            !Relative(i + 74, image + i + 70, size, &text) || !Within(text, sizeof(message), size) ||
+            memcmp(image + text, message, sizeof(message)) != 0 ||
+            !Relative(i + 21, image + i + 17, size, &enabled_a) ||
+            !Relative(i + 34, image + i + 30, size, &enabled_b) || enabled_a != enabled_b ||
+            enabled_a <= i + 74 || enabled_a >= code_begin + code_size) continue;
+        ++matches;
+        found = { slot, i + 13 };
+    }
+    if (matches != 1) return false;
+    *out = found;
+    return true;
+}
+
+// An explicit game Off, invalid tags, resolution changes and resource release
+// remain Streamline's responsibility. Only this internal focus result changes.
+inline bool Override(bool original, bool exact_caller, bool enabled, bool runtime_present,
+                     bool current_process, bool visible, bool minimized, bool drawable,
+                     bool same_client_size)
+{
+    return original || (exact_caller && enabled && runtime_present && current_process &&
+        visible && !minimized && drawable && same_client_size);
+}
+} // namespace focus_fg
diff --git b/src/focus-fg.inc b/src/focus-fg.inc
new file mode 100644
index 0000000000000000000000000000000000000000..499b7cbb786ae0bd0fdf657f056d41b8dec34721
--- /dev/null
+++ b/src/focus-fg.inc
@@ -0,0 +1,195 @@
+#include <intrin.h>
+#include "focus-fg-contract.h"
+
+// Only Streamline's single verified DLSS-G focus call is overridden. Keeping
+// the original method for every other caller also preserves its keyboard and
+// input handling. Explicit Off, missing tags and resource release are untouched.
+struct FocusFgWindow {
+    reshade::api::effect_runtime *runtime;
+    HWND window;
+    LONG width, height;
+};
+struct FocusFgState {
+    Hook focus, free_resources;
+    bool discovery_done, free_tried;
+    void *caller;
+    ULONGLONG next_poll;
+};
+static FocusFgState g_focus_fg;
+static FocusFgWindow g_focus_fg_window;
+static SRWLOCK g_focus_fg_lock = SRWLOCK_INIT;
+static volatile LONG g_focus_fg_enabled;
+static volatile LONG g_focus_fg_calls, g_focus_fg_overrides, g_focus_fg_original_false;
+static volatile LONG g_focus_fg_presents, g_focus_fg_evaluates;
+static volatile LONGLONG g_focus_fg_request_tick;
+
+static FocusFgWindow FocusFgWindowSnapshot()
+{
+    AcquireSRWLockShared(&g_focus_fg_lock);
+    const FocusFgWindow value = g_focus_fg_window;
+    ReleaseSRWLockShared(&g_focus_fg_lock);
+    return value;
+}
+
+#include "composition-guard.inc"
+
+static void FocusFgSetRuntime(reshade::api::effect_runtime *rt)
+{
+    FocusFgWindow value = {};
+    value.runtime = rt;
+    value.window = static_cast<HWND>(rt->get_hwnd());
+    RECT rect = {};
+    if (value.window != nullptr && GetClientRect(value.window, &rect)) {
+        value.width = rect.right - rect.left;
+        value.height = rect.bottom - rect.top;
+    }
+    AcquireSRWLockExclusive(&g_focus_fg_lock);
+    g_focus_fg_window = value;
+    ReleaseSRWLockExclusive(&g_focus_fg_lock);
+    TriggerHookScan();
+}
+
+static void FgtOnDestroyRuntime(reshade::api::effect_runtime *rt)
+{
+    AcquireSRWLockExclusive(&g_focus_fg_lock);
+    if (g_focus_fg_window.runtime == rt) g_focus_fg_window = {};
+    ReleaseSRWLockExclusive(&g_focus_fg_lock);
+}
+
+typedef bool (*PFN_FocusFgHasFocus)(void *);
+static bool FocusFgHasFocusDetour(void *keyboard)
+{
+    void *const caller = _ReturnAddress();
+    const bool original = reinterpret_cast<PFN_FocusFgHasFocus>(g_focus_fg.focus.original)(keyboard);
+    if (caller != g_focus_fg.caller) return original;
+    InterlockedIncrement(&g_focus_fg_calls);
+    if (original) return true;
+    InterlockedIncrement(&g_focus_fg_original_false);
+    if (InterlockedCompareExchange(&g_focus_fg_enabled, 0, 0) == 0) return false;
+    const FocusFgWindow value = FocusFgWindowSnapshot();
+    DWORD pid = 0;
+    RECT rect = {};
+    const bool valid = value.window != nullptr && IsWindow(value.window);
+    if (valid) GetWindowThreadProcessId(value.window, &pid);
+    const bool drawable = valid && GetClientRect(value.window, &rect) &&
+        rect.right > rect.left && rect.bottom > rect.top;
+    const bool result = focus_fg::Override(original, true, true, value.runtime != nullptr,
+        pid == GetCurrentProcessId(), valid && IsWindowVisible(value.window),
+        !valid || IsIconic(value.window), drawable,
+        drawable && rect.right - rect.left == value.width && rect.bottom - rect.top == value.height);
+    if (result) InterlockedIncrement(&g_focus_fg_overrides);
+    return result;
+}
+
+typedef uint32_t (*PFN_FocusFgFree)(uint32_t, const void *);
+static uint32_t FocusFgFreeDetour(uint32_t feature, const void *viewport)
+{
+    const uint32_t result = reinterpret_cast<PFN_FocusFgFree>(g_focus_fg.free_resources.original)(feature, viewport);
+    if (feature == 1000) FgtLog("[focus-fg] game slFreeResources(DLSS_G) forwarded unchanged: result=0x%x foreground=%u",
+        result, ForegroundIsThisProcess() ? 1u : 0u);
+    return result;
+}
+
+static bool FocusFgFindGate(HMODULE module, focus_fg::Site *site, void **object, void **target)
+{
+    __try {
+        const uint8_t *image = reinterpret_cast<const uint8_t *>(module);
+        const auto *dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(image);
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 4096) return false;
+        const auto *nt = reinterpret_cast<const IMAGE_NT_HEADERS64 *>(image + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return false;
+        const auto *sections = IMAGE_FIRST_SECTION(nt);
+        unsigned found = 0;
+        for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i) {
+            if (!(sections[i].Characteristics & IMAGE_SCN_CNT_CODE)) continue;
+            focus_fg::Site candidate;
+            if (focus_fg::Find(image, nt->OptionalHeader.SizeOfImage, sections[i].VirtualAddress,
+                              sections[i].Misc.VirtualSize, &candidate)) {
+                ++found;
+                *site = candidate;
+            }
+        }
+        if (found != 1) return false;
+        *object = *reinterpret_cast<void *const *>(image + site->object_slot);
+        // A null interface can be a normal early-load state; retry later.
+        if (*object == nullptr) { *target = nullptr; return true; }
+        void *const *vtable = *reinterpret_cast<void *const *const *>(*object);
+        *target = vtable[3];
+        return *target != nullptr;
+    } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+}
+
+// Called on game presents: no disk I/O, GPU waits or worker lock. The deferred
+// worker owns configuration reads and summaries; the hook's state is atomic.
+static void FocusFgOnPresent()
+{
+    InterlockedIncrement(&g_focus_fg_presents);
+    const LONGLONG now = static_cast<LONGLONG>(GetTickCount64());
+    const LONGLONG previous = InterlockedCompareExchange64(&g_focus_fg_request_tick, 0, 0);
+    if (now - previous >= 1000 && InterlockedCompareExchange64(&g_focus_fg_request_tick, now, previous) == previous)
+        TriggerHookScan();
+}
+
+// Caller holds g_hook_cs. Module/interface owners are pinned before detouring.
+static void FocusFgMaintenance()
+{
+    if (!PresentAdapterFocusKeepFG()) return;
+    FocusFgState &state = g_focus_fg;
+    const ULONGLONG now = GetTickCount64();
+    if (now >= state.next_poll) {
+        state.next_poll = now + 1000;
+        wchar_t path[1024] = {};
+        PresentAdapterPath(path, _countof(path), L"ReShade.ini");
+        // A stage-protocol Generic selects the FG-input feed by its Present layer
+        // count; NRHookPoint is only its legacy single-point setting.
+        uint32_t plan = 0;
+        const bool present_selected = PresentAdapterStagePlan(&plan)
+            ? ((plan >> 6) & 7u) != 0
+            : GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NRHookPoint", -1, path) == 2;
+        const bool enabled = GetPrivateProfileIntW(L"RenoDX.DLSS5", L"NeuralUplift", 0, path) == 1 &&
+            GenericCurrentHookMode(path, 0) == 1 && present_selected;
+        InterlockedExchange(&g_focus_fg_enabled, enabled ? 1 : 0);
+        if (enabled) CompositionGuardStart();
+        static unsigned report_count;
+        static LONG previous_focus = -1, previous_minimized = -1;
+        const FocusFgWindow window = FocusFgWindowSnapshot();
+        const LONG focused = ForegroundIsThisProcess() ? 1 : 0;
+        const LONG minimized = window.window != nullptr && IsIconic(window.window) ? 1 : 0;
+        if (focused != previous_focus || minimized != previous_minimized || ++report_count >= 15) {
+            report_count = 0;
+            previous_focus = focused;
+            previous_minimized = minimized;
+            FgtLog("[focus-fg] state: enabled=%u hooked=%u foreground=%ld minimized=%ld hwnd=%p scope_calls=%ld original_false=%ld kept=%ld presents=%ld FG_evaluates=%ld",
+                enabled ? 1u : 0u, state.focus.active ? 1u : 0u, focused, minimized, window.window,
+                InterlockedCompareExchange(&g_focus_fg_calls, 0, 0), InterlockedCompareExchange(&g_focus_fg_original_false, 0, 0),
+                InterlockedCompareExchange(&g_focus_fg_overrides, 0, 0), InterlockedCompareExchange(&g_focus_fg_presents, 0, 0),
+                InterlockedCompareExchange(&g_focus_fg_evaluates, 0, 0));
+        }
+    }
+    HMODULE dlssg = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN, L"sl.dlss_g.dll", &dlssg)) return;
+    // MFG Unlock owns slDLSSGSetOptions. Focus retention does not require an
+    // options detour; taking that entry would prevent its multiplier hook.
+    if (!state.free_tried) {
+        HMODULE interposer = nullptr;
+        if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN, L"sl.interposer.dll", &interposer)) {
+            state.free_tried = true;
+            const bool ok = HookInstall(state.free_resources, reinterpret_cast<void *>(GetProcAddress(interposer, "slFreeResources")), reinterpret_cast<void *>(&FocusFgFreeDetour));
+            FgtLog("[focus-fg] FreeResources diagnostic hook %s (arguments unchanged)", ok ? "ready" : "unavailable");
+        }
+    }
+    if (!state.discovery_done) {
+        focus_fg::Site site;
+        void *object = nullptr, *target = nullptr;
+        if (!FocusFgFindGate(dlssg, &site, &object, &target)) {
+            state.discovery_done = true;
+            FgtLog("[focus-fg] unavailable: unique Streamline focus-gate contract was not found; native focus behaviour retained (this is unrelated to Generic version compatibility)");
+        } else if (target != nullptr) {
+            state.discovery_done = true;
+            state.caller = reinterpret_cast<uint8_t *>(dlssg) + site.return_address;
+            const bool ok = PinHookModule(target) && HookInstall(state.focus, target, reinterpret_cast<void *>(&FocusFgHasFocusDetour));
+            FgtLog("[focus-fg] scoped focus gate %s: return_rva=0x%zx interface=%p method=%p; explicit FG Off and all resource release remain native",
+                ok ? "ready" : "unavailable", site.return_address, object, target);
+        }
+    }
+}
diff --git b/src/generic-hook-mode.h b/src/generic-hook-mode.h
new file mode 100644
index 0000000000000000000000000000000000000000..7c15574776e7012a50bb0e0d7d3c7e1f9873406b
--- /dev/null
+++ b/src/generic-hook-mode.h
@@ -0,0 +1,25 @@
+#pragma once
+#include "../../common/hook-mode.hpp"
+#include <atomic>
+
+using GenericHookModeControl = bool (__cdecl *)(uint32_t, uint32_t, dlss5::hook_mode::Snapshot*);
+static std::atomic<GenericHookModeControl> g_generic_hook_mode_control{nullptr};
+static bool GenericHookModeCall(uint32_t operation, uint32_t value, dlss5::hook_mode::Snapshot* result) {
+    auto control = g_generic_hook_mode_control.load();
+    if (!control) {
+        const HMODULE consumer = GetModuleHandleW(L"renodx-dlss5.addon64");
+        if (!consumer) return false;
+        control = reinterpret_cast<GenericHookModeControl>(GetProcAddress(consumer, "DLSS5HookModeControlV1"));
+        HMODULE retained = nullptr;
+        if (!control || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                                            reinterpret_cast<LPCWSTR>(consumer), &retained)) return false;
+        g_generic_hook_mode_control.store(control);
+    }
+    return control(operation, value, result) && result && result->version == 1 &&
+        result->size == sizeof(*result) && dlss5::hook_mode::Valid(result->current);
+}
+static int GenericCurrentHookMode(const wchar_t* ini, int legacy_default) {
+    dlss5::hook_mode::Snapshot state;
+    if (GenericHookModeCall(dlss5::hook_mode::Current, 0, &state)) return static_cast<int>(state.current);
+    return static_cast<int>(GetPrivateProfileIntW(L"RenoDX.DLSS5", L"EnableHooks", legacy_default, ini));
+}
