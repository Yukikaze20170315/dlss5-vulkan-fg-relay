+// ---------------------------------------------------------------------------
+// The present hook half (Pipeline=3)
+// ---------------------------------------------------------------------------
+
+struct FgrPresentInfo
+{
+    uint32_t sType; const void *pNext;
+    uint32_t waitSemaphoreCount; const uint64_t *pWaitSemaphores;
+    uint32_t swapchainCount; const uint64_t *pSwapchains; const uint32_t *pImageIndices; void *pResults;
+};
+
+// Back-pressure for the stage Reflex cannot see: held until the shared fence shows
+// the NR of the newest armed frame (less Throttle-1) completed. That NR is already
+// queued or about to be (the worker queues it without waiting on anything the
+// game does next), so the wait cannot depend on the waiting thread; it is bounded
+// anyway, and a throttle that keeps timing out turns itself off for the process.
+// The wait must not depend on the native MFG group having reached its last index:
+// with the relay, Streamline issues indices 2..N about one real frame after index 1,
+// right before the next group starts, so a "completed group" gate almost never
+// held the game (measured: 0 waits per second, PC latency 216 ms instead of ~158).
+// The fence is referenced under the lock because the session release frees it
+// under the lock.
+//
+// Where it waits decides what it buys. At the game's Reflex sleep the wait lands
+// before the frame's simulation starts, so the input is sampled after it -- the
+// latency goes. At the game's present the frame has already been simulated, so
+// the wait only moves the queue from the GPU into the frame's own latency
+// (2026-09-29: PCL 246 -> 209 ms, against 132 ms for a frame cap that sleeps
+// before simulation). The present site is therefore only the fallback for a game
+// that does not call slReflexSleep; it stands down while the sleep site is live.
+// Bounded per wait. Several Present layers make the steady wait itself approach the
+// old 100 ms bound, and a new layer's NR feature creation stalls the worker for
+// ~170 ms once; both used to trip the give-up and leave the game unthrottled for the
+// rest of the session (PC latency 246 instead of ~158 ms).
+static const DWORD    kFgrThrottleMs = 250;
+static const unsigned kFgrThrottleGiveUp = 5;
+static const DWORD    kFgrThrottleRearmMs = 5000;
+static void FgRelayThrottle(unsigned site)
+{
+    FgrState &f = g_fgr;
+    const int depth = PresentAdapterRelayThrottle();
+    if (depth <= 0 || !f.cs_ready) return;
+    FgrCount(f.thr_calls[site]);
+    const LONG64 now_ms = static_cast<LONG64>(GetTickCount64());
+    if (site == kFgrAtSleep) InterlockedExchange64(&f.last_sleep_ms, now_ms);
+    else {
+        const LONG64 last_sleep = FgrCountRead64(f.last_sleep_ms);
+        if (last_sleep != 0 && now_ms - last_sleep < 500) return;
+    }
+    if (!f.ready || f.fell_back || !f.import_ok || f.thr_ev[site] == nullptr) return;
+    const LONG off_tick = InterlockedCompareExchange(&f.thr_off, 0, 0);
+    if (off_tick != 0) {
+        if (static_cast<DWORD>(GetTickCount() - static_cast<DWORD>(off_tick)) < kFgrThrottleRearmMs) return;
+        if (InterlockedCompareExchange(&f.thr_off, 0, off_tick) == off_tick) {
+            InterlockedExchange(&f.thr_streak[0], 0);
+            InterlockedExchange(&f.thr_streak[1], 0);
+            Log("[fg-relay] throttle re-armed after %lu ms.", kFgrThrottleRearmMs);
+        }
+    }
+    FgrLock();
+    ID3D12Fence *fence = f.nr_fence12;
+    const uint64_t armed_nr = f.nr_val;
+    const uint64_t queued_nr = static_cast<uint64_t>(FgrCountRead64(f.nr_queued));
+    const uint64_t newest = armed_nr < queued_nr ? armed_nr : queued_nr;
+    if (fence != nullptr) {
+        fence->AddRef();
+        // Bookkeeping for the rate log only; the wait below does not depend on it.
+        (void)FgRelayClaimCompletedGroupLocked(f.group);
+    }
+    FgrUnlock();
+    if (fence == nullptr) return;
+    const uint64_t back = static_cast<uint64_t>(depth - 1);
+    const uint64_t target = newest > back ? newest - back : 0;
+    if (target == 0 || fence->GetCompletedValue() >= target) {
+        fence->Release();
+        FgrCount(f.thr_clear[site]);
+        InterlockedExchange(&f.thr_streak[site], 0);
+        return;
+    }
+    const LONG64 start = FgrQpcNow();
+    bool done = false;
+    // The event is auto-reset and shared by every wait on this site, so a wake
+    // proves nothing: a registration left behind by an earlier timeout fires it
+    // late, and from then on every wait would return at once, one target behind,
+    // forever (2026-09-29, first sleep-site run). Only the fence value decides.
+    if (SUCCEEDED(fence->SetEventOnCompletion(target, f.thr_ev[site]))) {
+        const ULONGLONG deadline = GetTickCount64() + kFgrThrottleMs;
+        for (;;) {
+            if (fence->GetCompletedValue() >= target) { done = true; break; }
+            const ULONGLONG now = GetTickCount64();
+            if (now >= deadline) break;
+            WaitForSingleObject(f.thr_ev[site], static_cast<DWORD>(deadline - now));
+        }
+    }
+    fence->Release();
+    const LONG64 waited = FgrQpcNow() - start;
+    FgrCount(f.thr_waits[site]);
+    FgrAdd64(f.thr_sum[site], waited);
+    FgrMax64(f.thr_max, waited);
+    if (done) { InterlockedExchange(&f.thr_streak[site], 0); return; }
+    FgrCount(f.thr_timeouts[site]);
+    if (static_cast<unsigned>(InterlockedIncrement(&f.thr_streak[site])) >= kFgrThrottleGiveUp) {
+        const LONG tick = static_cast<LONG>(GetTickCount() | 1u);
+        if (InterlockedCompareExchange(&f.thr_off, tick, 0) == 0)
+            Log("[fg-relay] throttle: the NR fence missed %u consecutive %lu ms waits; the throttle stands down "
+                "for %lu ms (frames may queue ahead of the NR meanwhile).", kFgrThrottleGiveUp, kFgrThrottleMs,
+                kFgrThrottleRearmMs);
+    }
+}
+
+// Called from the interposer's vkQueuePresentKHR detour, on the thread that owns
+// the present queue, before the original runs -- the copy has to be in the queue
+// before the present operation is.
+static void FgRelayOnPresent(void *queue, const void *info_raw)
+{
+    FgrState &f = g_fgr;
+    // Reached on every present in both relay pipelines (the hook calls here
+    // whenever Pipeline=2 or 3), which is what makes this the reporting point.
+    FgRelayPeriodic();
+    if (f.cs_ready) FgrCount(f.presents);
+    FgRelayThrottle(kFgrAtPresent);
+    if (!PresentAdapterRelayAtPresent()) { FgrCount(f.p_pipeline_skip); return; }
+    if (!f.ready) { FgrCount(f.p_notready); return; }
+    if (f.fell_back) { FgrCount(f.p_fallback); return; }
+    if (!f.cs_ready) return;
+    if (!FgInputActive()) { FgrCount(f.p_inactive); return; }
+    const FgrPresentInfo *info = static_cast<const FgrPresentInfo *>(info_raw);
+    if (info == nullptr || info->swapchainCount == 0 || info->pImageIndices == nullptr) { FgrCount(f.p_noinfo); return; }
+
+    // Remember the present whatever else happens: the map from image index to
+    // back buffer handle is learned at the evaluate from it.
+    FgrLock();
+    f.have_present = true;
+    f.present_idx = info->pImageIndices[0];
+    const uint64_t back = f.present_idx < _countof(f.idx_map) ? f.idx_map[f.present_idx] : 0;
+    const bool have_last = f.have_last;
+    const DWORD age = static_cast<DWORD>(GetTickCount()) - static_cast<DWORD>(f.last_eval_tick);
+    VkmRes hud = {};
+    hud.image = f.last_hud; hud.w = f.last_w; hud.h = f.last_h; hud.fmt = f.last_fmt;
+    hud.fg_x = f.last_hud_x; hud.fg_y = f.last_hud_y;
+    const unsigned bx = f.last_back_x, by = f.last_back_y;
+    const FgGuideContract guides = f.last_guides;
+    FgrUnlock();
+
+    // Only while the game is actually evaluating frames. During menus and loads
+    // presents keep arriving with no FG groups behind them, and a copy plus NR
+    // per present would be pure cost.
+    if (!have_last || age > 400) { FgrCount(f.p_stale); return; }
+    if (back == 0) { FgrCount(f.unarmed); FgrCount(f.p_unlearned); return; }      // this index is not learned yet
+    VkmRes bk = {}; bk.image = back; bk.w = hud.w; bk.h = hud.h; bk.fmt = hud.fmt;
+    bk.fg_x = bx; bk.fg_y = by;
+    FgRelayArmCopy(queue, "present", hud, bk, guides);
+}
+
+// ---------------------------------------------------------------------------
+// The evaluate half
+// ---------------------------------------------------------------------------
+
+// The release batch: one vkCmdSetEvent, submitted with a submit-boundary wait on
+// the imported release semaphore. A semaphore wait cannot be recorded inside a
+// command buffer, which is the whole reason this exists as its own batch; the
+// park it releases is a vkCmdWaitEvents in Streamline's, and an event that is
+// already set satisfies that wait (the property the serial feed's own release
+// has relied on since fginput2).
+// Last resort for a D3D12 side that stopped signalling: the host sets the shared
+// fence to the newest value anything on the game's queue may be waiting for, so
+// the release batches and the copy batches waiting on nr_sem drain instead of
+// holding the queue until a TDR.
+static void FgRelayReleaseNrWaits()
+{
+    FgrState &f = g_fgr;
+    if (f.nr_fence12 == nullptr) return;
+    FgrLock();
+    const uint64_t newest = f.nr_val;
+    FgrUnlock();
+    if (newest != 0 && f.nr_fence12->GetCompletedValue() < newest) f.nr_fence12->Signal(newest);
+}
+
+static bool FgRelaySubmitRelease(unsigned slot, uint64_t nr_val)
+{
+    FgrState &f = g_fgr;
+    if (f.cmd_queue == nullptr) { FgrCount(f.rel_noqueue); return false; }
+    FgrPool *pool = FgRelayPoolFor(f.cmd_queue, true);
+    if (pool == nullptr || pool->cb_release[slot] == nullptr) { FgrCount(f.rel_nopool); return false; }
+    const SVkCommandBuffer cb = pool->cb_release[slot];
+    // The caller cleared release_in_flight[slot]: the fence was observed
+    // signalled, or the previous submit never entered the queue.
+    if (f.ResetFences(g_svk.dev, 1, &f.release_fence[slot]) != kSVkSuccess) { FgrCount(f.rel_resetfence); return false; }
+    if (f.ResetCommandBuffer(cb, 0) != kSVkSuccess) { FgrCount(f.rel_resetcb); return false; }
+    FgrCommandBufferBeginInfo bi = {};
+    bi.sType = kFgrStCommandBufferBegin;
+    bi.flags = kFgrCbOneTimeSubmit;
+    if (f.BeginCommandBuffer(cb, &bi) != kSVkSuccess) { FgrCount(f.rel_begin); return false; }
+    g_svk.CmdSetEvent(cb, f.ev_out[slot], kSVkStageAllCommands);
+    if (f.EndCommandBuffer(cb) != kSVkSuccess) { FgrCount(f.rel_end); return false; }
+
+    uint64_t wait_value = nr_val;
+    FgrTimelineSubmitInfo ts = {};
+    ts.sType = kFgrStTimelineSubmit;
+    ts.waitValueCount = 1;
+    ts.pWaitValues = &wait_value;
+    uint32_t stage = kSVkStageAllCommands;
+    FgrSubmitInfo si = {};
+    si.sType = kFgrStSubmitInfo;
+    si.pNext = &ts;
+    si.waitCount = 1;
+    si.pWaits = &f.nr_sem;
+    si.pWaitStages = &stage;
+    si.cbCount = 1;
+    si.pCbs = &cb;
+    const bool submitted = f.QueueSubmit(reinterpret_cast<SVkQueue>(f.cmd_queue), 1, &si, f.release_fence[slot]) == kSVkSuccess;
+    if (!submitted) FgrCount(f.rel_submit);
+    return submitted;
+}
+
+// Called from the FG-input feed's evaluate detour, under g_bridge_cs, on
+// Streamline's present thread -- the thread that owns DLSSG.CmdQueue.
+//   1  the relay recorded the park and the copy back for this frame
+//   0  the relay has nothing for this frame; the serial feed may run
+//  -1  a relay frame is in flight or the armed copy did not match; skip the frame
+static int FgRelayEvaluate(void *cmd_raw, const NVSDK_NGX_Parameter *p)
+{
+    FgrState &f = g_fgr;
+    if (!PresentAdapterRelay() || !f.cs_ready) { FgrCount(f.eval_disabled); return 0; }
+    if (f.fell_back) {
+        FgrCount(f.eval_fallback);
+        // An arm that was published as the relay stood down is consumed here so
+        // the sequence numbers converge; the worker drains it, and the serial feed
+        // below waits idle before it touches the staging images.
+        if (f.ready) { FgrLock(); f.eval_seq = f.arm_seq; FgrUnlock(); }
+        return 0;
+    }
+    FgRelayEnsure();
+    if (!f.ready) { FgrCount(f.eval_notready); return 0; }
+    FgrCount(f.evals);
+    // Capture the idx=1 group before the rest of the evaluate can yield to a
+    // subsequent native interpolation callback on an unusual scheduling path.
+    const uint64_t group_serial = FgRelayCurrentGroupSerial();
+
+    if (p != nullptr) {
+        void *q = nullptr;
+        if (p->Get("DLSSG.CmdQueue", &q) == NGX_SUCCESS && q != nullptr) f.cmd_queue = q;
+    }
+
+    // A park whose release never arrived is a hang, and the release lives on the
+    // D3D12 queue now. If the shared fence is behind the last release and has not
+    // moved for well past any legitimate NR, release every park and every GPU
+    // wait by hand and stand the relay down; the serial feed's own releases are
+    // unaffected. Measured from the fence's last progress, not from the last
+    // release: frames keep being armed while the copies wait on the GPU, so a
+    // fresh release every frame says nothing about the D3D12 side.
+    bool nr_stalled = false;
+    if (f.import_ok && f.nr_fence12 != nullptr && f.last_release_nr != 0) {
+        const uint64_t done = f.nr_fence12->GetCompletedValue();
+        const LONG now = static_cast<LONG>(GetTickCount());
+        if (done >= f.last_release_nr || done != f.nr_progress_value) {
+            f.nr_progress_value = done;
+            f.nr_progress_tick = now;
+        } else nr_stalled = static_cast<DWORD>(now - f.nr_progress_tick) > 1500;
+    }
+    if (nr_stalled) {
+        Log("[fg-recovery] stall snapshot: queue=%p nr-done=%llu nr-target=%llu copy-done=%llu copy-target=%llu "
+            "arm=%ld worker=%ld eval=%ld worker-idle=%u.", f.cmd_queue,
+            f.nr_fence12 != nullptr ? f.nr_fence12->GetCompletedValue() : 0, f.last_release_nr,
+            f.copy_fence12 != nullptr ? f.copy_fence12->GetCompletedValue() : 0, f.copy_val,
+            f.arm_seq, f.worker_seq, f.eval_seq,
+            g_vkm.idle == nullptr || WaitForSingleObject(g_vkm.idle, 0) == WAIT_OBJECT_0 ? 1u : 0u);
+        FgrLock();
+        for (unsigned i = 0; i < kFgrSlots; ++i)
+            if (f.ev_out[i] != 0 && g_svk.EvSet != nullptr) g_svk.EvSet(g_svk.dev, f.ev_out[i]);
+        FgrUnlock();
+        FgRelayReleaseNrWaits();
+        FgrCount(f.eval_watchdog);
+        // This is loss of completion proof, not a transient input shape. Do not
+        // resume the serial writer over resources the private GPU may still use.
+        FgRelayFallback("a relay frame's release did not arrive within 1.5 s");
+        FgInputRefuse("the relay GPU completion fence stopped advancing; NR is paused and in-flight resources remain protected");
+        f.recovery_pending = true;
+        g_fg_input.want_release = true;
+        Log("[fg-recovery] automatic retirement requested; GPU completion must be proven before rebuilding.");
+        return -1;
+    }
+
+    const char *why = nullptr;
+    VkmRes hud = {}, back = {};
+    FgGuideContract guides = {};
+    const bool have = FgInputReadColor(p, &hud, &back, &why) && FgGuideRead(p, back, &guides, &why);
+    const VkmRes &dep = guides.depth.resource, &mvv = guides.mv.resource;
+    if (have) {
+        // FG can pause while the window is minimized without destroying its
+        // feature. A resumed frame must not inherit a history from seconds ago.
+        if (f.last_eval_tick != 0 && static_cast<DWORD>(GetTickCount() - f.last_eval_tick) > 250)
+            FgGuideRequestReset();
+        if (FgInputShapeChanged(back, guides)) FgInputRequestRebuild();
+        // Learned on every evaluate, armed or not: the present hook needs the
+        // handles and the image-index map before it can arm the first frame.
+        FgrLock();
+        f.have_last = true;
+        f.last_hud = hud.image;
+        f.last_hud_x = hud.fg_x; f.last_hud_y = hud.fg_y;
+        f.last_back_x = back.fg_x; f.last_back_y = back.fg_y;
+        f.last_w = back.w; f.last_h = back.h; f.last_fmt = back.fmt;
+        f.last_guides = guides;
+        f.last_eval_tick = static_cast<LONG>(GetTickCount());
+        if (f.have_present && f.present_idx < _countof(f.idx_map)) {
+            if (f.idx_map[f.present_idx] != 0 && f.idx_map[f.present_idx] != back.image) FgrCount(f.idx_conflicts);
+            f.idx_map[f.present_idx] = back.image;
+        }
+        FgrUnlock();
+    } else {
+        FgGuidePause(why != nullptr ? why : "FG inputs unavailable");
+        FgrLock(); f.have_last = false; FgrUnlock();
+    }
+
+    LONG arm_seq = InterlockedCompareExchange(&f.arm_seq, 0, 0);
+    LONG eval_seq = InterlockedCompareExchange(&f.eval_seq, 0, 0);
+
+    FgrArm a = {};
+    bool armed = false;
+    if (arm_seq != eval_seq) {
+        // A copy was submitted for this frame. Consume it whether or not it can
+        // be used, so a mismatch cannot be consumed twice.
+        FgrCount(f.eval_consume);
+        FgrLock();
+        const unsigned slot = static_cast<unsigned>(InterlockedCompareExchange(&f.pending_slot, 0, 0));
+        a = f.arm[slot];
+        a.slot = slot;
+        f.eval_seq = arm_seq;
+        FgrUnlock();
+        if (a.valid) {
+            const LONG64 arm_to_eval_ticks = FgrQpcNow() - a.tick;
+            FgrAdd64(f.arm2eval_sum, arm_to_eval_ticks);
+            FgrCount(f.arm2eval_n);
+            FgrMax64(f.arm2eval_max, arm_to_eval_ticks);
+        }
+        armed = a.valid;
+    } else if (PresentAdapterRelayAtEvaluate()) {
+        if (!have) FgrCount(f.eval_noinput);
+        else if (f.cmd_queue == nullptr) FgrCount(f.eval_noqueue);
+        else {
+            // Pipeline=2: the copy happens here, on the queue this thread owns, and
+            // the frame is armed with the handles the evaluate itself carries.
+            FgrCount(f.eval_inplace);
+            if (FgRelayArmCopy(f.cmd_queue, "evaluate", hud, back, guides)) {
+                FgrCount(f.eval_inplace_ok);
+                arm_seq = InterlockedCompareExchange(&f.arm_seq, 0, 0);
+                FgrLock();
+                const unsigned slot = static_cast<unsigned>(InterlockedCompareExchange(&f.pending_slot, 0, 0));
+                a = f.arm[slot];
+                a.slot = slot;
+                f.eval_seq = arm_seq;
+                FgrUnlock();
+                armed = a.valid;
+            }
+        }
+    }
+
+    // flips counts groups whose NR state differs from the group before: a group
+    // served with NR followed by one on the game's own image, or the reverse.
+    auto note_group = [&f](bool served) {
+        if (f.have_last_group && f.last_group_served != served) FgrCount(f.flips);
+        f.have_last_group = true;
+        f.last_group_served = served;
+    };
+
+    if (!armed) {
+        // Once the relay is open it owns every frame: the serial feed writes the
+        // same contract and staging images the worker may be using for an armed
+        // frame, so it must not run alongside. A frame the relay could not arm
+        // is frame generation's own image for one group, and is counted. Missing
+        // or transitioning inputs never turn this into a permanent serial path.
+        note_group(false);
+        const LONG unarmed = FgrCount(f.unarmed);
+        FgrCount(f.eval_unarmed);
+        if (unarmed <= 3 || unarmed % 600 == 0)
+            Log("[fg-relay] frame not armed (unarmed=%u skipped=%u busy=%u): FG runs on the game's own image this group.",
+                static_cast<unsigned>(unarmed), static_cast<unsigned>(FgrCountRead(f.skipped)),
+                static_cast<unsigned>(FgrCountRead(f.busy)));
+        ++f.unarmed_streak;
+        FgGuideRequestReset();
+        return -1;
+    }
+    f.unarmed_streak = 0;
+
+    // From here on the arm is consumed. A frame that cannot record its park frees
+    // the slot again: no command buffer will ever set its ev_mark.
+    const unsigned slot = a.slot;
+    auto drop_slot = [&]() { FgrLock(); f.slot_used[slot] = false; FgrUnlock(); };
+
+    if (!have || g_fg_input.want_release || hud.image != a.hud || back.image != a.back || dep.image != a.depth ||
+        mvv.image != a.mv || back.w != a.w || back.h != a.h || back.fmt != a.vk_fmt ||
+        hud.fg_x != a.hud_x || hud.fg_y != a.hud_y || back.fg_x != a.back_x || back.fg_y != a.back_y ||
+        !FgGuideSameContract(a.guides, guides)) {
+        note_group(false);
+        const LONG mismatched = FgrCount(f.mismatched);
+        drop_slot();
+        if (mismatched <= 3)
+            Log("[fg-relay] armed copy does not match this evaluate: hud %llx/%llx back %llx/%llx depth %llx/%llx mv %llx/%llx.",
+                a.hud, hud.image, a.back, back.image, a.depth, dep.image, a.mv, mvv.image);
+        ++f.mismatch_streak;
+        FgGuideRequestReset();
+        return -1;
+    }
+    f.mismatch_streak = 0;
+    // Bind this evaluate's release to the real native group observed by fg-input.
+    // A missing serial leaves the existing relay behavior unchanged.
+    a.group_serial = group_serial;
+
+    // The slot's release batch is re-recorded when the slot comes round again, so
+    // its previous release must be over before its fence is touched. A failed
+    // submit left nothing in flight, so it retries here instead of blocking.
+    if (f.import_ok && f.release_in_flight[slot]) {
+        if (f.GetFenceStatus(g_svk.dev, f.release_fence[slot]) != kSVkSuccess) {
+            note_group(false);
+            FgrCount(f.busy);
+            FgrCount(f.eval_relbusy);
+            drop_slot();
+            return -1;
+        }
+        f.release_in_flight[slot] = false;
+    }
+
+    // The park. The slot's events were reset at the arm, before the worker was
+    // woken; an event that is already set satisfies this wait, so the host-side
+    // release may run before or after this is recorded.
+    SVkCommandBuffer cb = reinterpret_cast<SVkCommandBuffer>(cmd_raw);
+    {
+        SVkMemoryBarrier mb = {};
+        mb.sType = kSVkStMemoryBarrier;
+        mb.srcAccessMask = kSVkAccessMemoryRead | kSVkAccessMemoryWrite;
+        mb.dstAccessMask = kSVkAccessMemoryRead | kSVkAccessMemoryWrite;
+        const SVkHandle ev = f.ev_out[slot];
+        g_svk.CmdWaitEvents(cb, 1, &ev, kSVkStageHost, kSVkStageAllCommands, 1, &mb, 0, nullptr, 0, nullptr);
+    }
+    // ev_mark is set right after the park: the next frame that wants this slot
+    // proves the park passed before it may reset the events again.
+    g_svk.CmdSetEvent(cb, f.ev_mark[slot], kSVkStageAllCommands);
+    if (g_cfg.stage >= 3) {
+        SynthVkBarrier(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+        SynthVkBarrier(cb, g_svk.img[kOutB], kSVkLayoutGeneral, kSVkLayoutTransferSrc);
+        SynthVkBarrier(cb, hud.image, kSVkLayoutGeneral, kSVkLayoutTransferDst);
+        SynthVkBarrier(cb, back.image, kSVkLayoutGeneral, kSVkLayoutTransferDst);
+        FgColorCopy(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutTransferSrc, hud.image, kSVkLayoutTransferDst, 0, 0, hud.fg_x, hud.fg_y, back.w, back.h);
+        FgColorCopy(cb, g_svk.img[kOutB], kSVkLayoutTransferSrc, back.image, kSVkLayoutTransferDst, 0, 0, back.fg_x, back.fg_y, back.w, back.h);
+        SynthVkBarrier(cb, hud.image, kSVkLayoutTransferDst, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, back.image, kSVkLayoutTransferDst, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, g_svk.img[SLOT_OUTPUT], kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+        SynthVkBarrier(cb, g_svk.img[kOutB], kSVkLayoutTransferSrc, kSVkLayoutGeneral);
+    }
+
+    if (f.import_ok) {
+        if (FgRelaySubmitRelease(slot, a.nr_val)) {
+            FgrCount(f.rel_ok);
+            f.release_in_flight[slot] = true;
+            // The first release of a session arms the watchdog, so its clock
+            // starts here. The session release zeroes last_release_nr but not the
+            // tick, and a tick left from before a hook-point switch read as a
+            // fence stalled for the whole time the relay was closed (2026-09-29:
+            // the relay stood down 0.2 s after reopening).
+            if (f.last_release_nr == 0) {
+                f.nr_progress_value = f.nr_fence12 != nullptr ? f.nr_fence12->GetCompletedValue() : 0;
+                f.nr_progress_tick = static_cast<LONG>(GetTickCount());
+            }
+            f.last_release_nr = a.nr_val;
+            FgRelayPublishGroupRelease(a.group_serial, a.nr_val);
+        } else {
+            FgrCount(f.rel_fail);
+            // The park is recorded and nothing on the GPU will release it: let it
+            // through now (this frame may be torn) rather than hang the queue.
+            FgrLock();
+            if (g_svk.EvSet != nullptr) g_svk.EvSet(g_svk.dev, f.ev_out[slot]);
+            FgrUnlock();
+            Log("[fg-relay] release batch could not be submitted; the park was released by the host.");
+        }
+    }
+    note_group(true);
+    if (g_present_adapter.remaining != 0) --g_present_adapter.remaining;
+    const unsigned armed_total = static_cast<unsigned>(FgrCountRead(f.armed));
+    if (armed_total <= 3 || armed_total % 1800 == 0)
+        Log("[fg-relay] evaluate: slot=%u nr=%llu import=%d stage=%d.",
+            slot, a.nr_val, f.import_ok ? 1 : 0, g_cfg.stage);
+    return 1;
+}
+
+// ---------------------------------------------------------------------------
+// The worker half
+// ---------------------------------------------------------------------------
+
+// Read by the worker loop before it polls the serial feed's ev_in: a relay frame
+// has no ev_in, its completion order is the copy fence / the shared semaphore.
+// Deliberately not gated on fell_back: a frame armed before the relay stood down
+// still has to be consumed, or idle would never be set again and the serial feed
+// would refuse on its own idle wait.
+static bool FgRelayPending()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready || !f.ready) return false;
+    return InterlockedCompareExchange(&f.arm_seq, 0, 0) != InterlockedCompareExchange(&f.worker_seq, 0, 0);
+}
+
+// One relay frame, on the worker thread. The NR is queued and the release is
+// signalled; nothing here waits for the GPU when the import is live, which is
+// what makes the release fire the moment the D3D12 work completes instead of the
+// moment a host thread notices.
+static bool FgRelayWorker()
+{
+    FgrState &f = g_fgr;
+    const LONG64 work_start = FgrQpcNow();
+    FgrCount(f.w_plays);
+    const LONG seq = InterlockedCompareExchange(&f.arm_seq, 0, 0);
+    FgrLock();
+    const unsigned slot = static_cast<unsigned>(InterlockedCompareExchange(&f.pending_slot, 0, 0));
+    const FgrArm a = f.arm[slot];
+    f.worker_seq = seq;
+    FgrUnlock();
+
+    if (a.valid) {
+        const LONG64 arm_to_work_ticks = FgrQpcNow() - a.tick;
+        FgrAdd64(f.arm2work_sum, arm_to_work_ticks);
+        FgrCount(f.arm2work_n);
+        FgrMax64(f.arm2work_max, arm_to_work_ticks);
+    }
+
+    // The private device has to see the copies completed before it reads the
+    // staging images. With the import live this is a wait the queue performs;
+    // without it, a bounded host wait on the same fence the GPU would have
+    // waited -- the copies are sub-millisecond work, so the wait is short by
+    // construction and is bounded anyway. A copy that has not landed in time is
+    // treated as a failed frame: nothing is read from it.
+    const LONG64 copy_wait_start = FgrQpcNow();
+    bool copy_seen = true;
+    if (f.import_ok && f.copy_fence12 != nullptr)
+        g_s12.queue->Wait(f.copy_fence12, a.copy_val);
+    else if (f.WaitForFences != nullptr && f.copy_fence[slot] != 0)
+        copy_seen = f.WaitForFences(g_svk.dev, 1, &f.copy_fence[slot], 1, 250ull * 1000000ull) == kSVkSuccess;
+    const LONG64 copy_wait_ticks = FgrQpcNow() - copy_wait_start;
+    FgrAdd64(f.copywait_sum, copy_wait_ticks);
+    FgrCount(f.copywait_n);
+    FgrMax64(f.copywait_max, copy_wait_ticks);
+
+    bool ok = false, nr_absent = false, wrote = false;
+    unsigned nr_entries = 0, sr_entries = 0, sr_copies = 0;
+    if (!copy_seen) {
+        FgrCount(f.copies_failed);
+        FgrCount(f.w_copy_fail);
+    } else if (g_present_adapter.run_nr) {
+        g_present_nr_entries = g_present_sr_entries = g_present_sr_copies = 0;
+        {
+            if (g_ngx_cs_ready) EnterCriticalSection(&g_ngx_cs);
+            PresentAdapterNrScope scope;
+            // No trailing wait: the release is signalled by the queue below and the
+            // next frame's Synth12Begin waits the allocator's retire fence, which is
+            // this submission's own fence value.
+            ok = Synth12EvaluateShared(&g_vkm.sp, kVkmEvaluateMs, SLOT_OUTPUT, &wrote, false);
+            if (g_ngx_cs_ready) LeaveCriticalSection(&g_ngx_cs);
+        }
+        nr_entries = g_present_nr_entries; sr_entries = g_present_sr_entries; sr_copies = g_present_sr_copies;
+        PresentCompatibilityFrame(ok, nr_entries, sr_entries, sr_copies);
+        if (ok && (sr_entries != 1 || sr_copies != 1)) {
+            Log("[fg-relay] carrier contract mismatch: sr_entries=%u sr_copies=%u; frame not written.", sr_entries, sr_copies);
+            ok = false;
+        }
+        if (ok && nr_entries == 0) { nr_absent = true; ++g_fg_input.skipped_nr; FgrCount(f.w_nr_absent); FgGuideRequestReset(); }
+        if (ok && !nr_absent) ok = FgCompositeRun(g_s12.queue, kVkmEvaluateMs, false);
+    } else ok = PresentAdapterCopy12();
+    ok = ok && g_s12.dev->GetDeviceRemovedReason() == S_OK;
+    if (!ok) {
+        FgGuideRequestReset();
+        // Keep the carriers equal to their inputs so the copy back already
+        // recorded in the game's command buffer is a no-op.
+        if (!FgIdentityCopy(kVkmEvaluateMs))
+            Log("[fg-relay] identity fallback copy not confirmed within %lu ms.", kVkmEvaluateMs);
+    }
+
+    // Signalled on every path. A frame whose NR failed still has a command
+    // buffer parked on this value, and the identity copy above is what makes
+    // letting it through harmless.
+    if (f.nr_fence12 != nullptr) {
+        g_s12.queue->Signal(f.nr_fence12, a.nr_val);
+        // Published after the Signal is queued: the throttle may wait for it now.
+        if (static_cast<LONG64>(a.nr_val) > FgrCountRead64(f.nr_queued))
+            InterlockedExchange64(&f.nr_queued, static_cast<LONG64>(a.nr_val));
+    }
+    if (!f.import_ok) {
+        // No shared object to signal through: the CPU stands in, waiting the
+        // session's own fences -- the composite's, then the NR submission's --
+        // and setting the park's event afterwards. Still no ev_in polling and no
+        // dependency on the game's queue having reached anything.
+        FgCompositeWait(kVkmEvaluateMs);
+        Synth12Drain(kVkmEvaluateMs);
+        if (g_svk.EvSet != nullptr) g_svk.EvSet(g_svk.dev, f.ev_out[slot]);
+    }
+
+    FgrLock();
+    if (ok && wrote) FgrCount(f.writes);
+    const unsigned n = static_cast<unsigned>(FgrCountRead(f.armed));
+    FgrUnlock();
+    if (ok) FgrCount(f.w_ok); else FgrCount(f.w_fail);
+    const LONG64 work_ticks = FgrQpcNow() - work_start;
+    FgrAdd64(f.work_sum, work_ticks);
+    FgrCount(f.work_n);
+    FgrMax64(f.work_max, work_ticks);
+    if (n <= 3 || n % 1800 == 0 || !ok)
+        Log("[fg-relay] frame=%u slot=%u nr=%llu ok=%d wrote=%d nr_entries=%u import=%d "
+            "armed=%u skipped=%u busy=%u mismatch=%u conflicts=%u.",
+            n, slot, a.nr_val, ok ? 1 : 0, wrote ? 1 : 0, nr_entries, f.import_ok ? 1 : 0,
+            static_cast<unsigned>(FgrCountRead(f.armed)), static_cast<unsigned>(FgrCountRead(f.skipped)),
+            static_cast<unsigned>(FgrCountRead(f.busy)), static_cast<unsigned>(FgrCountRead(f.mismatched)),
+            static_cast<unsigned>(FgrCountRead(f.idx_conflicts)));
+    return ok;
+}
+
+// ---------------------------------------------------------------------------
+// Session lifetime
+// ---------------------------------------------------------------------------
+
+// The release paths tear the private session down; a relay frame that is still
+// armed or still being consumed owns images and a parked command buffer, so the
+// release has to refuse rather than race it. Same answer the serial feed gives
+// when its own park has not cleared.
+static bool FgRelayPrepareRelease()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready) return true;
+    InterlockedExchange(&f.releasing, 1);
+    if (InterlockedCompareExchange(&f.arm_active, 0, 0) != 0) return false;
+    FgrLock();
+    if (f.arm_seq != f.eval_seq) {
+        // The arm has a submitted copy and may have queued NR, but no evaluate
+        // has recorded a park. Its worker still consumes/signals normally.
+        const unsigned slot = static_cast<unsigned>(f.pending_slot);
+        if (slot < kFgrSlots) f.slot_used[slot] = false;
+        f.eval_seq = f.arm_seq;
+    }
+    FgrUnlock();
+    return true;
+}
+
+// Runtime teardown may stop the worker before it consumes an armed copy. Stop
+// the producers first, so its fence value cannot change after the worker joins.
+static bool FgRelayStopArmingForShutdown()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready) return true;
+    InterlockedExchange(&f.releasing, 1);
+    const ULONGLONG deadline = GetTickCount64() + 2000;
+    while (InterlockedCompareExchange(&f.arm_active, 0, 0) != 0) {
+        if (GetTickCount64() >= deadline) {
+            Log("[fg-relay] shutdown could not retire an active copy recorder; shared resources must remain alive.");
+            return false;
+        }
+        Sleep(1);
+    }
+    // ReShade can destroy several startup runtimes before the bridge has ever
+    // opened a Vulkan transport. That teardown returns early on a null device
+    // and therefore cannot run OnSessionRelease. Do not leave its arm gate
+    // latched over a future first session. Partial creates and real objects
+    // keep the gate until the normal, proven-idle resource release.
+    FgrLock();
+    bool empty = !f.ready && !f.tried && f.dev == nullptr && f.npools == 0 &&
+        f.copy_sem == 0 && f.nr_sem == 0 && f.copy_fence12 == nullptr && f.nr_fence12 == nullptr &&
+        f.copy_sem_handle == nullptr && f.nr_fence_handle == nullptr && f.nr_ev == nullptr &&
+        f.arm_seq == 0 && f.worker_seq == 0 && f.eval_seq == 0;
+    for (unsigned i = 0; empty && i < kFgrSlots; ++i)
+        empty = f.copy_fence[i] == 0 && f.release_fence[i] == 0 && f.ev_out[i] == 0 && f.ev_mark[i] == 0 &&
+            !f.copy_in_flight[i] && !f.release_in_flight[i] && !f.slot_used[i];
+    if (empty) InterlockedExchange(&f.releasing, 0);
+    FgrUnlock();
+    if (empty) Log("[fg-relay] shutdown has no relay session or GPU objects; the next runtime can open its first relay.");
+    return true;
+}
+
+// The worker has joined before this is called. A queued NR may still execute on
+// D3D12; drain it before host-signalling a value for an arm the stopped worker
+// never consumed. Otherwise releasing the game can race a live composite.
+static bool FgRelayFinishWorkerShutdown()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready) return true;
+    if (InterlockedCompareExchange(&f.arm_active, 0, 0) != 0) return false;
+    if (!FgCompositeWait(4000) || !Synth12Drain(4000)) {
+        Log("[fg-relay] shutdown could not drain private GPU work; outstanding GPU dependencies and resources are retained.");
+        return false;
+    }
+    FgRelayReleaseNrWaits();
+    FgRelayForceReleaseParks();
+    return true;
+}
+
+static bool FgRelayIdleForRelease()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready || !f.ready) return true;
+    const LONG armed = InterlockedCompareExchange(&f.arm_seq, 0, 0);
+    if (armed != InterlockedCompareExchange(&f.worker_seq, 0, 0) ||
+        armed != InterlockedCompareExchange(&f.eval_seq, 0, 0)) return false;
+    for (unsigned i = 0; i < kFgrSlots; ++i)
+        if (f.slot_used[i] && (g_svk.EvStatus == nullptr ||
+            g_svk.EvStatus(g_svk.dev, f.ev_mark[i]) != kSVkEventSet)) return false;
+    return true;
+}
+
+// Render-thread poll under g_bridge_cs. The completion marker is submitted
+// after the CPU worker has finished enqueueing all work. Unlike nr_fence12,
+// this fence is never signalled by the host, so emergency park release cannot
+// make it look complete while D3D12 still owns the shared images.
+static bool FgRelayRecoveryReady()
+{
+    FgrState &f = g_fgr;
+    if (!f.recovery_pending) return true;
+    if (InterlockedCompareExchange(&f.arm_active, 0, 0) != 0 ||
+        f.arm_seq != f.worker_seq || f.arm_seq != f.eval_seq ||
+        (g_vkm.idle != nullptr && WaitForSingleObject(g_vkm.idle, 0) != WAIT_OBJECT_0)) return false;
+    if (g_s12.dev == nullptr || g_s12.queue == nullptr ||
+        g_s12.dev->GetDeviceRemovedReason() != S_OK || g_s12.resources_retained) return false;
+    if (f.recovery_marker == nullptr && FAILED(g_s12.dev->CreateFence(0, D3D12_FENCE_FLAG_NONE,
+        __uuidof(ID3D12Fence), reinterpret_cast<void **>(&f.recovery_marker)))) return false;
+    if (!f.recovery_marker_submitted) {
+        if (FAILED(g_s12.queue->Signal(f.recovery_marker, 1))) return false;
+        f.recovery_marker_submitted = true;
+        return false;
+    }
+    const UINT64 done = f.recovery_marker->GetCompletedValue();
+    if (done == UINT64_MAX || done < 1) return false;
+    if (!FgRelayIdleForRelease()) return false;
+    for (unsigned i = 0; i < kFgrSlots; ++i) {
+        if ((f.copy_in_flight[i] && (f.GetFenceStatus == nullptr || f.GetFenceStatus(g_svk.dev, f.copy_fence[i]) != kSVkSuccess)) ||
+            (f.release_in_flight[i] && (f.GetFenceStatus == nullptr || f.GetFenceStatus(g_svk.dev, f.release_fence[i]) != kSVkSuccess))) return false;
+    }
+    return true;
+}
+
+// Every relay park released by hand. Only for the shutdown path, where the worker
+// that would release them is about to be joined and the command buffer parked on
+// an event is the game's own.
+static void FgRelayForceReleaseParks()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready || g_svk.EvSet == nullptr || g_svk.dev == nullptr) return;
+    FgrLock();
+    for (unsigned i = 0; i < kFgrSlots; ++i)
+        if (f.ev_out[i] != 0) g_svk.EvSet(g_svk.dev, f.ev_out[i]);
+    FgrUnlock();
+}
+
+static void FgRelayOnSessionRelease()
+{
+    FgrState &f = g_fgr;
+    if (!f.cs_ready) return;
+    // FgInputRelease has observed worker idle, proved each recorded park was
+    // submitted, drained D3D12, and idled the VkDevice on the render thread. All
+    // parks/copies are now retired, so
+    // destroy their objects instead of leaking another ring after each resize.
+    FgrLock();
+    f.ready = false;
+    auto get_proc = g_svk.lib != nullptr ? reinterpret_cast<PFN_SVkGetDeviceProcAddr>(
+        GetProcAddress(g_svk.lib, "vkGetDeviceProcAddr")) : nullptr;
+    using Destroy = void (*)(SVkDevice, SVkHandle, const void *);
+    if (get_proc != nullptr && g_svk.dev != nullptr) {
+        auto destroy_semaphore = reinterpret_cast<Destroy>(get_proc(g_svk.dev, "vkDestroySemaphore"));
+        auto destroy_fence = reinterpret_cast<Destroy>(get_proc(g_svk.dev, "vkDestroyFence"));
+        auto destroy_event = reinterpret_cast<Destroy>(get_proc(g_svk.dev, "vkDestroyEvent"));
+        auto destroy_pool = reinterpret_cast<Destroy>(get_proc(g_svk.dev, "vkDestroyCommandPool"));
+        for (unsigned i = 0; i < kFgrSlots; ++i) {
+            if (destroy_fence != nullptr && f.copy_fence[i]) destroy_fence(g_svk.dev, f.copy_fence[i], nullptr);
+            if (destroy_fence != nullptr && f.release_fence[i]) destroy_fence(g_svk.dev, f.release_fence[i], nullptr);
+            if (destroy_event != nullptr && f.ev_out[i]) destroy_event(g_svk.dev, f.ev_out[i], nullptr);
+            if (destroy_event != nullptr && f.ev_mark[i]) destroy_event(g_svk.dev, f.ev_mark[i], nullptr);
+            f.copy_fence[i] = f.release_fence[i] = f.ev_out[i] = f.ev_mark[i] = 0;
+        }
+        for (unsigned i = 0; i < f.npools; ++i)
+            if (destroy_pool != nullptr && f.pools[i].pool) destroy_pool(g_svk.dev, f.pools[i].pool, nullptr);
+        if (destroy_semaphore != nullptr && f.copy_sem) destroy_semaphore(g_svk.dev, f.copy_sem, nullptr);
+        if (destroy_semaphore != nullptr && f.nr_sem) destroy_semaphore(g_svk.dev, f.nr_sem, nullptr);
+    }
+    f.copy_sem = f.nr_sem = 0;
+    if (f.copy_sem_handle != nullptr) { CloseHandle(f.copy_sem_handle); f.copy_sem_handle = nullptr; }
+    if (f.nr_fence_handle != nullptr) { CloseHandle(f.nr_fence_handle); f.nr_fence_handle = nullptr; }
+    if (f.nr_ev != nullptr) { CloseHandle(f.nr_ev); f.nr_ev = nullptr; }
+    f.tried = false;
+    InterlockedExchange(&f.releasing, 0);
+    f.fell_back = false;
+    if (f.recovery_pending) Log("[fg-recovery] old GPU work retired; the next valid FG input rebuilds NR automatically.");
+    f.recovery_pending = f.recovery_marker_submitted = false;
+    if (f.recovery_marker != nullptr) { f.recovery_marker->Release(); f.recovery_marker = nullptr; }
+    f.import_ok = false;
+    f.why = nullptr;
+    f.have_last = false;
+    f.have_present = false;
+    memset(f.idx_map, 0, sizeof(f.idx_map));
+    f.arm_seq = f.worker_seq = f.eval_seq = 0;
+    for (unsigned i = 0; i < kFgrSlots; ++i) { f.slot_used[i] = false; f.arm[i].valid = false; }
+    f.npools = 0;
+    memset(f.pools, 0, sizeof(f.pools));
+    f.cmd_queue = nullptr;
+    f.copy_val = f.nr_val = f.last_release_nr = f.nr_progress_value = 0; InterlockedExchange64(&f.nr_queued, 0);
+    for (unsigned i = 0; i < kFgrSlots; ++i) {
+        f.copy_in_flight[i] = f.release_in_flight[i] = false;
+        InterlockedExchange64(&f.copy_submit_qpc[i], 0);
+    }
+    f.have_last_group = false;
+    f.group = {};
+    f.mismatch_streak = 0;
+    f.unarmed_streak = 0;
+    f.last_eval_tick = 0;
+    InterlockedExchange(&f.thr_off, 0);
+    for (unsigned i = 0; i < 2; ++i)
+        InterlockedExchange(&f.thr_streak[i], 0);
+    FgGuideRequestReset();
+    if (f.copy_fence12 != nullptr) { f.copy_fence12->Release(); f.copy_fence12 = nullptr; }
+    if (f.nr_fence12 != nullptr) { f.nr_fence12->Release(); f.nr_fence12 = nullptr; }
+    f.dev = nullptr;
+    FgrUnlock();
+}
diff --git b/src/fg-submit-observation.h b/src/fg-submit-observation.h
new file mode 100644
index 0000000000000000000000000000000000000000..da3690fab863b444e3aa1053570535811e9f3898
--- /dev/null
+++ b/src/fg-submit-observation.h
@@ -0,0 +1,263 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// CPU evidence only. The caller serializes access; this type never calls an API,
+// allocates, logs, waits, or treats missing ReShade events as an empty recording.
+namespace fg_submit_observation {
+
+constexpr unsigned kSamples = 8;
+constexpr unsigned kCommandLists = 512;
+constexpr unsigned kLocations = 8;
+enum class Command : unsigned { dispatch, copy, barrier, draw, secondary, indirect, clear, render_pass, bind, query, count };
+enum class Coverage : unsigned { untracked, init_only, begin_observed, partial };
+enum class State : unsigned { pending, in_submit, returned, reset, destroyed, reinitialized, device_destroyed };
+
+inline void Add(uint64_t &value, uint64_t count = 1)
+{
+    const uint64_t max = ~uint64_t(0);
+    value = count > max - value ? max : value + count;
+}
+
+struct Counts {
+    uint64_t kind[static_cast<unsigned>(Command::count)]{};
+    uint64_t total = 0;
+};
+struct Images { uint64_t hud = 0, back = 0, depth = 0, mv = 0; unsigned known = 0; };
+struct Sample {
+    uint64_t id = 0, cb = 0, generation = 0, eval_queue = 0, qpc = 0;
+    Images images{};
+    Counts prefix{};
+    Coverage coverage = Coverage::untracked;
+    State state = State::pending;
+    unsigned index = 0;
+    bool indexed = false;
+};
+struct Location { uint32_t batch = 0, cb_index = 0, batch_cbs = 0, waits = 0, signals = 0; };
+struct Match {
+    Sample sample{};
+    Location locations[kLocations]{};
+    uint64_t occurrences = 0, omitted_locations = 0, submit_generation = 0;
+    unsigned stored = 0;
+    bool claimed = false, generation_changed = false;
+};
+struct Submit {
+    uint64_t id = 0, queue = 0, fence = 0;
+    uint64_t batches_read = 0, cbs_read = 0, waits = 0, signals = 0, declared_cbs = 0, read_faults = 0;
+    Match matches[kSamples]{};
+    uint32_t batches = 0, result = 0;
+    unsigned candidates = 0;
+    bool submit2 = false;
+};
+struct Stats {
+    uint64_t inits = 0, resets = 0, destroys = 0, device_destroys = 0;
+    uint64_t events = 0, partial_starts = 0, capacity_misses = 0, generation_exhausted = 0;
+    uint64_t firsts = 0, prefixes = 0, untracked_firsts = 0, partial_firsts = 0, invalidated = 0;
+    uint64_t submits = 0, submits2 = 0, nested_suppressed = 0, batches = 0, cbs = 0, read_faults = 0;
+    uint64_t returned = 0, handle_only = 0, duplicate_occurrences = 0, omitted_locations = 0, failed_results = 0;
+};
+
+class Observer {
+    struct Entry {
+        uint64_t cb = 0, device = 0, generation = 0;
+        Counts commands{};
+        Coverage coverage = Coverage::untracked;
+        bool used = false; // A cleared, previously used slot is a probe-chain tombstone.
+    };
+    Entry entries_[kCommandLists]{};
+    Sample samples_[kSamples]{};
+    uint64_t generation_ = 0;
+    unsigned sample_count_ = 0;
+    Stats stats_{};
+
+    static unsigned Hash(uint64_t cb) { return static_cast<unsigned>((cb >> 4) ^ (cb >> 32)) % kCommandLists; }
+    Entry *Find(uint64_t cb)
+    {
+        if (cb == 0) return nullptr;
+        for (unsigned n = 0, i = Hash(cb); n < kCommandLists; ++n, i = (i + 1) % kCommandLists) {
+            Entry &e = entries_[i];
+            if (e.cb == cb) return &e;
+            if (!e.used) break;
+        }
+        return nullptr;
+    }
+    Entry *Acquire(uint64_t cb)
+    {
+        if (cb == 0) return nullptr;
+        Entry *free = nullptr;
+        for (unsigned n = 0, i = Hash(cb); n < kCommandLists; ++n, i = (i + 1) % kCommandLists) {
+            Entry &e = entries_[i];
+            if (e.cb == cb) return &e;
+            if (e.cb == 0 && free == nullptr) free = &e;
+            if (!e.used) break;
+        }
+        if (free == nullptr) { Add(stats_.capacity_misses); return nullptr; }
+        *free = {};
+        free->used = true;
+        free->cb = cb;
+        return free;
+    }
+    uint64_t NextGeneration()
+    {
+        // Never wrap into an old recording identity, including after destruction.
+        if (generation_ == ~uint64_t(0)) { Add(stats_.generation_exhausted); return 0; }
+        return ++generation_;
+    }
+    void Invalidate(uint64_t cb, State state)
+    {
+        for (unsigned i = 0; i < sample_count_; ++i) {
+            Sample &s = samples_[i];
+            if (s.cb == cb && (s.state == State::pending || s.state == State::in_submit)) {
+                s.state = state;
+                Add(stats_.invalidated);
+            }
+        }
+    }
+    void Start(uint64_t cb, uint64_t device, Coverage coverage, State reason)
+    {
+        if (cb == 0) return;
+        Invalidate(cb, reason);
+        Entry *e = Acquire(cb);
+        if (e == nullptr) return;
+        e->device = device;
+        e->generation = NextGeneration();
+        e->coverage = e->generation != 0 ? coverage : Coverage::untracked;
+        e->commands = {};
+    }
+
+public:
+    void Init(uint64_t cb, uint64_t device)
+    {
+        Add(stats_.inits);
+        Start(cb, device, Coverage::init_only, State::reinitialized);
+    }
+    void Reset(uint64_t cb, uint64_t device)
+    {
+        // ReShade's Vulkan reset_command_list is before vkBeginCommandBuffer,
+        // not a promise that all native reset/pool/recording paths are visible.
+        Add(stats_.resets);
+        Start(cb, device, Coverage::begin_observed, State::reset);
+    }
+    void Destroy(uint64_t cb)
+    {
+        Add(stats_.destroys);
+        if (cb == 0) return;
+        Invalidate(cb, State::destroyed);
+        if (Entry *e = Find(cb)) { *e = {}; e->used = true; }
+    }
+    void DestroyDevice(uint64_t device)
+    {
+        Add(stats_.device_destroys);
+        for (Entry &e : entries_) {
+            if (e.cb == 0 || e.device != device) continue;
+            Invalidate(e.cb, State::device_destroyed);
+            e = {}; e.used = true;
+        }
+    }
+    void Activity(uint64_t cb, uint64_t device, Command command)
+    {
+        if (cb == 0 || command >= Command::count) return;
+        Add(stats_.events);
+        Entry *e = Find(cb);
+        if (e == nullptr) {
+            e = Acquire(cb);
+            if (e == nullptr) return;
+            e->device = device;
+            e->generation = NextGeneration();
+            e->coverage = e->generation != 0 ? Coverage::partial : Coverage::untracked;
+            Add(stats_.partial_starts);
+        }
+        Add(e->commands.kind[static_cast<unsigned>(command)]);
+        Add(e->commands.total);
+    }
+    Sample First(uint64_t cb, uint64_t queue, const Images &images, uint64_t qpc, unsigned index, bool indexed)
+    {
+        Add(stats_.firsts);
+        Sample s{};
+        s.id = stats_.firsts; s.cb = cb; s.eval_queue = queue; s.images = images;
+        s.qpc = qpc; s.index = index; s.indexed = indexed;
+        if (const Entry *e = Find(cb)) {
+            s.generation = e->generation; s.coverage = e->coverage; s.prefix = e->commands;
+        }
+        if (s.prefix.total != 0) Add(stats_.prefixes);
+        if (s.coverage == Coverage::untracked) Add(stats_.untracked_firsts);
+        else if (s.coverage != Coverage::begin_observed) Add(stats_.partial_firsts);
+        if (sample_count_ < kSamples) samples_[sample_count_++] = s;
+        else s.id = 0; // All later firsts contribute only to summary counters.
+        return s;
+    }
+    void BeginSubmit(Submit &out, uint64_t queue, uint32_t batches, uint64_t fence, bool submit2)
+    {
+        out = {};
+        Add(stats_.submits);
+        if (submit2) Add(stats_.submits2);
+        out.id = stats_.submits; out.queue = queue; out.batches = batches;
+        out.fence = fence; out.submit2 = submit2;
+        for (unsigned i = 0; i < sample_count_; ++i) {
+            const Sample &s = samples_[i];
+            if (s.state == State::pending && s.cb != 0) out.matches[out.candidates++].sample = s;
+        }
+    }
+    // Walks the entire caller-owned batch/CB arrays through the guarded adapter.
+    // Only matching locations have a storage cap; traversal is never capped at it.
+    static void MatchCommand(Submit &out, uint64_t cb, const Location &location)
+    {
+        Add(out.cbs_read);
+        if (cb == 0) return;
+        for (unsigned i = 0; i < out.candidates; ++i) {
+            Match &m = out.matches[i];
+            if (m.sample.cb != cb) continue;
+            Add(m.occurrences);
+            if (m.stored < kLocations) m.locations[m.stored++] = location;
+            else Add(m.omitted_locations);
+        }
+    }
+    void Claim(Submit &out)
+    {
+        Add(stats_.batches, out.batches_read); Add(stats_.cbs, out.cbs_read); Add(stats_.read_faults, out.read_faults);
+        for (unsigned i = 0; i < out.candidates; ++i) {
+            Match &m = out.matches[i];
+            if (m.occurrences == 0) continue;
+            Sample &s = samples_[static_cast<unsigned>(m.sample.id - 1)];
+            const Entry *e = Find(s.cb);
+            m.submit_generation = e != nullptr ? e->generation : 0;
+            if (s.state != State::pending || s.generation != m.submit_generation) continue;
+            // generation==0 is deliberately only a handle match, not a recording match.
+            s.state = State::in_submit;
+            m.claimed = true;
+        }
+    }
+    void Finish(Submit &out, uint32_t result)
+    {
+        out.result = result; // Preserve VkResult bits; no success/GPU-completion inference.
+        if (result != 0) Add(stats_.failed_results);
+        for (unsigned i = 0; i < out.candidates; ++i) {
+            Match &m = out.matches[i];
+            if (!m.claimed) continue;
+            Sample &s = samples_[static_cast<unsigned>(m.sample.id - 1)];
+            const Entry *e = Find(s.cb);
+            m.generation_changed = s.state != State::in_submit || (e != nullptr ? e->generation : 0) != m.submit_generation;
+            if (s.state == State::in_submit) s.state = State::returned;
+            Add(stats_.returned);
+            if (m.sample.generation == 0) Add(stats_.handle_only);
+            if (m.occurrences > 1) Add(stats_.duplicate_occurrences, m.occurrences - 1);
+            Add(stats_.omitted_locations, m.omitted_locations);
+        }
+    }
+    void NestedSubmitSkipped() { Add(stats_.nested_suppressed); }
+    Stats Summary() const { return stats_; }
+    unsigned SampleCount() const { return sample_count_; }
+    Sample GetSample(unsigned index) const { return index < sample_count_ ? samples_[index] : Sample{}; }
+};
+
+inline const char *CoverageName(Coverage coverage)
+{
+    switch (coverage) {
+    case Coverage::begin_observed: return "reshade-begin-observed/native-coverage-incomplete";
+    case Coverage::init_only: return "reshade-init-only/recording-boundary-unknown";
+    case Coverage::partial: return "partial/late-or-missed-lifecycle";
+    default: return "untracked/no-same-CB-event-coverage";
+    }
+}
