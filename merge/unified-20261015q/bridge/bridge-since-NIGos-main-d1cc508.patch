+// The C runtime opens these files by ANSI name, as this add-on always has.
+// A path the code page cannot express returns false rather than a lossy name.
+static bool LogNarrowPath(const char *leaf, char *out, size_t out_count)
+{
+    out[0] = 0;
+    wchar_t wide[MAX_PATH] = {};
+    wchar_t wleaf[64] = {};
+    for (size_t i = 0; leaf[i] != 0 && i + 1 < _countof(wleaf); ++i) wleaf[i] = static_cast<wchar_t>(leaf[i]);
+    if (_snwprintf_s(wide, _TRUNCATE, L"%ls\\%ls", g_log_dir, wleaf) < 0) return false;
+    BOOL lossy = FALSE;
+    const int n = WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, wide, -1, out,
+                                      static_cast<int>(out_count), nullptr, &lossy);
+    if (n <= 0 || lossy) { out[0] = 0; return false; }
+    return true;
+}
+
+// Older versions wrote their logs beside the executable. Move them into the
+// log folder once; a name already taken there gets a ".legacy-<tick>" suffix.
+// Nothing is deleted.
+static void LogMigrateRootFiles(const wchar_t *root)
+{
+    static const wchar_t *const kLeaves[] = {
+        L"dlss5-bridge.log", L"dlss5-observe.log", L"dlss5-observe.prev.log", L"dlss5-sl.log",
+        L"RenoDX-DLSS5-crash.log", L"RenoDX-DLSS5-normtrace.csv", L"RenoDX-DLSS5-edittrace.csv",
+    };
+    auto move_one = [root](const wchar_t *leaf) {
+        wchar_t from[MAX_PATH], to[MAX_PATH];
+        if (_snwprintf_s(from, _TRUNCATE, L"%ls\\%ls", root, leaf) < 0) return;
+        const DWORD attributes = GetFileAttributesW(from);
+        if (attributes == INVALID_FILE_ATTRIBUTES ||
+            (attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) return;
+        if (_snwprintf_s(to, _TRUNCATE, L"%ls\\%ls", g_log_dir, leaf) < 0) return;
+        if (GetFileAttributesW(to) != INVALID_FILE_ATTRIBUTES)
+        {
+            const wchar_t *dot = wcsrchr(leaf, L'.');
+            const size_t stem = dot != nullptr ? static_cast<size_t>(dot - leaf) : wcslen(leaf);
+            if (_snwprintf_s(to, _TRUNCATE, L"%ls\\%.*ls.legacy-%llu%ls", g_log_dir, static_cast<int>(stem), leaf,
+                             static_cast<unsigned long long>(GetTickCount64()), dot != nullptr ? dot : L"") < 0) return;
+        }
+        MoveFileExW(from, to, MOVEFILE_COPY_ALLOWED | MOVEFILE_WRITE_THROUGH);
+    };
+    for (const wchar_t *leaf : kLeaves) move_one(leaf);
+    wchar_t pattern[MAX_PATH];
+    if (_snwprintf_s(pattern, _TRUNCATE, L"%ls\\RenoDX-DLSS5-crash-*.dmp", root) < 0) return;
+    WIN32_FIND_DATAW data{};
+    HANDLE find = FindFirstFileW(pattern, &data);
+    if (find == INVALID_HANDLE_VALUE) return;
+    do move_one(data.cFileName); while (FindNextFileW(find, &data));
+    FindClose(find);
+}
