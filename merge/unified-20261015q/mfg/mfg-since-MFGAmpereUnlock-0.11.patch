+// This branch uses only the public options ABI. It does not advertise a larger
+// native capability, request UI composition, or prepare a compatibility provider.
+inline sl::Result SetNativeBlackwellOptions(const sl::ViewportHandle& viewport,
+                                           const sl::DLSSGOptions& options) {
+  const bool known = KnownOptionsAbi(options);
+  const unsigned requested = known ? options.numFramesToGenerate : 0;
+  const auto native = [&](FixedOverrideStatus status) {
+    const auto result = CallSetOptions(viewport, options);
+    const bool changed = SetFixedOverrideState(status, requested,
+        result == sl::Result::eOk && known && options.mode != sl::DLSSGMode::eOff ? requested : 0);
+    if (changed && status != FixedOverrideStatus::kNative && status != FixedOverrideStatus::kAlreadyMatched) {
+      const char* reason = status == FixedOverrideStatus::kBlockedBackend ? "provider not confirmed" :
+          status == FixedOverrideStatus::kUnknownStructuralCeiling ? "Streamline ceiling unknown" :
+          status == FixedOverrideStatus::kBlockedStructuralCeiling ? "Streamline ceiling too low" : "options ABI unknown";
+      std::stringstream message;
+      message << "mfgunlock: Blackwell multiplier unchanged: " << reason
+              << "; original generated=" << requested << "; result=0x" << std::hex << static_cast<unsigned>(result);
+      mfgunlock::eventlog::message(reshade::log::level::warning, message.str().c_str());
+    }
+    return result;
+  };
+  if (!known) return native(FixedOverrideStatus::kUnknownOptionsAbi);
+  if (!g_enabled.load() || options.mode != sl::DLSSGMode::eOn)
+    return native(FixedOverrideStatus::kNative);
+  const unsigned multiplier = g_force_multiplier.load(std::memory_order_relaxed);
+  if (multiplier < 2 || multiplier > 6) return native(FixedOverrideStatus::kNative);
+  const unsigned desired = multiplier - 1;
+  if (requested == desired) return native(FixedOverrideStatus::kAlreadyMatched);
+  if (!g_native_provider_ready || !g_native_provider_ready())
+    return native(FixedOverrideStatus::kBlockedBackend);
+  const unsigned ceiling = g_streamline_max_generated.load(std::memory_order_acquire);
+  if (!g_streamline_plugin_seen.load(std::memory_order_acquire) || ceiling == 0)
+    return native(FixedOverrideStatus::kUnknownStructuralCeiling);
+  if (desired > ceiling) return native(FixedOverrideStatus::kBlockedStructuralCeiling);
+  sl::DLSSGOptions forwarded{};
+  if (!CopyOptions(options, forwarded)) return native(FixedOverrideStatus::kUnknownOptionsAbi);
+  forwarded.numFramesToGenerate = desired;
+  auto result = CallSetOptions(viewport, forwarded, countobserver::Origin::kFixed);
+  auto status = FixedOverrideStatus::kApplied;
+  if (result != sl::Result::eOk) {
+    result = CallSetOptions(viewport, forwarded, countobserver::Origin::kRetry);
+    status = FixedOverrideStatus::kAppliedAfterRetry;
+  }
+  if (result != sl::Result::eOk) {
+    result = CallSetOptions(viewport, options, countobserver::Origin::kNativeFallback);
+    SetFixedOverrideState(result == sl::Result::eOk ? FixedOverrideStatus::kRejectedNativeFallback
+                                                  : FixedOverrideStatus::kFallbackRejected,
+                          requested, result == sl::Result::eOk ? requested : 0);
+    return result;
+  }
+  if (SetFixedOverrideState(status, requested, desired)) {
+    std::stringstream message;
+    message << "mfgunlock: Blackwell native multiplier " << multiplier
+            << "x accepted; native NGX provider/kernels preserved; Legacy SL pacing is controlled separately.";
+    mfgunlock::eventlog::message(reshade::log::level::info, message.str().c_str());
+  }
+  return result;
+}
