+inline const char* FixedOverrideStatusName(FixedOverrideStatus status) {
+  switch (status) {
+    case FixedOverrideStatus::kNative: return "native";
+    case FixedOverrideStatus::kPending: return "pending";
+    case FixedOverrideStatus::kApplied: return "applied";
+    case FixedOverrideStatus::kAppliedAfterRetry: return "applied-after-retry";
+    case FixedOverrideStatus::kAlreadyMatched: return "already-matched";
+    case FixedOverrideStatus::kRejectedNativeFallback: return "rejected-native-fallback";
+    case FixedOverrideStatus::kBlockedBackend: return "blocked-backend";
+    case FixedOverrideStatus::kBlockedPacing: return "blocked-pacing";
+    case FixedOverrideStatus::kBlockedStructuralCeiling: return "blocked-structural-ceiling";
+    case FixedOverrideStatus::kUnknownStructuralCeiling: return "unknown-structural-ceiling";
+    case FixedOverrideStatus::kUnknownOptionsAbi: return "unknown-options-abi";
+    case FixedOverrideStatus::kNativeRejected: return "native-rejected";
+    case FixedOverrideStatus::kFallbackRejected: return "fallback-rejected";
+  }
+  return "unknown";
+}
