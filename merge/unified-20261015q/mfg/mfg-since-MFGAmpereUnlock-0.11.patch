+bool NativeBlackwellProviderReady() {
+  if (!mfgunlock::architecture::NativeMultiplierOnly()) return false;
+  if (!TryAcquireSRWLockShared(&g_provider_maintenance_lock)) return false;
+  const auto modules = g_dlssg_modules;
+  ReleaseSRWLockShared(&g_provider_maintenance_lock);
+  bool found = false;
+  bool supported = true;
+  struct CachedProvider {
+    mfgunlock::hook::ModuleIdentity identity;
+    bool provider;
+  };
+  // SetOptions may be called frequently. Scan image markers once per identity
+  // on each calling thread, while still checking live mappings and versions.
+  thread_local std::vector<CachedProvider> cache;
+  for (HMODULE module : modules) {
+    HMODULE pinned = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                           reinterpret_cast<LPCWSTR>(module), &pinned)) continue;
+    mfgunlock::hook::ModuleIdentity identity;
+    const bool captured = mfgunlock::hook::CaptureModule(pinned, identity);
+    auto cached = std::find_if(cache.begin(), cache.end(), [&](const auto& entry) { return entry.identity == identity; });
+    bool provider = captured && cached != cache.end() ? cached->provider : false;
+    if (captured && cached == cache.end()) {
+      provider = mfgunlock::provider::IsDlssgProvider(pinned);
+      if (cache.size() >= 32) cache.clear();
+      cache.push_back({identity, provider});
+    }
+    if (provider) {
+      const auto version = mfgunlock::streamline::internal::ReadModuleVersion(pinned);
+      found = true;
+      supported = supported && (IsVersion(version, 310, 9, 0) || IsVersion(version, 310, 9, 1));
+    }
+    FreeLibrary(pinned);
+  }
+  return found && supported;
+}
+
+void ObserveResolvedDlssgFunction(void* function) {
+  if (!mfgunlock::architecture::NativeMultiplierOnly() || !function) return;
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                         reinterpret_cast<LPCWSTR>(function), &module)) return;
+  // BindPlugin verifies the vendor function table, captures module identity,
+  // observes the read-only ceiling and participates in unload invalidation.
+  const auto gateway = GetProcAddress(module, "slGetPluginFunction");
+  if (gateway) mfgunlock::streamline::internal::BindPlugin(module, gateway);
+  FreeLibrary(module);
+}
