+// Installing the gateway hook must not depend on the host asking a second time.
+// The host caches the pointer it receives from slGetFeatureFunction and never
+// looks it up again, so a first attempt which fails for any transient reason
+// leaves the multiplier unmanaged for the whole session. Two independent
+// recoveries therefore exist: install ahead of the host's lookup once any
+// DLSS-G entry has been resolved from the plugin module, and retry from the
+// present path -- which runs every frame -- if an attempt still fails.
+inline std::atomic_bool g_set_options_retry_armed{false};
+inline std::atomic<void*> g_set_options_retry_target{nullptr};
+// A failed install clears the address hook's own module identity, so the retry
+// must carry its own. Without it, unloading the plugin would leave a retry
+// pointing at an address which the loader may hand to a different image.
+inline std::atomic<HMODULE> g_set_options_retry_module{nullptr};
+inline std::atomic_uint32_t g_set_options_retry_countdown{0};
+inline std::atomic_uint32_t g_set_options_retry_attempts{0};
+
+constexpr uint32_t kSetOptionsRetryLimit = 6;
+
+inline HMODULE ModuleOfAddress(const void* address) {
+  if (address == nullptr) return nullptr;
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCWSTR>(address), &module)) {
+    return nullptr;
+  }
+  return module;
+}
+
+inline void ArmSetOptionsRetry(void* target) {
+  g_set_options_retry_module.store(ModuleOfAddress(target), std::memory_order_release);
+  g_set_options_retry_target.store(target, std::memory_order_release);
+  g_set_options_retry_attempts.store(0, std::memory_order_release);
+  g_set_options_retry_countdown.store(0, std::memory_order_release);
+  g_set_options_retry_armed.store(true, std::memory_order_release);
+}
+
+inline void DisarmSetOptionsRetry() {
