+// Every MFG Unlock log line goes to ReShade.log as before and, through the
+// Bridge's DLSS5LogEventV1, into the suite's anomaly log in dlss5/dlss5_log.
+// Without the Bridge the second half is a no-op.
+namespace mfgunlock::eventlog {
+inline void message(reshade::log::level level, const char* text) {
+  reshade::log::message(level, text);
+  dlss5::eventlog::Forward(dlss5::eventlog::kMfg, static_cast<int>(level), text);
+}
+// Event log only: per-call records that would flood ReShade.log.
+inline void anomaly(const char* text) {
+  dlss5::eventlog::Forward(dlss5::eventlog::kMfg, dlss5::eventlog::kWarning, text);
+}
+}  // namespace mfgunlock::eventlog
