+static bool g_deployment_bypass=false;
+static bool DeploymentSafeMode() {
+  using Query=uint32_t(__cdecl*)();
+  const HMODULE bridge=GetModuleHandleW(L"dlss5-bridge.addon64");
+  const auto query=bridge?reinterpret_cast<Query>(GetProcAddress(bridge,"DLSS5DeploymentSafeMode")):nullptr;
+  if(query) return query()!=0;
+  const auto game=dlss5::durable::GameDirectory();
+  const auto dir=dlss5::durable::StateDirectory(game);
+  if(dir.empty()) return true;
+  dlss5::deployment_policy::State state;
+  const auto result=dlss5::durable::Read(dir/L"bridge.state",state,state.magic);
+  if(result==dlss5::durable::ReadResult::Missing) return false;
+  if(result==dlss5::durable::ReadResult::Invalid || !dlss5::deployment_policy::Valid(state)) return true;
+  WIN32_FILE_ATTRIBUTE_DATA marker{};
+  const bool crashed=GetFileAttributesExW((dir/L"startup-crash.marker").c_str(),GetFileExInfoStandard,&marker) && marker.nFileSizeLow;
+  dlss5::deployment_policy::Begin(state,state.fingerprint,crashed);
+  return state.safe!=0;
+}
+
+// Detours installed by this add-on can be entered from any thread independently
+// of ReShade's add-on references, and a caller can still be inside one when a
+// FreeLibrary removes it. Keep the image (and the ReShade module that its
+// callbacks call into) mapped until process exit.
+static bool PinModuleForProcessLifetime(HMODULE module) {
+  HMODULE pinned = nullptr;
+  return module != nullptr &&
+         GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                            reinterpret_cast<LPCWSTR>(module), &pinned) != FALSE &&
+         pinned == module;
+}
 
