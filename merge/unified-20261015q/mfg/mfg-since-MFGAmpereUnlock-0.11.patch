+// Every SetOptions decision passes through SetFixedOverrideState. A decision
+// that leaves the panel multiplier unapplied is recorded in the anomaly event
+// log on every call (the Bridge merges repeats in its bounded mode); ReShade.log
+// keeps its existing change-only lines.
+inline void RecordOverrideAnomaly(FixedOverrideStatus status, unsigned int requested,
+                                  unsigned int effective) {
+  const unsigned int multiplier = g_force_multiplier.load(std::memory_order_relaxed);
+  const bool forcing = g_enabled.load() && multiplier >= 2 && multiplier <= 6;
+  bool anomaly = false;
+  switch (status) {
+    case FixedOverrideStatus::kRejectedNativeFallback:
+    case FixedOverrideStatus::kBlockedBackend:
+    case FixedOverrideStatus::kBlockedPacing:
+    case FixedOverrideStatus::kBlockedStructuralCeiling:
+    case FixedOverrideStatus::kUnknownStructuralCeiling:
+    case FixedOverrideStatus::kUnknownOptionsAbi:
+    case FixedOverrideStatus::kNativeRejected:
+    case FixedOverrideStatus::kFallbackRejected:
+      anomaly = true;
+      break;
+    default:
+      // Dynamic MFG chooses its own count, so a different count is not a miss.
+      anomaly = forcing && status != FixedOverrideStatus::kPending && effective != 0 &&
+                effective != multiplier - 1 && !g_dynamic_mfg_enabled.load(std::memory_order_relaxed);
+      break;
+  }
+  if (!anomaly) return;
+  char text[256];
+  _snprintf_s(text, _TRUNCATE,
+              "mfgunlock: multiplier not applied: decision=%s panel=%ux enabled=%u game_requested_generated=%u "
+              "forwarded_generated=%u thread=%lu",
+              FixedOverrideStatusName(status), multiplier, g_enabled.load() ? 1u : 0u, requested, effective,
+              GetCurrentThreadId());
+  eventlog::anomaly(text);
+}
