+// Caller holds the NGX turn and runtime_mutex and has verified an SR/RR
+// feature. A game Reset belongs to this feature, not the global reset epoch.
+inline void LatchFeatureReset(Feature* feature, const NVSDK_NGX_Parameter* parameters) {
+  if (GetInt(parameters, NVSDK_NGX_Parameter_Reset, 0) != 1) return;
+  for (auto& stage : feature->stages) {
+    for (auto& slot : stage.slots) slot.pending_reset = true;
+    stage.norm_pending_reset = true;
+  }
+}
