+inline uint32_t BridgeStagePlan() {
+  const HMODULE bridge = GetModuleHandleW(L"dlss5-bridge.addon64");
+  if (bridge == nullptr) return 0u;
+  using Query = uint32_t(__cdecl*)();
+  const auto version = reinterpret_cast<Query>(
+      GetProcAddress(bridge, "DLSS5BridgeStageProtocolVersion"));
+  const auto query = reinterpret_cast<Query>(
+      GetProcAddress(bridge, "DLSS5BridgeActiveStagePlan"));
+  if (version == nullptr || version() != 1u || query == nullptr) return 0u;
+  const uint32_t value = query();
+  return (value & 0x80000000u) != 0
+          && stages::Plan{value & ~0x80000000u}.Valid()
+      ? value : 0u;
+}
