+inline void PollLayerTrial() {
+  if (stages::trial::Poll()) {
+    kSetRenderPasses.Persist();
+    RecreateFeatures();
+  }
+}
+// Draw only within the DLSS5 overlay. The global reshade_overlay event does
+// not establish ownership by this add-on's page. OnPresent keeps the timeout
+// active while this page or the entire ReShade overlay is closed.
+inline void DrawLayerTrial() {
+  PollLayerTrial();
+  const uint64_t due = stages::trial::deadline.load();
+  if (!due) return;
+  const uint64_t now = GetTickCount64();
+  ImGui::PushID("DLSS5LayerTrial");
+  ImGui::SeparatorText(ui::Tr("Confirm DLSS5 layer count"));
+  {
+    ImGui::TextWrapped("%s", ui::Tr("5+ layers increase VRAM use, GPU load and latency; rendering may stall or the device may be lost."));
+    ImGui::Text(ui::Tr("Restore previous layers in %u seconds"), static_cast<unsigned>((due > now ? due-now : 0) + 999) / 1000);
+    ImGui::BeginDisabled(now + 13000 < due || now >= due);
+    // Mouse-only activation prevents Enter/Space and the initiating click from confirming.
+    if (ImGui::Button(ui::Tr("Keep###layer_keep")) && ImGui::IsMouseReleased(ImGuiMouseButton_Left)) stages::trial::Resolve(true);
+    ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (ImGui::Button(ui::Tr("Restore now###layer_restore"))) stages::trial::Resolve(false);
+  }
+  ImGui::Separator();
+  ImGui::PopID();
+}
+inline void LayerCaption(uint32_t channel, char* text, size_t size) {
+  const auto plan = stages::Snapshot();
+  const auto point = channel < plan.Count(stages::Point::Render) ? stages::Point::Render :
+      channel < plan.Offset(stages::Point::Present) ? stages::Point::Upscaled : stages::Point::Present;
+  const char* stage = ui::Tr(point == stages::Point::Render ? "Render" : point == stages::Point::Upscaled ? "Upscaled" : "Present");
+  std::snprintf(text, size, ui::Tr("%s layer %u (global %u)"), stage, channel - plan.Offset(point) + 1, channel + 1);
+}
