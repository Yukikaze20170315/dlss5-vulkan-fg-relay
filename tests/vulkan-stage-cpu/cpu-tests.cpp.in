struct FakeRuntime {
  int create(VkDevice, VkCommandBuffer, int, NVSDK_NGX_Parameter* p, NVSDK_NGX_Handle** handle) {
    CHECK(runtime_depth != 0 && ngx_serial::depth != 0);
    ++create_calls;
    events.push_back("create");
    if (inject_create == 2) throw std::runtime_error("injected create exception");
    if (inject_create == 1) return -1;
    *handle = NewHandle(p);
    return 1;
  }
  int evaluate(VkCommandBuffer, NVSDK_NGX_Handle* handle, NVSDK_NGX_Parameter* p, void*) {
    CHECK(runtime_depth != 0 && ngx_serial::depth != 0);
    CHECK(handle != nullptr && !handle->released && handle->parameters == p && !p->destroyed);
    ++evaluate_calls;
    events.push_back("evaluate");
    if (inject_evaluate == 2) throw std::runtime_error("injected evaluate exception");
    return inject_evaluate == 1 ? -1 : 1;
  }
  void release(NVSDK_NGX_Handle* handle) {
    CHECK(handle != nullptr && !handle->released);
    CHECK(handle->parameters == nullptr || !handle->parameters->destroyed);
    handle->released = true;
    events.push_back("release:" + std::to_string(handle->id));
  }
} runtime;
