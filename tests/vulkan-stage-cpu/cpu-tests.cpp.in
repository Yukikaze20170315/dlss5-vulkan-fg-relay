struct NVSDK_NGX_Parameter {
  uint64_t id = 0;
  bool destroyed = false;
  mutable uint32_t reset_reads = 0;
  std::unordered_map<std::string, int> ints;
  std::unordered_map<std::string, float> floats;
};
struct NVSDK_NGX_Handle {
  uint64_t id = 0;
  bool released = false;
  NVSDK_NGX_Parameter* parameters = nullptr;
};
inline int GetInt(const NVSDK_NGX_Parameter* parameters, const char* key, int fallback) {
  CHECK(parameters != nullptr && !parameters->destroyed);
  if (std::string(key) == NVSDK_NGX_Parameter_Reset) {
    CHECK(ngx_serial::depth != 0 && runtime_depth != 0);
    ++parameters->reset_reads;
    events.push_back("read-reset");
  }
  const auto found = parameters->ints.find(key);
  return found == parameters->ints.end() ? fallback : found->second;
}
inline void NVSDK_NGX_Parameter_SetI(NVSDK_NGX_Parameter* p, const char* key, int value) {
  CHECK(p != nullptr && !p->destroyed);
  p->ints[key] = value;
}
inline void NVSDK_NGX_Parameter_SetUI(NVSDK_NGX_Parameter* p, const char* key, uint32_t value) {
  NVSDK_NGX_Parameter_SetI(p, key, static_cast<int>(value));
}
inline void NVSDK_NGX_Parameter_SetF(NVSDK_NGX_Parameter* p, const char* key, float value) {
  CHECK(p != nullptr && !p->destroyed);
  p->floats[key] = value;
}
inline uint64_t object_id = 1;
inline std::vector<std::unique_ptr<NVSDK_NGX_Parameter>> parameter_pool;
inline std::vector<std::unique_ptr<NVSDK_NGX_Handle>> handle_pool;
inline NVSDK_NGX_Parameter* NewParameters() {
  auto p = std::make_unique<NVSDK_NGX_Parameter>();
  p->id = object_id++;
  auto* result = p.get();
  parameter_pool.push_back(std::move(p));
  return result;
}
inline NVSDK_NGX_Handle* NewHandle(NVSDK_NGX_Parameter* p = nullptr) {
  auto handle = std::make_unique<NVSDK_NGX_Handle>();
  handle->id = object_id++;
  handle->parameters = p;
  auto* result = handle.get();
  handle_pool.push_back(std::move(handle));
  return result;
}
namespace bridge {
inline void AllocateOwnedParameters(NVSDK_NGX_Parameter** p) { *p = NewParameters(); }
inline void DestroyOwnedParameters(NVSDK_NGX_Parameter* p) {
  CHECK(!p->destroyed);
  p->destroyed = true;
  events.push_back("parameters:" + std::to_string(p->id));
}
