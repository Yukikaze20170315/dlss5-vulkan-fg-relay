using EvaluateFn = int(*)(VkCommandBuffer, const NVSDK_NGX_Handle*, const NVSDK_NGX_Parameter*,
                         PFN_NVSDK_NGX_ProgressCallback);
struct Real { void* evaluate = nullptr; };
inline Real slot_real[1];

// HookedEvaluate below is complete production code. This ProcessNr seam
// executes its verbatim reconciliation and missing-guide gates, then fakes
// image work using the separately extracted normalization/model functions.
inline NrDeclineReason ProcessNr(VkCommandBuffer command_buffer,
                                const NVSDK_NGX_Handle* handle,
                                const NVSDK_NGX_Parameter* parameters,
                                stages::Point stage,
                                RenderColorScope* render_color = nullptr) {
  (void)command_buffer;
  (void)render_color;
@PROCESS_ENTRY@
  const uint32_t index = pre_sr ? 0u : 1u;
  ++stage_calls[index];
  events.push_back(pre_sr ? "render" : "upscaled");
  const int token = 1;
  const int* depth = guides_present[index] ? &token : nullptr;
  const int* motion = guides_present[index] ? &token : nullptr;
  struct { bool ReadWrite = true; } output_value;
  auto* output = &output_value;
@GUIDE_GATES@
  if (!consume_stage) return NrDeclineReason::kCount;
  auto& feature = features.at(handle).stages[index];
  RecordNorm(feature, parameters);
  RuntimeLock lock(runtime_mutex);
  for (uint32_t pass = 0; pass < stack; ++pass) {
    SetModelParameters(feature.slots[pass], pass, history_reset_epoch.load(), 0, 0, false);
  }
  return NrDeclineReason::kCount;
}
@HOOK_FUNCTIONS@

inline void ResetHarness() {
  CHECK(runtime_depth == 0 && ngx_serial::depth == 0);
  features.clear(); parameter_pool.clear(); handle_pool.clear();
  recorded_uses.clear(); live_recorded_uses.clear(); events.clear();
  object_id = next_use_id = 1;
  fake_now_ns = 10'000'000'000;
  live_nr_features = 0; workset_free_policy = 0; configuration_generation = 7;
  nr_passes = 0;
  inject_evaluate = inject_create = 0; create_calls = evaluate_calls = 0;
  history_reset_epoch = 77;
  look_upsample = 0; look_area_input_applied = 2; look_mode = false;
  look_stabilize = 0; look_stabilize_detail = false; detail_stability = 0;
  look_stabilize_ms = 60.f; look_strength = 1.f; look_detail = 1.f;
  norm_governor = 1; norm_cut_aware = false; feed_mode = 0;
  chained_temporal_history = true; norm_snap_count = 0; norm_snap_reset = 0;
  callback_active = true; direct_call = yields_foreign = protocol_supported = false;
  consume_stage = true; guides_present[0] = guides_present[1] = true;
  native_result = 1; native_calls = 0; stage_calls[0] = stage_calls[1] = 0;
  call_depth = 0; enabled = true; foreign_dx11_tool_seen = d3d12_present_seen = false;
  d3d12_nr_success_ns = nr_off_seen_ns = 0; bridge_yielding = false;
  last_decline = NrDeclineReason::kCount;
  stages::current = stages::Point::Upscaled;
  stages::counts[0] = stages::counts[1] = 4; stages::counts[2] = 0;
  slot_real[0].evaluate = reinterpret_cast<void*>(&NativeEvaluate);
}
inline Feature& AddFeature(const NVSDK_NGX_Handle** key, int id = kFeatureDlss) {
  *key = NewHandle();
  Feature& game = features[*key];
  game.id = id; game.device = &fake_device;
  for (uint32_t stage = 0; stage < 2; ++stage) {
    auto& feature = game.stages[stage];
    feature.device = &fake_device; feature.channel_offset = stage * 4;
    feature.nr_width = 320; feature.nr_height = 180; feature.nr_hdr_mode = 1;
    feature.configuration = configuration_generation.load();
    feature.commit = {object_id++}; feature.commit_view = {object_id++};
    feature.commit_use = next_use_id++; feature.commit_cleared = true;
    Workset workset; workset.use_id = next_use_id++;
    workset.images[0] = {object_id++}; workset.views[0] = {object_id++};
    feature.worksets.push_back(workset);
    feature.ngx.norm.primed = true; feature.ngx.norm.epoch = history_reset_epoch.load();
    feature.ngx.norm.last_ns = fake_now_ns - 16'000'000;
    for (uint32_t pass = 0; pass < kMaxNrPasses; ++pass) {
      auto& slot = feature.slots[pass];
      slot.parameters = NewParameters(); slot.handle = NewHandle(slot.parameters);
      slot.acknowledged_reset_epoch = history_reset_epoch.load();
      slot.configuration_generation = feature.configuration;
      feature.nr_use[pass] = next_use_id++;
      auto& history = feature.look_history[pass];
      for (auto& half : history.buffers) { half.image = {object_id++}; half.view = {object_id++}; }
      history.width = 320; history.height = 180; history.valid = true;
      history.written = 1; history.whole_edit = true; history.epoch = 11;
      history.last_ns = fake_now_ns - 16'000'000;
      feature.look_history_use[pass] = next_use_id++;
      ++live_nr_features;
    }
  }
  return game;
}
struct Fixture {
  const NVSDK_NGX_Handle* key = nullptr;
  Feature* game = nullptr;
  NVSDK_NGX_Parameter* parameters = nullptr;
  explicit Fixture(int id = kFeatureDlss) {
    ResetHarness();
    game = &AddFeature(&key, id);
    parameters = NewParameters();
    parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
  }
  StageFeature& stage(uint32_t index = 0) { return game->stages[index]; }
  int hook() { return HookedEvaluate<0>(&list_a, key, parameters, nullptr); }
};
inline void CheckHistory(const LookHistoryVk& actual, const LookHistoryVk& expected) {
  for (uint32_t i = 0; i < 2; ++i) {
    CHECK(actual.buffers[i].image.handle == expected.buffers[i].image.handle);
    CHECK(actual.buffers[i].view.handle == expected.buffers[i].view.handle);
  }
  CHECK(actual.width == expected.width && actual.height == expected.height);
  CHECK(actual.written == expected.written && actual.valid == expected.valid);
  CHECK(actual.whole_edit == expected.whole_edit && actual.epoch == expected.epoch);
  CHECK(actual.last_ns == expected.last_ns);
}
inline void CheckContract(const StageFeature& actual, const StageFeature& before) {
  CHECK(actual.nr_width == before.nr_width && actual.nr_height == before.nr_height);
  CHECK(actual.nr_hdr_mode == before.nr_hdr_mode && actual.configuration == before.configuration);
  CHECK(actual.worksets.size() == before.worksets.size());
  CHECK(actual.worksets[0].use_id == before.worksets[0].use_id);
  CHECK(actual.commit.handle == before.commit.handle && actual.commit_view.handle == before.commit_view.handle);
  CHECK(actual.commit_use == before.commit_use && actual.commit_cleared == before.commit_cleared);
  CHECK(actual.ngx.norm.primed == before.ngx.norm.primed);
  CHECK(actual.ngx.norm.epoch == before.ngx.norm.epoch && actual.ngx.norm.last_ns == before.ngx.norm.last_ns);
}
inline void CheckPending(const StageFeature& stage, bool expected) {
  for (const auto& slot : stage.slots) CHECK(slot.pending_reset == expected);
}
inline void Drain(StageFeature& feature) {
  const ngx_serial::Call ngx_turn;
  RuntimeLock lock(runtime_mutex);
  DrainRetiredFeature(&feature);
}
inline void RetireSuffix(StageFeature& feature, uint32_t first) {
  const ngx_serial::Call ngx_turn;
  RuntimeLock lock(runtime_mutex);
  RetireStagePasses(&feature, first);
}
inline size_t EventIndex(const std::string& event) {
  const auto found = std::find(events.begin(), events.end(), event);
  CHECK(found != events.end());
  return static_cast<size_t>(found - events.begin());
}
inline void FailureCase(uint32_t pass, bool throws) {
  Fixture f;
  auto& feature = f.stage();
  feature.slots[pass].fail_count = 3;
  for (uint32_t prefix = 0; prefix < pass; ++prefix) {
    CHECK(EvaluatePass(feature, prefix, f.parameters) == NrDeclineReason::kCount);
    FinishLookPass(&feature.look_history[prefix], true, true, fake_now_ns, look::Constants{},
                   0, prefix, 320, 180);
  }
  const StageFeature before = feature, other = f.stage(1);
  inject_evaluate = throws ? 2 : 1;
  CHECK(EvaluatePass(feature, pass, f.parameters) == NrDeclineReason::kFailureBackoff);
  CHECK(evaluate_calls == pass + 1 && nr_passes.load() == pass);
  const auto& failed = feature.slots[pass];
  CHECK(failed.handle == nullptr && failed.parameters == nullptr);
  CHECK(failed.failed && failed.failed_ns == fake_now_ns && failed.fail_count == 3);
  CHECK(live_nr_features.load() == 7);
  CHECK(feature.retired_nr.size() == 1 && feature.retired_history.size() == 1);
  CHECK(feature.retired_nr[0].handle == before.slots[pass].handle);
  CHECK(feature.retired_nr[0].parameters == before.slots[pass].parameters);
  CHECK(feature.retired_nr[0].use_id == before.nr_use[pass]);
  CHECK(feature.retired_history[0].use_id == before.look_history_use[pass]);
  CHECK(feature.nr_use[pass] == 0 && feature.look_history_use[pass] == 0);
  CHECK(!feature.look_history[pass].valid);
  CheckContract(feature, before);
  CHECK(!before.slots[pass].handle->released && !before.slots[pass].parameters->destroyed);
  CHECK(!RecordedUseComplete(before.nr_use[pass]));
  for (uint32_t i = 0; i < kMaxNrPasses; ++i) {
    if (i != pass) {
      CHECK(feature.slots[i].handle == before.slots[i].handle);
      CHECK(feature.slots[i].parameters == before.slots[i].parameters);
      CHECK(feature.nr_use[i] == before.nr_use[i]);
      CheckHistory(feature.look_history[i], before.look_history[i]);
      CHECK(feature.look_history_use[i] == before.look_history_use[i]);
      CHECK(feature.slots[i].pending_reset == (i > pass));
    }
    CHECK(f.stage(1).slots[i].handle == other.slots[i].handle);
    CHECK(!f.stage(1).slots[i].pending_reset);
    CheckHistory(f.stage(1).look_history[i], other.look_history[i]);
  }
  CHECK(history_reset_epoch.load() == 77);
}
inline void BackoffWarmupCase(uint32_t failed_pass) {
  Fixture f;
  auto& feature = f.stage();
  auto* old_handle = feature.slots[failed_pass].handle;
  const uint64_t old_use = feature.nr_use[failed_pass];
  feature.slots[failed_pass].fail_count = 2;
  inject_evaluate = 1;
  CHECK(EvaluatePass(feature, failed_pass, f.parameters) == NrDeclineReason::kFailureBackoff);
  const int64_t failed_ns = fake_now_ns;
  uint32_t ready = 99;
  const auto expected_wait = failed_pass == 0 ? NrDeclineReason::kFailureBackoff : NrDeclineReason::kCount;
  CHECK(SelectSlots(feature, 4, &ready) == expected_wait);
  CHECK(create_calls == 0 && feature.slots[failed_pass].failed);
  if (failed_pass != 0) CHECK(ready == failed_pass);
  fake_now_ns = failed_ns + 1'999'999'999;
  CHECK(SelectSlots(feature, 4, &ready) == expected_wait && create_calls == 0);
  fake_now_ns = failed_ns + 2'000'000'000;
  const auto expected_create = failed_pass == 0 ? NrDeclineReason::kSlotWarmupMaturation : NrDeclineReason::kCount;
  CHECK(SelectSlots(feature, 4, &ready) == expected_create);
  CHECK(create_calls == 1 && evaluate_calls == 1);
  CHECK(feature.slots[failed_pass].handle != nullptr && feature.slots[failed_pass].handle != old_handle);
  CHECK(feature.slots[failed_pass].fail_count == 3 && !feature.slots[failed_pass].failed);
  CHECK(feature.slots[failed_pass].pending_reset && feature.nr_use[failed_pass] != old_use);
  CHECK(!old_handle->released && live_nr_features.load() == 8);
  if (failed_pass != 0) CHECK(ready == failed_pass);
  CHECK(SelectSlots(feature, 4, &ready) == NrDeclineReason::kCount && ready == 4);
  inject_evaluate = 0;
  CHECK(EvaluatePass(feature, failed_pass, f.parameters) == NrDeclineReason::kCount);
  CHECK(feature.slots[failed_pass].fail_count == 0 && !feature.slots[failed_pass].pending_reset);
  CHECK(feature.slots[failed_pass].model_reset);
  CHECK(feature.slots[failed_pass].parameters->ints.at("DLSSNR.Reset") == 1);
}

using Test = std::pair<std::string, std::function<void()>>;
int main(int argc, char** argv) {
  const std::string filter = argc > 1 ? argv[1] : "";
  std::vector<Test> tests;
  const auto add = [&](const std::string& name, std::function<void()> test) {
    tests.emplace_back(name, std::move(test));
  };
  add("runtime-lock-reentry-is-rejected", [] {
    ResetHarness();
    const ngx_serial::Call ngx_turn;
    {
      RuntimeLock outer(runtime_mutex);
      bool rejected = false;
      try { RuntimeLock nested(runtime_mutex); }
      catch (const std::runtime_error&) { rejected = true; }
      CHECK(rejected && runtime_depth == 1);
    }
    CHECK(runtime_depth == 0);
    RuntimeLock next(runtime_mutex);
    CHECK(runtime_depth == 1);
  });
  add("runtime-lock-requires-ngx-turn", [] {
    ResetHarness();
    bool rejected = false;
    try { RuntimeLock lock(runtime_mutex); }
    catch (const std::runtime_error&) { rejected = true; }
    CHECK(rejected && runtime_depth == 0);
    const ngx_serial::Call ngx_turn;
    RuntimeLock next(runtime_mutex);
    CHECK(runtime_depth == 1);
  });
  add("look-auto-render-off", [] { ResetHarness(); CHECK(SettingsForStage(true).stabilize == 0); });
  add("look-auto-upscaled-on", [] {
    ResetHarness(); const auto s = SettingsForStage(false);
    CHECK(s.stabilize == 2 && s.stabilize_detail && s.stabilize_alpha == defaults::kDetailStabilityAlpha);
  });
  add("look-off-both-stages", [] {
    ResetHarness(); detail_stability = 1;
    CHECK(SettingsForStage(true).stabilize == 0 && SettingsForStage(false).stabilize == 0);
  });
  add("look-always-both-stages", [] {
    ResetHarness(); detail_stability = 2;
    for (bool pre : {true, false}) CHECK(SettingsForStage(pre).stabilize_alpha == defaults::kDetailStabilityAlpha);
  });
  for (uint32_t mode : {1u, 2u}) {
    add("look-explicit-stabilize-" + std::to_string(mode), [mode] {
      ResetHarness(); look_mode = true; look_stabilize = mode;
      look_stabilize_ms = 91.f; look_stabilize_detail = true; detail_stability = 2;
      for (bool pre : {true, false}) {
        const auto s = SettingsForStage(pre);
        CHECK(s.stabilize == mode && s.stabilize_ms == 91.f && s.stabilize_detail);
        CHECK(s.stabilize_alpha == 0.f);
      }
    });
  }
  add("look-settings-and-area-reset-preserved", [] {
    ResetHarness(); look_mode = true; look_strength = 0.4f; look_detail = 1.8f;
    CHECK(SettingsForStage(true).strength == 0.4f && SettingsForStage(false).detail == 1.8f);
    look_upsample = 3; SettingsForStage(true); CHECK(history_reset_epoch == 78);
    SettingsForStage(false); CHECK(history_reset_epoch == 78);
    look_upsample = 1; SettingsForStage(true); CHECK(history_reset_epoch == 79);
  });
  for (uint32_t pass : {0u, 2u}) {
    for (bool throws : {false, true}) {
      add("failure-pass-" + std::to_string(pass) + (throws ? "-exception" : "-result"),
          [pass, throws] { ResetHarness(); nr_passes = 0; FailureCase(pass, throws); });
    }
    add("backoff-warmup-pass-" + std::to_string(pass), [pass] { BackoffWarmupCase(pass); });
  }
  add("first-failure-next-evaluate-retry", [] {
    Fixture f; inject_evaluate = 1;
    CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kFailureBackoff);
    uint32_t ready = 0;
    CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kSlotWarmupMaturation);
    CHECK(create_calls == 1 && f.stage().slots[0].fail_count == 1);
  });
  for (uint32_t count : {1u, 2u, 3u, 6u, 20u}) {
    add("backoff-boundary-count-" + std::to_string(count), [count] {
      ResetHarness(); NrFeatureSlot slot; slot.fail_count = count; slot.failed_ns = fake_now_ns;
      const int64_t delay = count == 1 ? 1'000'000'000 : count == 2 ? 2'000'000'000 :
                            count == 3 ? 4'000'000'000 : 30'000'000'000;
      fake_now_ns += delay - 1; CHECK(!FeatureFailureExpired(slot));
      ++fake_now_ns; CHECK(FeatureFailureExpired(slot));
    });
  }
  for (int failure : {1, 2}) {
    add("create-retry-retains-failure-count-" + std::to_string(failure), [failure] {
      Fixture f; inject_evaluate = 1;
      CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kFailureBackoff);
      inject_create = failure; uint32_t ready = 0;
      CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kFailureBackoff);
      CHECK(f.stage().slots[0].failed && f.stage().slots[0].fail_count == 1);
      CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kFailureBackoff && create_calls == 1);
      fake_now_ns += 1'000'000'000; inject_create = 0;
      CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kSlotWarmupMaturation);
      CHECK(f.stage().slots[0].fail_count == 2 && create_calls == 2);
    });
  }
  add("recorded-use-two-command-buffers-no-early-release", [] {
    Fixture f; auto& feature = f.stage();
    auto* handle = feature.slots[0].handle; auto* parameters = feature.slots[0].parameters;
    const auto history = feature.look_history[0];
    const uint64_t use = feature.nr_use[0], history_use = feature.look_history_use[0];
    TrackRecordedUse(&list_a, use); TrackRecordedUse(&list_a, use);
    TrackRecordedUse(&list_b, use); TrackRecordedUse(&list_a, history_use); TrackRecordedUse(&list_b, history_use);
    CHECK(live_recorded_uses.at(use) == 2);
    inject_evaluate = 1; EvaluatePass(feature, 0, f.parameters);
    fake_now_ns += 60'000'000'000; Drain(feature); Drain(feature);
    CHECK(!handle->released && !parameters->destroyed && feature.retired_history.size() == 1);
    ForgetRecordedUses(&list_a); Drain(feature);
    CHECK(!handle->released && !parameters->destroyed && !RecordedUseComplete(use));
    ForgetRecordedUses(&list_b); Drain(feature);
    CHECK(handle->released && parameters->destroyed && feature.retired_nr.empty() && feature.retired_history.empty());
    CHECK(EventIndex("release:" + std::to_string(handle->id)) < EventIndex("parameters:" + std::to_string(parameters->id)));
    EventIndex("image:" + std::to_string(history.buffers[0].image.handle));
    EventIndex("view:" + std::to_string(history.buffers[1].view.handle));
    const auto size = events.size(); Drain(feature); CHECK(events.size() == size);
  });
  add("independent-look-history-use-id", [] {
    Fixture f; auto& feature = f.stage();
    auto* handle = feature.slots[2].handle; auto* p = feature.slots[2].parameters;
    const auto history = feature.look_history[2];
    TrackRecordedUse(&list_b, feature.look_history_use[2]);
    inject_evaluate = 1; EvaluatePass(feature, 2, f.parameters);
    ForgetRecordedUses(&list_a); Drain(feature);
    CHECK(handle->released && p->destroyed && feature.retired_history.size() == 1);
    CHECK(std::find(events.begin(), events.end(), "image:" + std::to_string(history.buffers[0].image.handle)) == events.end());
    ForgetRecordedUses(&list_b); Drain(feature); CHECK(feature.retired_history.empty());
  });
  add("keep-policy-retains-complete-retirement", [] {
    Fixture f; inject_evaluate = 1; EvaluatePass(f.stage(), 0, f.parameters);
    ForgetRecordedUses(&list_a); workset_free_policy = 1; Drain(f.stage());
    CHECK(f.stage().retired_nr.size() == 1 && f.stage().retired_history.size() == 1);
    workset_free_policy = 0; Drain(f.stage()); CHECK(f.stage().retired_nr.empty());
  });
  add("suffix-retirement-preserves-prefix-and-contract", [] {
    Fixture f; const StageFeature before = f.stage();
    RetireSuffix(f.stage(), 2);
    CHECK(live_nr_features == 6 && f.stage().retired_nr.size() == 2);
    CheckContract(f.stage(), before);
    for (uint32_t i = 0; i < 2; ++i) {
      CHECK(f.stage().slots[i].handle == before.slots[i].handle);
      CheckHistory(f.stage().look_history[i], before.look_history[i]);
    }
    RetireSuffix(f.stage(), 2); CHECK(live_nr_features == 6 && f.stage().retired_nr.size() == 2);
  });
  add("full-stage-retirement-packs-worksets-and-divisor", [] {
    Fixture f; const uint64_t commit_use = f.stage().commit_use;
    RetireSuffix(f.stage(), 0);
    CHECK(f.stage().worksets.empty() && f.stage().retired_worksets.size() == 2);
    CHECK(f.stage().retired_worksets[1].use_id == commit_use);
    CHECK(f.stage().commit.handle == 0 && f.stage().nr_width == 0 && live_nr_features == 4);
    CHECK(f.stage(1).nr_width == 320 && f.stage(1).worksets.size() == 1);
  });
  add("handleless-unrecorded-parameters-cleanup", [] {
    Fixture f; auto& slot = f.stage().slots[3]; auto* p = slot.parameters;
    slot.handle = nullptr; f.stage().nr_use[3] = 0; --live_nr_features;
    RetireSuffix(f.stage(), 3);
    CHECK(p->destroyed && f.stage().retired_nr.empty() && live_nr_features == 7);
  });
  add("reset-survives-missing-guides", [] {
    Fixture f; guides_present[0] = guides_present[1] = false;
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; CHECK(f.hook() == 1);
    for (const auto& stage : f.game->stages) { CheckPending(stage, true); CHECK(NormPending(stage)); }
    CHECK(f.parameters->reset_reads == 1 && native_calls == 1);
    CHECK(history_reset_epoch == 77);
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
    guides_present[0] = guides_present[1] = true; CHECK(f.hook() == 1);
    CHECK(f.parameters->reset_reads == 2);
    for (const auto& stage : f.game->stages) {
      CheckPending(stage, false); CHECK(!NormPending(stage));
      for (const auto& slot : stage.slots) CHECK(slot.model_reset && slot.parameters->ints.at("DLSSNR.Reset") == 1);
    }
  });
  add("reset-survives-native-sr-failure-stage-isolation", [] {
    Fixture f; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; native_result = -1;
    CHECK(f.hook() == -1 && stage_calls[0] == 1 && stage_calls[1] == 0);
    CheckPending(f.stage(), false); CHECK(!NormPending(f.stage()));
    CheckPending(f.stage(1), true); CHECK(NormPending(f.stage(1)));
    CHECK(last_decline == NrDeclineReason::kGameEvaluateFailed && f.parameters->reset_reads == 1);
    native_result = 1; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
    CHECK(f.hook() == 1);
    for (const auto& slot : f.stage().slots) CHECK(!slot.model_reset);
    for (const auto& slot : f.stage(1).slots) CHECK(slot.model_reset);
    CHECK(!NormPending(f.stage(1)) && history_reset_epoch == 77);
  });
  for (int bypass : {0, 1, 2}) {
    add("reset-before-bypass-" + std::to_string(bypass), [bypass] {
      Fixture f; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1;
      if (bypass == 0) enabled = false;
      if (bypass == 1) yields_foreign = true;
      if (bypass == 2) { foreign_dx11_tool_seen = true; d3d12_nr_success_ns = fake_now_ns; }
      CHECK(f.hook() == 1 && native_calls == 1 && stage_calls[0] == 0 && stage_calls[1] == 0);
      CheckPending(f.stage(), true); CheckPending(f.stage(1), true);
      CHECK(f.parameters->reset_reads == 1);
      CHECK(NormPending(f.stage()) && NormPending(f.stage(1)));
      CHECK(EventIndex("read-reset") < EventIndex("native-sr"));
      f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0; f.hook();
      CheckPending(f.stage(), true); CHECK(NormPending(f.stage(1)));
    });
  }
  add("reset-registered-rr-only", [] {
    Fixture f(kFeatureDlssd); f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1;
    guides_present[1] = false; CHECK(f.hook() == 1);
    CheckPending(f.stage(), true); CheckPending(f.stage(1), true);
    CHECK(f.parameters->reset_reads == 1 && stage_calls[0] == 0);
  });
  add("reset-no-cross-feature-or-global-epoch", [] {
    Fixture f; const NVSDK_NGX_Handle* other_key = nullptr;
    Feature& other = AddFeature(&other_key); (void)other_key;
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; enabled = false; f.hook();
    CheckPending(f.stage(), true);
    for (const auto& stage : other.stages) { CheckPending(stage, false); CHECK(!NormPending(stage)); }
    CHECK(history_reset_epoch == 77);
  });
  add("reset-does-not-read-unregistered-or-non-sr-parameters", [] {
    Fixture f(18); f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1;
    CHECK(f.hook() == 1 && f.parameters->reset_reads == 0);
    CheckPending(f.stage(), false);
    const NVSDK_NGX_Handle* unknown = NewHandle();
    CHECK(HookedEvaluate<0>(&list_a, unknown, f.parameters, nullptr) == 1);
    CHECK(f.parameters->reset_reads == 0);
  });
  add("reset-null-arguments-do-not-read", [] {
    Fixture f;
    HookedEvaluate<0>(nullptr, f.key, f.parameters, nullptr);
    HookedEvaluate<0>(&list_a, nullptr, f.parameters, nullptr);
    HookedEvaluate<0>(&list_a, f.key, nullptr, nullptr);
    CHECK(f.parameters->reset_reads == 0 && native_calls == 3);
  });
  add("reset-direct-nested-disabled-callback-do-not-latch", [] {
    Fixture f; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1;
    direct_call = true; f.hook(); direct_call = false;
    call_depth = 1; f.hook(); call_depth = 0;
    callback_active = false; f.hook();
    CHECK(f.parameters->reset_reads == 0 && native_calls == 3);
    CheckPending(f.stage(), false);
  });
  add("reset-exact-one-zero-absent-do-not-clear-latch", [] {
    Fixture f; enabled = false;
    f.parameters->ints.erase(NVSDK_NGX_Parameter_Reset); f.hook(); CheckPending(f.stage(), false);
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 2; f.hook(); CheckPending(f.stage(), false);
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; f.hook(); CheckPending(f.stage(), true);
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0; f.hook(); CheckPending(f.stage(), true);
    CHECK(NormPending(f.stage()));
  });
  add("reset-zero-stage-maturing-slots-restart", [] {
    Fixture f; stages::counts[0] = 0; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1;
    f.hook(); CHECK(f.stage().slots[0].handle == nullptr && NormPending(f.stage()));
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
    uint32_t ready = 0;
    CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kSlotWarmupMaturation);
    CHECK(f.stage().slots[0].pending_reset && NormPending(f.stage()));
    const auto plan = RecordNorm(f.stage(), f.parameters);
    CHECK((plan.snap_reasons & norm_trace::kSnapReset) != 0 && !NormPending(f.stage()));
  });
  for (uint32_t mode : {1u, 2u, 3u}) {
    add("normalization-latch-policy-mode-" + std::to_string(mode), [mode] {
      Fixture f; enabled = false; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; f.hook();
      norm_governor = mode == 3 ? 2u : mode; norm_cut_aware = mode == 3;
      f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
      const auto plan = RecordNorm(f.stage(), f.parameters);
      CHECK(((plan.snap_reasons & norm_trace::kSnapReset) != 0) == (mode != 2));
      CHECK(!NormPending(f.stage()) && NormPending(f.stage(1)));
      CheckPending(f.stage(), true); CHECK(history_reset_epoch == 77);
      const auto next = RecordNorm(f.stage(), f.parameters);
      CHECK((next.snap_reasons & norm_trace::kSnapReset) == 0);
    });
  }
  add("normalization-cut-aware-reset-burst-preserved", [] {
    Fixture f; enabled = false; norm_governor = 2; norm_cut_aware = true;
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; f.hook();
    CHECK((RecordNorm(f.stage(), f.parameters).snap_reasons & norm_trace::kSnapReset) != 0);
    fake_now_ns += 16'000'000; f.hook();
    CHECK((RecordNorm(f.stage(), f.parameters).snap_reasons & norm_trace::kSnapReset) == 0);
    fake_now_ns += defaults::kNormResetQuietNs; f.hook();
    CHECK((RecordNorm(f.stage(), f.parameters).snap_reasons & norm_trace::kSnapReset) != 0);
  });
  add("failure-upscaled-does-not-touch-render", [] {
    Fixture f; const auto render = f.stage();
    inject_evaluate = 1;
    CHECK(EvaluatePass(f.stage(1), 1, f.parameters) == NrDeclineReason::kFailureBackoff);
    CHECK(f.stage(1).slots[1].failed && f.stage(1).slots[2].pending_reset);
    for (uint32_t pass = 0; pass < kMaxNrPasses; ++pass) {
      CHECK(f.stage().slots[pass].handle == render.slots[pass].handle);
      CHECK(!f.stage().slots[pass].pending_reset);
      CheckHistory(f.stage().look_history[pass], render.look_history[pass]);
    }
  });
  add("recovered-middle-pass-keeps-prefix-resets-suffix-once", [] {
    Fixture f; inject_evaluate = 1;
    CHECK(EvaluatePass(f.stage(), 1, f.parameters) == NrDeclineReason::kFailureBackoff);
    uint32_t ready = 0;
    CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kCount && ready == 1);
    CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kCount && ready == 4);
    inject_evaluate = 0;
    for (uint32_t pass = 0; pass < kMaxNrPasses; ++pass) {
      CHECK(EvaluatePass(f.stage(), pass, f.parameters) == NrDeclineReason::kCount);
      CHECK(f.stage().slots[pass].model_reset == (pass >= 1));
    }
    for (uint32_t pass = 0; pass < kMaxNrPasses; ++pass) {
      CHECK(EvaluatePass(f.stage(), pass, f.parameters) == NrDeclineReason::kCount);
      CHECK(!f.stage().slots[pass].model_reset);
    }
  });
  add("consumed-reset-evaluate-failure-recreated-slot-resets", [] {
    Fixture f; enabled = false; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; f.hook();
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0; inject_evaluate = 1;
    CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kFailureBackoff);
    uint32_t ready = 0;
    CHECK(SelectSlots(f.stage(), 4, &ready) == NrDeclineReason::kSlotWarmupMaturation);
    CHECK(f.stage().slots[0].pending_reset);
    inject_evaluate = 0; CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kCount);
    CHECK(f.stage().slots[0].model_reset && NormPending(f.stage()));
    CheckPending(f.stage(1), true);
  });
  add("look-history-restarts-after-latched-reset-only", [] {
    Fixture f; const auto before = f.stage().look_history[0];
    enabled = false; f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 1; f.hook();
    CheckHistory(f.stage().look_history[0], before);
    f.parameters->ints[NVSDK_NGX_Parameter_Reset] = 0;
    CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kCount);
    look::Frame frame;
    PlanLookHistory(f.stage().look_history[0], f.stage().slots[0].model_reset, true, fake_now_ns, &frame);
    CHECK(!frame.history_valid);
    CHECK(EvaluatePass(f.stage(), 0, f.parameters) == NrDeclineReason::kCount);
    PlanLookHistory(before, f.stage().slots[0].model_reset, true, fake_now_ns, &frame);
    CHECK(frame.history_valid);
  });
  uint32_t passed = 0, failed = 0;
  for (const auto& [name, test] : tests) {
    if (!filter.empty() && name != filter) continue;
    try { test(); ++passed; std::cout << "PASS " << name << '\n'; }
    catch (const std::exception& e) { ++failed; std::cout << "FAIL " << name << ": " << e.what() << '\n'; }
  }
  std::cout << "CPU TESTS: " << passed << " passed, " << failed << " failed; source="
            << (OLD_SOURCE ? "original" : "current") << '\n';
  if (passed + failed == 0) return 2;
  return failed == 0 ? 0 : 1;
}
