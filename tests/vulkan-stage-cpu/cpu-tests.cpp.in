inline std::mutex runtime_mutex;
struct RuntimeLock {
  std::unique_lock<std::mutex> lock;
  explicit RuntimeLock(std::mutex& mutex) : lock(mutex, std::defer_lock) {
    CHECK(ngx_serial::depth != 0 && runtime_depth == 0);
    lock.lock();
    ++runtime_depth;
  }
  ~RuntimeLock() { --runtime_depth; }
};
