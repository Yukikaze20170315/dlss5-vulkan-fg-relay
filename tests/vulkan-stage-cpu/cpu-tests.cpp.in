  kNrDisabledEvaluation, kMalformedEvaluate, kForeignNr, kSourceOther,
  kNgxNotDlssEvaluation, kZeroStrengthPassthrough, kNgxMissingGuides,
  kNgxOutputGeometry, kPreSrGeometry
};
@LIFETIME_FUNCTIONS@
inline reshade::api::device fake_device;
inline reshade::api::command_list list_a{1}, list_b{2};

// The production contract-change, retry-expiry, create_slot lambda and
// maturation statements are inserted unchanged. Only device/SDK I/O is fake.
inline NrDeclineReason SelectSlots(StageFeature& feature, uint32_t stack, uint32_t* ready) {
  const ngx_serial::Call ngx_turn;
  RuntimeLock lock(runtime_mutex);
  const uint32_t width = 320, height = 180, hdr_mode = 1;
  const VkDevice device = &fake_device;
  const VkCommandBuffer command_buffer = &list_a;
  auto* cmd = &list_a;
  struct { bool active = false; } restore;
  (void)restore;
@SLOT_SELECTION@
  *ready = passes;
  return NrDeclineReason::kCount;
}

// Actual SetModelParameters, use-ID tracking, runtime try/catch, failure
// branch and success bookkeeping from ProcessNr; transition is recorded only.
inline NrDeclineReason EvaluatePass(StageFeature& feature, uint32_t pass,
                                   const NVSDK_NGX_Parameter* parameters) {
  using namespace reshade::api;
  const ngx_serial::Call ngx_turn;
  RuntimeLock lock(runtime_mutex);
  auto* cmd = &list_a;
  const VkCommandBuffer command_buffer = &list_a;
  auto& slot = feature.slots[pass];
  auto* const nr = slot.parameters;
  (void)parameters;
@MODEL_FRAME_RESET@
  const uint64_t chain_reset_epoch = history_reset_epoch.load();
  uint32_t model_passes = 0;
  const auto transition = [](Surface, reshade::api::resource_usage) { events.push_back("transition"); };
@EVALUATE_BRANCH@
  CHECK(model_passes == 1);
  return NrDeclineReason::kCount;
}
