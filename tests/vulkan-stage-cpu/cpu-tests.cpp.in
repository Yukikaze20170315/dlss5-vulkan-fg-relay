// Normalization shaders are NOT run. The frame reset expression, CPU plan
// call and latch-consumption statement come from production; dispatch order
// relative to consumption is checked statically by the extraction runner.
inline FrameScalePlan RecordNorm(StageFeature& feature, const NVSDK_NGX_Parameter* parameters) {
  const ngx_serial::Call ngx_turn;
  RuntimeLock lock(runtime_mutex);
  (void)parameters;
  EvaluationContract frame;
@NORM_FRAME_RESET@
  frame.feed = feature.ngx.norm.feed;
  auto workset = feature.worksets.begin();
@NORM_PLAN_CALL@
  events.push_back("normalization-recorded");
@NORM_CONSUMPTION@
  return plan;
}

